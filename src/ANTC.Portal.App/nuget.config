<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Feed noi bo: nupkg core Umbraco build tu src/ANTC.Portal.Core (xem core_build) -->
    <add key="antcPortalLib" value="../ANTC.Portal.Lib/Build.Core" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Moi goi Umbraco.Cms* BAT BUOC lay tu feed noi bo, khong bao gio tu nuget.org -->
    <packageSource key="antcPortalLib">
      <package pattern="Umbraco.Cms*" />
    </packageSource>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>