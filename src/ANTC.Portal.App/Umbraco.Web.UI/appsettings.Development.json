{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "uSync": {
    "Settings": {
      "ImportAtStartup": "All",
      "ExportOnSave": "All"
    }
  },
  "Contest": {
    "IpHashSalt": "antc-local-development-only-ip-hash-salt"
  },
  "Umbraco": {
    "CMS": {
      "Hosting": {
        "Debug": true
      }
    }
  }
}
