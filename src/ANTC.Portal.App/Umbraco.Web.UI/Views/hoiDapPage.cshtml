@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Strings
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Plugin.Custom.Core.PortalV2
@inject Umbraco.Cms.Web.Common.UmbracoHelper UmbracoHelper
@inject Umbraco.Cms.Core.Services.Navigation.IDocumentNavigationQueryService Navigation
@inject Umbraco.Plugin.Custom.Core.Articles.ArticleHtmlSanitizer Sanitizer
@{
    // Trang Hoi - Dap (ban chinh thuc 10/11/2026, vHoidap + vSent). Noi dung nhap o cac o rieng cua trang,
    // khong dung Block Grid nua; o nao trong thi dung cau cua ban chinh thuc.
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    string T(string alias, string fallback) => Model.Value<string>(alias) is { Length: > 0 } value ? value.Trim() : fallback;

    var title = T("title", "Hỏi – Đáp");
    var lead = T("lead", "Câu hỏi thường gặp, trả lời ngắn. Không thấy câu của bạn thì gửi câu hỏi riêng ở cuối trang.");
    var urgentTitle = T("urgentTitle", "Đang gặp chuyện gấp?");
    var urgentText = T("urgentText", "Đừng chờ trả lời, xem việc cần làm ngay.");
    var urgentButton = T("urgentButton", "Xem việc cần làm ngay");
    // Lien ket cua nut: o "Dai khan cap · lien ket" (MultiUrlPicker toi da 1); trong thi mo trang Khan cap.
    var urgentLink = Model.Value<Umbraco.Cms.Core.Models.Link>("urgentLink");
    var urgentUrl = urgentLink?.Url is { Length: > 0 } linkUrl ? linkUrl : "/khan-cap/";
    var urgentTarget = urgentLink?.Target is { Length: > 0 } target ? target : null;
    var quickTitle = T("quickTitle", "Hỏi – đáp nhanh");
    var quickNote = Model.Value<string>("quickNote");
    var askTitle = T("askTitle", "Gửi câu hỏi, kiến nghị riêng");
    var steps = new[]
    {
        (T("step1Title", "Bạn gửi kín"), T("step1Text", "Câu hỏi, kiến nghị không hiện lên trang."),
            "<rect x=\"4.5\" y=\"10.5\" width=\"15\" height=\"10\" rx=\"2\"/><path d=\"M8 10.5V7.5a4 4 0 0 1 8 0v3\"/>"),
        (T("step2Title", "Ban biên tập gộp"), T("step2Text", "Các câu giống nhau được gộp làm một."),
            "<circle cx=\"9\" cy=\"8\" r=\"3.2\"/><path d=\"M3 19.5c.6-3.3 3-5 6-5s5.4 1.7 6 5\"/><path d=\"M15.5 4.9a3.2 3.2 0 0 1 0 6.2M17.5 14.7c2 .6 3.2 2.3 3.5 4.8\"/>"),
        (T("step3Title", "Trả lời công khai"), T("step3Text", "Người biên tập duyệt từng câu trước khi đăng, đã che mọi thông tin cá nhân."),
            "<path d=\"M3.5 10v4a1 1 0 0 0 1 1H7l7 4.5V4.5L7 9H4.5a1 1 0 0 0-1 1z\"/><path d=\"M17.5 9a4 4 0 0 1 0 6\"/>")
    };
    var warnTitle = T("warnTitle", "Trước khi gõ");
    var warnLines = (Model.Value<IEnumerable<string>>("warnLines") ?? []).Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
    if (warnLines.Length == 0)
    {
        warnLines = ["Đừng viết mật khẩu, mã OTP, mã PIN, số thẻ hay số tài khoản.", "Đừng gửi họ tên, số điện thoại, ảnh giấy tờ của người khác.",
            "Website không nhận tệp đính kèm và ảnh chụp màn hình."];
    }
    var contentLabel = T("contentLabel", "Câu hỏi hoặc kiến nghị của bạn");
    var placeholder = T("placeholder", "Ví dụ: Tôi được mời làm cộng tác viên, họ bảo nạp 300 nghìn để mở tài khoản. Có nên nạp không?");
    var replyLabel = T("replyLabel", "Tôi muốn nhận trả lời riêng");
    var replyNote = T("replyNote", "(không bắt buộc)");
    var contactLabel = T("contactLabel", "Thư điện tử hoặc số điện thoại để trả lời");
    var contactHint = T("contactHint", "Chỉ dùng để trả lời đúng câu hỏi này, xóa ngay sau khi đã gửi câu trả lời. Chúng tôi không chủ động liên hệ vì việc khác.");
    // Chu "Bat buoc." / "Khong bat buoc." do trang tu them; bo neu bien tap vien da go.
    static string Strip(string text, string prefix) => text.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? text[prefix.Length..].TrimStart() : text;
    var consentLabel = Strip(T("consentLabel", "Tôi đồng ý cho Ban biên tập đọc và xử lý câu hỏi này để trả lời."), "Bắt buộc.");
    var publishLabel = Strip(T("publishLabel", "Tôi đồng ý cho Ban biên tập che mọi thông tin nhận dạng, biên tập rồi đăng công khai câu hỏi cùng câu trả lời. Không đồng ý vẫn được trả lời riêng."), "Không bắt buộc.");
    var buttonLabel = T("buttonLabel", "Gửi");
    var legal = T("legal", "Website này không phải là nơi tiếp nhận tố giác, tin báo về tội phạm. Nếu bạn cần trình báo, hãy liên hệ trực tiếp cơ quan Công an nơi bạn cư trú.");
    var successTitle = T("successTitle", "Đã nhận câu hỏi, kiến nghị của bạn");
    var successLead = T("successLead", "Nội dung bạn gửi không hiện lên trang. Ban biên tập cố gắng trả lời trong 72 giờ làm việc, có lúc lâu hơn.");

    // Cac cau hoi dap nhanh lay tu Quan ly noi dung > Hoi - dap nhanh (quickQaItem), qua Navigation (WEB-07).
    var qaFolder = UmbracoHelper.Content(PortalV2Keys.Node("f-qa")) is { ContentType.Alias: "quickQaFolderV2" or "quickQaFolder" } directFolder
        ? directFolder
        : null;
    if (qaFolder is null && Navigation.TryGetRootKeysOfType("antc", out var rootKeys))
    {
        foreach (var rootKey in rootKeys)
        {
            if (!Navigation.TryGetChildrenKeysOfType(rootKey, "contentManagement", out var libraryKeys)) continue;
            foreach (var libraryKey in libraryKeys)
            {
                if (Navigation.TryGetChildrenKeysOfType(libraryKey, "quickQaFolderV2", out var v2Keys))
                    qaFolder ??= v2Keys.Select(UmbracoHelper.Content).FirstOrDefault(x => x is not null);
                if (qaFolder is null && Navigation.TryGetChildrenKeysOfType(libraryKey, "quickQaFolder", out var v1Keys))
                    qaFolder ??= v1Keys.Select(UmbracoHelper.Content).FirstOrDefault(x => x is not null);
                if (qaFolder is not null) break;
            }
            if (qaFolder is not null) break;
        }
    }
    var qaItems = qaFolder is not null && Navigation.TryGetChildrenKeysOfType(qaFolder.Key, "quickQaItem", out var itemKeys)
        ? itemKeys.Select(UmbracoHelper.Content).OfType<IPublishedContent>().Where(x => x.IsVisible()).OrderBy(x => x.SortOrder).ToList()
        : [];
}
@section Head {
    <link rel="stylesheet" href="~/assets/css/contest-shell.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/qa-portal.css" asp-append-version="true">
}

<div class="qa-portal" id="qa-portal">
    <nav class="crumbs" aria-label="Bạn đang ở">
        <ol>
            <li><a href="/">Trang chủ</a></li>
            <li><span aria-current="page">@title</span></li>
        </ol>
    </nav>

    <header class="pageh">
        <div class="pageh-title">
            <span class="spot" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <h1 tabindex="-1">@title</h1>
        </div>
        <p class="lead">@lead</p>
    </header>

    <div class="quick">
        <div class="quick-main">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5 2.8 19.5h18.4z"/><path d="M12 10v4.2"/><circle cx="12" cy="16.8" r=".7" fill="currentColor"/></svg>
            <span><b>@urgentTitle</b> @urgentText</span>
        </div>
        <a href="@urgentUrl" class="btn red sm" target="@urgentTarget" rel="@(urgentTarget == "_blank" ? "noopener" : null)">@urgentButton</a>
    </div>

    <section class="sec" aria-labelledby="h-qa">
        <h2 id="h-qa">@quickTitle</h2>
        <div class="qalist">
            @for (int i = 0; i < qaItems.Count; i++)
            {
                var item = qaItems[i];
                var panelId = $"qa-{i + 1}";
                var question = item.Value<string>("question") is { Length: > 0 } q ? q : item.Name;
                var shortAnswer = item.Value<string>("shortAnswer");
                var reason = item.Value<IHtmlEncodedString>("reason")?.ToHtmlString();
                var actions = item.Value<IHtmlEncodedString>("actions")?.ToHtmlString();
                // Chi hien trang co giao dien (co template); bo thu muc va muc khong co trang rieng.
                var relatedPages = item.Value<IEnumerable<IPublishedContent>>("relatedPages")?.Where(x => x.TemplateId is > 0).ToList();
                <div class="qai">
                    <button type="button" class="qaq" data-open="@panelId" aria-expanded="false" aria-controls="@panelId">
                        <svg class="ic-q" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.3a2.6 2.6 0 0 1 5 .9c0 1.8-2.5 2.2-2.5 4"/><circle cx="12" cy="17.2" r=".8" fill="currentColor"/></svg>
                        <span>@question</span>
                        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
                    </button>
                    <div class="qab" id="@panelId" hidden>
                        @if (!string.IsNullOrWhiteSpace(shortAnswer)) { <p class="qshort">@shortAnswer</p> }
                        @if (!string.IsNullOrWhiteSpace(reason)) { <p class="qlab">Vì sao</p><div class="qbody">@Html.Raw(Sanitizer.Clean(reason))</div> }
                        @if (!string.IsNullOrWhiteSpace(actions)) { <p class="qlab">Việc cần làm</p><div class="qbody">@Html.Raw(Sanitizer.Clean(actions))</div> }
                        @if (relatedPages?.Any() == true)
                        {
                            <ul class="llist" aria-label="Nội dung liên quan">
                                @foreach (var rel in relatedPages)
                                {
                                    <li>
                                        <a href="@rel.Url()">
                                            <svg class="ic-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6.5C10.3 5 7.6 4.5 3.5 4.5v14c4.1 0 6.8.5 8.5 2 1.7-1.5 4.4-2 8.5-2v-14c-4.1 0-6.8.5-8.5 2z"/><path d="M12 6.5v14"/></svg>
                                            <span>@rel.Name</span>
                                            <svg class="ic-next" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(quickNote)) { <p class="small qa-note">@quickNote</p> }
    </section>

    <section class="sec" id="gui-cau-hoi" aria-labelledby="h-ask">
        <h2 id="h-ask">@askTitle</h2>
        <ol class="flow" aria-label="Cách mục Hỏi – Đáp làm việc">
            @foreach (var (stepTitle, stepText, icon) in steps)
            {
                <li>
                    <span class="spot" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(icon)</svg></span>
                    <span><b>@stepTitle</b> @stepText</span>
                </li>
            }
        </ol>

        <form class="box form" data-form="ask" novalidate>
            <div class="hp" aria-hidden="true">
                <label>Để trống ô này<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <div class="warn">
                <b>@warnTitle</b>
                <ul>@foreach (var line in warnLines) { <li>@line</li> }</ul>
            </div>
            <div>
                <label class="lbl" for="qtext">@contentLabel</label>
                <textarea id="qtext" name="content" placeholder="@placeholder"></textarea>
            </div>
            <label class="check" for="qreply">
                <input type="checkbox" id="qreply" name="wantReply">
                <span>@replyLabel <span class="small">@replyNote</span></span>
            </label>
            <div id="qcontactwrap" hidden>
                <label class="lbl" for="qcontact">@contactLabel</label>
                <input type="text" id="qcontact" name="contact" autocomplete="off">
                <p class="small qa-hint">@contactHint</p>
            </div>
            <label class="check one" for="qok">
                <input type="checkbox" id="qok" name="consent">
                <span><b>Bắt buộc.</b> @consentLabel</span>
            </label>
            <label class="check" for="qpub">
                <input type="checkbox" id="qpub" name="publish">
                <span><b>Không bắt buộc.</b> @publishLabel</span>
            </label>
            <p class="err" id="qerr" hidden></p>
            <div class="btnrow">
                <button type="submit" class="btn pri">
                    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5h-9l-4.5 3.5v-3.5H5A1.5 1.5 0 0 1 3.5 15V6A1.5 1.5 0 0 1 5 4.5z"/></svg>
                    @buttonLabel
                </button>
            </div>
            <p class="small">@legal</p>
        </form>
    </section>

    @* Trang thai da nhan cau hoi (vSent) *@
    <section class="sec qa-sent" id="qa-sent" hidden aria-labelledby="h-sent">
        <header class="pageh">
            <p class="eyebrow">Hỏi – Đáp</p>
            <div class="pageh-title">
                <span class="spot g" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
                <h2 id="h-sent" tabindex="-1">@successTitle</h2>
            </div>
            <p class="lead">@successLead</p>
        </header>
        <div class="note r">
            <b>Đang có chuyện gấp? Đừng chờ câu trả lời.</b>
            <p>Nếu bạn đang bị giục chuyển tiền, vừa chuyển tiền, hoặc đang bị đe dọa, hãy làm ngay:</p>
            <div class="btnrow">
                <a href="/hay-tu-kiem-tra/huong-dan/co-nguoi-dang-de-doa-ep-buoc-ban/" class="btn red sm">Tôi đang bị đe dọa</a>
                <a href="/hay-tu-kiem-tra/huong-dan/ban-vua-chuyen-tien-hoac-giao-hang/" class="btn red sm">Tôi vừa chuyển tiền hoặc giao hàng</a>
                <a href="/hay-tu-kiem-tra/huong-dan/co-nguoi-dang-thuc-ban-lam-ngay/" class="btn red sm">Có người đang thúc tôi làm ngay</a>
            </div>
            <a href="/khan-cap/" class="more">
                Xem tất cả lựa chọn
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
            </a>
        </div>
        <div class="note g">
            <b>Muốn trình báo?</b>
            <p>@legal Mang theo tin nhắn, biên lai và mọi bằng chứng đang có.</p>
        </div>
        <div class="btnrow">
            <button type="button" class="btn ghost" id="btn-back-qa">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
                Về Hỏi – Đáp
            </button>
        </div>
    </section>
</div>

@section Scripts {
    <script type="module" src="~/assets/js/qa-portal.js" asp-append-version="true"></script>
}
