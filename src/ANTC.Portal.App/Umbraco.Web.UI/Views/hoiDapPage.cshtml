@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Strings
@using Umbraco.Cms.Core.Models.PublishedContent
@inject Umbraco.Cms.Web.Common.UmbracoHelper UmbracoHelper
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    var blocks = Model.Value<BlockGridModel>("layout");
}
@section Head {
    <link rel="stylesheet" href="~/assets/css/contest-shell.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/qa-portal.css" asp-append-version="true">
}

<div class="qa-portal" id="qa-portal">
    @if (blocks?.Any() == true)
    {
        @await Html.GetBlockGridHtmlAsync(blocks)
    }
    else
    {
        @* Fallback khi trang chưa có cấu hình BlockGrid *@
        var allRoots = UmbracoHelper.ContentAtRoot();
        var qaFolder = allRoots.SelectMany(r => r.DescendantsOrSelf())
            .FirstOrDefault(x => x.ContentType.Alias is "quickQaFolderV2" or "quickQaFolder");

        var cmsItems = qaFolder != null
            ? qaFolder.Children().Where(x => x.IsVisible() && x.ContentType.Alias == "quickQaItem").OrderBy(x => x.SortOrder).ToList()
            : allRoots.SelectMany(r => r.DescendantsOrSelfOfType("quickQaItem")).Where(x => x.IsVisible()).OrderBy(x => x.SortOrder).ToList();

        var hasCmsItems = cmsItems.Count > 0;

        @* Đường dẫn (Breadcrumb) *@
        <nav class="crumbs" aria-label="Bạn đang ở">
            <ol>
                <li><a href="/">Trang chủ</a></li>
                <li><span aria-current="page">Hỏi – Đáp</span></li>
            </ol>
        </nav>

        @* Tiêu đề trang *@
        <header class="pageh">
            <div class="pageh-title">
                <span class="spot" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                </span>
                <h1 tabindex="-1">Hỏi – Đáp</h1>
            </div>
            <p class="lead">Câu hỏi thường gặp, trả lời ngắn. Không thấy câu của bạn thì gửi câu hỏi riêng ở cuối trang.</p>
        </header>

        @* Ảnh minh họa Hero *@
        <div class="pageh-hero-wrap">
            <img src="/assets/img/qa-hero.jpg" alt="Hỏi – Đáp" class="pageh-hero-img" />
        </div>

        @* Dải khẩn cấp *@
        <div class="quick">
            <div class="quick-main">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3.5 2.8 19.5h18.4z"/><path d="M12 10v4.2"/><circle cx="12" cy="16.8" r=".7" fill="currentColor"/>
                </svg>
                <span><b>Đang gặp chuyện gấp?</b> Đừng chờ trả lời, xem việc cần làm ngay.</span>
            </div>
            <a href="/khan-cap" class="btn red sm">Xem việc cần làm ngay</a>
        </div>

        @* Section 1: Hỏi – đáp nhanh *@
        <section class="sec" aria-labelledby="h-qa">
            <h2 id="h-qa">Hỏi – đáp nhanh</h2>
            <div class="qalist">
                @if (hasCmsItems)
                {
                    @for (int i = 0; i < cmsItems.Count; i++)
                    {
                        var item = cmsItems[i];
                        var n = i + 1;
                        var panelId = $"qa-{n}";
                        var question = item.Value<string>("question") is { Length: > 0 } q ? q : item.Name;
                        var shortAnswer = item.Value<string>("shortAnswer");
                        var reason = item.Value<IHtmlEncodedString>("reason");
                        var actions = item.Value<IHtmlEncodedString>("actions");
                        // Chi hien trang co giao dien (co template); bo thu muc va muc khong co trang rieng.
                        var relatedPages = item.Value<IEnumerable<IPublishedContent>>("relatedPages")?.Where(x => x.TemplateId is > 0).ToList();
                        var approvedBy = item.Value<string>("approvedBy");

                        <div class="qai">
                            <button type="button" class="qaq" data-open="@panelId" aria-expanded="false" aria-controls="@panelId">
                                <svg class="ic-q" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="9"/><path d="M9.5 9.3a2.6 2.6 0 0 1 5 .9c0 1.8-2.5 2.2-2.5 4"/><circle cx="12" cy="17.2" r=".8" fill="currentColor"/>
                                </svg>
                                <span>@question</span>
                                <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m9 5 7 7-7 7"/>
                                </svg>
                            </button>
                            <div class="qab" id="@panelId" hidden>
                                @if (!string.IsNullOrWhiteSpace(shortAnswer))
                                {
                                    <p class="qshort">@shortAnswer</p>
                                }
                                @if (reason is not null && !string.IsNullOrWhiteSpace(reason.ToHtmlString()))
                                {
                                    <p class="qlab">Vì sao</p>
                                    <div class="qbody">@reason</div>
                                }
                                @if (actions is not null && !string.IsNullOrWhiteSpace(actions.ToHtmlString()))
                                {
                                    <p class="qlab">Việc cần làm</p>
                                    <div class="qbody">@actions</div>
                                }
                                @if (relatedPages?.Any() == true)
                                {
                                    <ul class="llist" aria-label="Nội dung liên quan">
                                        @foreach (var rel in relatedPages)
                                        {
                                            <li>
                                                <a href="@rel.Url()">
                                                    <svg class="ic-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <path d="M12 6.5C10.3 5 7.6 4.5 3.5 4.5v14c4.1 0 6.8.5 8.5 2 1.7-1.5 4.4-2 8.5-2v-14c-4.1 0-6.8.5-8.5 2z"/><path d="M12 6.5v14"/>
                                                    </svg>
                                                    <span>@rel.Name</span>
                                                    <svg class="ic-next" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <path d="m9 5 7 7-7 7"/>
                                                    </svg>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (!string.IsNullOrWhiteSpace(approvedBy))
                                {
                                    <p class="qmeta">Duyệt bởi: @approvedBy</p>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
            <p class="small" style="margin-top: 14px;">Bản dựng thử: đây là ví dụ cách trình bày. Khi vận hành, mỗi câu trả lời đều do Ban biên tập duyệt và dẫn về một nội dung đã thẩm định.</p>
        </section>

        @* Section 2: Gửi câu hỏi, kiến nghị riêng *@
        <section class="sec" id="gui-cau-hoi" aria-labelledby="h-ask">
            <h2 id="h-ask">Gửi câu hỏi, kiến nghị riêng</h2>
            <ol class="flow" aria-label="Cách mục Hỏi – Đáp làm việc">
                <li>
                    <span class="spot" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
                        </svg>
                    </span>
                    <span>
                        <b>Bạn gửi kín</b>
                        Câu hỏi, kiến nghị không hiện lên trang.
                    </span>
                </li>
                <li>
                    <span class="spot" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="8" r="3.2"/><path d="M3 19.5c.6-3.3 3-5 6-5s5.4 1.7 6 5"/><path d="M15.5 4.9a3.2 3.2 0 0 1 0 6.2M17.5 14.7c2 .6 3.2 2.3 3.5 4.8"/>
                        </svg>
                    </span>
                    <span>
                        <b>Ban biên tập gộp</b>
                        Các câu giống nhau được gộp làm một.
                    </span>
                </li>
                <li>
                    <span class="spot" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3.5 10v4a1 1 0 0 0 1 1H7l7 4.5V4.5L7 9H4.5a1 1 0 0 0-1 1z"/><path d="M17.5 9a4 4 0 0 1 0 6"/>
                        </svg>
                    </span>
                    <span>
                        <b>Trả lời công khai</b>
                        Người biên tập duyệt từng câu trước khi đăng, đã che mọi thông tin cá nhân.
                    </span>
                </li>
            </ol>

            <form class="box form" data-form="ask" novalidate>
                <div class="hp" aria-hidden="true" style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;">
                    <label>Để trống ô này<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
                </div>

                <div class="warn">
                    <b>Trước khi gõ</b>
                    <ul>
                        <li>Đừng viết mật khẩu, mã OTP, mã PIN, số thẻ hay số tài khoản.</li>
                        <li>Đừng gửi họ tên, số điện thoại, ảnh giấy tờ của người khác.</li>
                        <li>Giai đoạn đầu chưa nhận tệp đính kèm và ảnh chụp màn hình.</li>
                    </ul>
                </div>

                <div>
                    <label class="lbl" for="qtext">Câu hỏi hoặc kiến nghị của bạn</label>
                    <textarea id="qtext" name="content" placeholder="Ví dụ: Tôi được mời làm cộng tác viên, họ bảo nạp 300 nghìn để mở tài khoản. Có nên nạp không?"></textarea>
                </div>

                <label class="check" for="qreply">
                    <input type="checkbox" id="qreply" name="wantReply">
                    <span>Tôi muốn nhận trả lời riêng <span class="small">(không bắt buộc)</span></span>
                </label>

                <div id="qcontactwrap" hidden>
                    <label class="lbl" for="qcontact">Thư điện tử hoặc số điện thoại để trả lời</label>
                    <input type="text" id="qcontact" name="contact" autocomplete="off">
                    <p class="small" style="margin-top: 6px;">Chỉ dùng để trả lời đúng câu hỏi này, xóa ngay sau khi đã gửi câu trả lời. Chúng tôi không chủ động liên hệ vì việc khác.</p>
                </div>

                <label class="check one" for="qok">
                    <input type="checkbox" id="qok" name="consent">
                    <span><b>Bắt buộc.</b> Tôi đồng ý cho Ban biên tập đọc và xử lý câu hỏi này để trả lời.</span>
                </label>

                <label class="check" for="qpub">
                    <input type="checkbox" id="qpub" name="publish">
                    <span><b>Không bắt buộc.</b> Tôi đồng ý cho Ban biên tập che mọi thông tin nhận dạng, biên tập rồi đăng công khai câu hỏi cùng câu trả lời. Không đồng ý vẫn được trả lời riêng.</span>
                </label>

                <p class="err" id="qerr" hidden></p>

                <div class="btnrow">
                    <button type="submit" class="btn pri">
                        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5h-9l-4.5 3.5v-3.5H5A1.5 1.5 0 0 1 3.5 15V6A1.5 1.5 0 0 1 5 4.5z"/>
                        </svg>
                        Gửi
                    </button>
                </div>

                <p class="small">Website này không phải là nơi tiếp nhận tố giác, tin báo về tội phạm. Nếu bạn cần trình báo, hãy liên hệ trực tiếp cơ quan Công an nơi bạn cư trú.</p>
            </form>
        </section>

        @* Trạng thái đã nhận câu hỏi (vSent) *@
        <section class="sec" id="qa-sent" hidden aria-labelledby="h-sent">
            <header class="pageh">
                <p class="eyebrow">Hỏi – Đáp</p>
                <div class="pageh-title">
                    <span class="spot g" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 12.5 4.5 4.5L19 7.5"/>
                        </svg>
                    </span>
                    <h1 id="h-sent" tabindex="-1">Đã nhận câu hỏi, kiến nghị của bạn</h1>
                </div>
                <p class="lead">Nội dung bạn gửi không hiện lên trang. Ban biên tập cố gắng trả lời trong 72 giờ làm việc, có lúc lâu hơn.</p>
            </header>

            <div class="note r">
                <b>Đang có chuyện gấp? Đừng chờ câu trả lời.</b>
                <p>Nếu bạn đang bị giục chuyển tiền, vừa chuyển tiền, hoặc đang bị đe dọa, hãy làm ngay:</p>
                <div class="btnrow" style="margin-top: 6px;">
                    <a href="/khan-cap" class="btn red sm">Tôi đang bị đe dọa</a>
                    <a href="/khan-cap" class="btn red sm">Tôi vừa chuyển tiền hoặc giao hàng</a>
                    <a href="/khan-cap" class="btn red sm">Có người đang thúc tôi làm ngay</a>
                </div>
                <a href="/khan-cap" class="more">Xem tất cả lựa chọn &rarr;</a>
            </div>

            <div class="note g">
                <b>Muốn trình báo?</b>
                <p>Website này không phải là nơi tiếp nhận tố giác, tin báo về tội phạm. Nếu bạn cần trình báo, hãy liên hệ trực tiếp cơ quan Công an nơi bạn cư trú. Mang theo tin nhắn, biên lai và mọi bằng chứng đang có.</p>
            </div>

            <div class="btnrow" style="margin-top: 14px;">
                <button type="button" class="btn ghost" id="btn-back-qa">
                    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 5 8 12l7 7"/>
                    </svg>
                    Về Hỏi – Đáp
                </button>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script type="module" src="~/assets/js/qa-portal.js" asp-append-version="true"></script>
}
