@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Text.Json
@using Umbraco.Cms.Core.Models.PublishedContent
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    var title = Model.Value<string>("title") ?? Model.Name;
    var lead = Model.Value<string>("lead");
    var data = SelfCheckChecklistDataBuilder.Build(Model);
    var json = JsonSerializer.Serialize(data, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var source = Model.Value<IPublishedContent>("src");
    var image = Model.Value<IPublishedContent>("illustration");
    var pdfUrl = Model.Value<IPublishedContent>("pdf")?.Url();
    var validPdf = pdfUrl?.StartsWith('/') == true && !pdfUrl.StartsWith("//") && pdfUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
    var reviewed = Model.Value<DateTime?>("rev");
}
@section Head {
    <link rel="stylesheet" href="~/assets/css/self-check.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/self-check-tool.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/self-check-checklist.css" asp-append-version="true">
}
<article class="self-check-page self-check-tool self-check-checklist site-chrome-wrap" data-self-check-checklist>
    <nav class="self-check-crumbs" aria-label="Bạn đang ở"><ol><li><a href="/">Trang chủ</a></li><li><a href="/hay-tu-kiem-tra/">CÔNG CỤ KIỂM TRA</a></li><li aria-current="page">@title</li></ol></nav>
    <header class="self-check-heading"><p class="self-check-eyebrow">Kiểm tra</p><div class="self-check-heading__title"><span class="self-check-spot">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", Model.Value<string>("icon") ?? "icon-check")</span><h1>@title</h1></div><p>@await Html.PartialAsync("~/Views/Partials/_ContentSourceLinks.cshtml", (Model, lead))</p>@await Html.PartialAsync("~/Views/Partials/_SelfCheckUpdated.cshtml", Model)</header>
    @if (image is not null) { <figure class="self-check-illustration"><img src="@image.Url()" alt="@Model.Value("illustrationAlt")" loading="lazy" decoding="async"></figure> }
    @if (data.Ready)
    {
        <div class="self-check-controls self-check-document-tools">
            <button type="button" class="self-check-button" data-font-toggle aria-pressed="false">A+ Chữ lớn</button>
            <button type="button" class="self-check-button" data-checklist-print>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-print") In</button>
            <button type="button" class="self-check-button" data-checklist-share>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-share") Gửi</button>
            @if (validPdf) { <a class="self-check-button" href="@pdfUrl" download>Tải bản PDF</a> }
        </div>
        <p class="self-check-tool-status" data-checklist-tools-status role="status" hidden></p>
        <div data-checklist-form>
            <section class="self-check-checklist-part" aria-labelledby="self-check-part-one"><h2 id="self-check-part-one"><span>1</span> Có việc nào dưới đây không?</h2><p>@Model.Value("p1Intro")</p>
                @for (var i = 0; i < data.Questions.Length; i++)
                {
                    <fieldset class="self-check-checklist-question" data-checklist-question="@i"><legend>@data.Questions[i]</legend><div class="self-check-radio-options">
                    @foreach (var option in new[] { ("y", "Có"), ("n", "Không"), ("u", "Tôi chưa biết") })
                    {
                        <label><input type="radio" name="checklist-answer-@i" value="@option.Item1"><span>@option.Item2</span></label>
                    }
                    </div></fieldset>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Value<string>("p1Note"))) { <p class="self-check-checklist-note">@Model.Value("p1Note")</p> }
            </section>
            <section class="self-check-checklist-part" aria-labelledby="self-check-part-two"><h2 id="self-check-part-two"><span>2</span> Kiểm tra bỏ túi</h2><p>@Model.Value("p2Intro")</p>
                <div class="self-check-pocket">
                @for (var i = 0; i < data.Items.Length; i++)
                {
                    <label><input type="checkbox" data-checklist-item="@i"><span>@data.Items[i]</span></label>
                }
                <button type="button" class="self-check-button" data-checklist-clear>Xóa đánh dấu</button>
                </div>
            </section>
            <p class="self-check-checklist-error" role="alert" data-checklist-error hidden></p>
            <div class="self-check-controls"><button type="button" class="self-check-button self-check-button--primary" data-checklist-result>Xem kết quả</button><button type="button" class="self-check-button" data-checklist-reset>Làm lại từ đầu</button></div>
        </div>
        <div data-checklist-output></div>
        <div class="self-check-controls self-check-source-links"><a class="self-check-button self-check-source-link" href="@(source!.Url())">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-book") Đọc @source.Name</a>
        @if (Model.Value<IPublishedContent>("guidePage") is { } guide && EmergencyContent.PublicUrl(guide) is { } guideUrl) { <a class="self-check-button" href="@guideUrl">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-document") @(guide.Value<IPublishedContent>("topic")?.Value<string>("shortName") ?? guide.Value<string>("title") ?? guide.Name)</a> }</div>
        <script type="application/json" data-checklist-data>@Html.Raw(json)</script>
        <noscript><p class="self-check-empty">Bạn có thể đọc và in danh sách bằng chức năng In của trình duyệt. Bật JavaScript để xem kết quả tự kiểm tra; lựa chọn trên trang không được gửi đi.</p></noscript>
    }
    else
    {
        <p class="self-check-empty">Danh sách kiểm tra đang được cập nhật. Bạn có thể <a href="/hay-tu-kiem-tra/">quay lại Công cụ kiểm tra</a>.</p>
    }
    <footer class="self-check-checklist-meta">@if (reviewed is { Year: > 1900 } date) { <p>Ngày rà soát: @date.ToString("dd/MM/yyyy")</p> }<p>Website này không phải là nơi tiếp nhận tố giác, tin báo về tội phạm. Nếu bạn cần trình báo, hãy liên hệ trực tiếp cơ quan Công an nơi bạn cư trú.</p></footer>
</article>
@section Scripts { <script type="module" src="~/assets/js/self-check-checklist.js" asp-append-version="true"></script> }
