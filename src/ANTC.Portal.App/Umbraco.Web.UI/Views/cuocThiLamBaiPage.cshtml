@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@inject Umbraco.Plugin.Custom.Core.PortalV2.RuiRo.ReadingArticleDirectory ReadingArticles
@inject Umbraco.Plugin.Custom.Core.Quiz.IQuestionBank QuestionBank
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    var isBank = Context.Request.Path.Value?.TrimEnd('/') == "/ngan-hang";
    if (isBank)
    {
        var title = (Model.Value<string>("practiceTitle") ?? "Tự luyện {count} câu").Replace("{count}", QuestionBank.Current.GeneralQuestionCount.ToString());
        var seo = SelfCheckSeoBuilder.Build(Model, Context.Request);
        ViewData["SelfCheckSeo"] = seo with { Title = title, DocumentTitle = $"{title} — {seo.SiteName}",
            Description = Model.Value<string>("practiceLead") ?? "Ngân hàng câu hỏi tự luyện với giải thích cho từng lựa chọn. Không cần đăng ký dự thi.",
            CanonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/ngan-hang/", Type = "website" };
    }
}
@section Head {
    <link rel="stylesheet" href="~/assets/css/quiz-fonts.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/contest-shell.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/contest-quiz.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/contest.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/contest-flow-blocks.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/contest-activity.css" asp-append-version="true">
}
@* /ngan-hang/: an phan dang ky ve san cho toi khi exam.js ve xong man tu luyen, tranh nhay noi dung *@
<div class="contest-flow-page@(isBank ? " is-booting" : "")" data-reading-urls="@System.Text.Json.JsonSerializer.Serialize(ReadingArticles.All().ToDictionary(x => x.Number.ToString(), x => x.Url))">
    @if (Model.Value<BlockGridModel>("layout") is { } blocks)
    {
        @await Html.GetBlockGridHtmlAsync(blocks)
    }
</div>
@section Scripts {
    <script type="module" src="~/assets/js/contest/frame.js" asp-append-version="true"></script>
    <script type="module" src="~/assets/js/contest/exam.js" asp-append-version="true"></script>
}
