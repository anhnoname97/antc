@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}
@section Head {
    <link rel="stylesheet" href="~/assets/css/self-check.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/risk-alerts.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/home-v2.css" asp-append-version="true">
}
@await Html.PartialAsync("~/Views/Partials/_HomeEmergency.cshtml", Model)
@await Html.PartialAsync("~/Views/Partials/_HomeTools.cshtml", Model)
@await Html.PartialAsync("~/Views/Partials/_HomeRisks.cshtml", Model)
@await Html.PartialAsync("~/Views/Partials/_HomeLibrary.cshtml", Model)
@await Html.PartialAsync("~/Views/Partials/_HomeAlerts.cshtml", Model)
@if (Model.Value<DateTime?>("displayUpdatedDate") is { Year: > 1900 } updated)
{
    <div class="home-v2" data-home-updated>
        <div class="site-chrome-wrap home-v2__updated">
            <p class="self-check-updated">Cập nhật <time datetime="@updated.ToString("yyyy-MM-dd")">@updated.ToString("dd/MM/yyyy")</time></p>
        </div>
    </div>
}
