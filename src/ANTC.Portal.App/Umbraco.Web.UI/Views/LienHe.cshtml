@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Globalization
@using System.Text.Json
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    var site = Model.Root();
    var documents = site.DescendantsOrSelf().ToDictionary(document => document.Key);
    var emergency = documents.Values.FirstOrDefault(document => document.ContentType.Alias == "ungPhoPage");
    var image = Model.Value<IPublishedContent>("illustration");
    var bankSteps = site.Value<IEnumerable<string>>("bankLookupSteps") ?? [];
    string? Target(JsonElement row) => EmergencyContent.DocumentKey(EmergencyContent.Text(row, "targetPage")) is { } key
        ? EmergencyContent.PublicUrl(documents.GetValueOrDefault(key)) : null;
    var situations = EmergencyContent.Rows(Model, "situationLinks").Where(row => Target(row) is not null).ToArray();
    var sourceOrigin = new Uri($"{Context.Request.Scheme}://{Context.Request.Host}");
}
@functions {
    private static DateTime? Checked(string value) => DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
        && date.Year > 1900 && date.Date <= DateTime.UtcNow.Date ? date : null;
    private static string? SourceUrl(Uri origin, string value) => Uri.TryCreate(value, UriKind.Absolute, out _) ? SelfCheckSeoRules.AbsoluteUrl(origin, value, false) : null;
}
@section Head {
    <link rel="stylesheet" href="~/assets/css/self-check.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/emergency-v2.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/contact-v2.css" asp-append-version="true">
}
<article class="self-check-page emergency-v2 contact-v2 site-chrome-wrap" data-contact-v2>
    <nav class="self-check-crumbs" aria-label="Bạn đang ở"><ol><li><a href="/">Trang chủ</a></li><li aria-current="page">@Model.Value("title")</li></ol></nav>
    <header class="self-check-heading"><div class="self-check-heading__title"><span class="self-check-spot">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "call")</span><h1>@Model.Value("title")</h1></div><p>@Model.Value("lead")</p>@await Html.PartialAsync("~/Views/Partials/_SelfCheckUpdated.cshtml", Model)</header>
    @if (image is not null) { <figure class="emergency-image"><img src="@image.Url()" alt="@Model.Value("illustrationAlt")" decoding="async"></figure> }
    <section class="self-check-section" id="tinh-huong" aria-labelledby="contact-case-title">
        <h2 id="contact-case-title">@Model.Value("situationsTitle")</h2>
        @if (situations.Length > 0) {
            <ul class="contact-situations">@foreach (var row in situations) { <li><a href="@Target(row)"><span class="self-check-spot">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", EmergencyContent.Text(row, "icon"))</span><span><b>@EmergencyContent.Text(row, "title")</b><small>@EmergencyContent.Text(row, "description")</small></span><span aria-hidden="true">›</span></a></li> }</ul>
        }
        <aside class="contact-note"><h3>Muốn trình báo</h3><p>@site.Value("noReportNote")</p><p>@Model.Value("reportPreparation")</p></aside>
    </section>
    <section class="self-check-section" id="ho-tro" aria-labelledby="contact-help-title">
        <h2 id="contact-help-title">@Model.Value("contactsTitle")</h2>
        @if (bankSteps.Any()) { <div class="emergency-support"><h3>Cách tự tìm số ngân hàng của bạn</h3><ol class="emergency-bank-steps">@foreach (var step in bankSteps) { <li>@step</li> }</ol>@if (Model.Value<string>("bankListNote") is { Length: > 0 } bankNote) { <p class="emergency-note">@bankNote</p> }</div> }
        @if (emergency is not null) { @await Html.PartialAsync("~/Views/Partials/_ContactHotlines.cshtml", (emergency, "stateHotlines", "Số do Nhà nước vận hành")) }
    </section>
    <section class="self-check-section" id="nguon" aria-labelledby="contact-source-title">
        <h2 id="contact-source-title">@Model.Value("sourcesTitle")</h2>
        <aside class="contact-note"><h3>Đọc trước khi dùng</h3><p>@Model.Value("sourcesWarning")</p></aside>
        <div class="contact-sources">@foreach (var row in EmergencyContent.Rows(Model, "verificationSources")) {
            var url = SourceUrl(sourceOrigin, EmergencyContent.Text(row, "url"));
            var checkedDate = Checked(EmergencyContent.Text(row, "checkedDate"));
            <section class="emergency-support" data-verification-source><h3>@EmergencyContent.Text(row, "title")</h3><p>@EmergencyContent.Text(row, "description")</p>
                @if (url is not null) { <a class="contact-source-link" href="@url" rel="external">Mở nguồn chính thức<span class="contact-source-url">@url</span></a> }
                @if (checkedDate is { } date && url is not null) { <p class="emergency-note">Kiểm tra gần nhất: <time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("dd/MM/yyyy")</time></p>@if (date.Date < DateTime.UtcNow.Date.AddDays(-90)) { <p class="emergency-note emergency-verification">Quá hạn rà soát. Hãy kiểm tra lại thông tin tại nguồn chính thức.</p> } }
            </section>
        }</div>
        @if (Model.Value<string>("sourceFindingAdvice") is { Length: > 0 } findingAdvice) { <aside class="contact-note contact-note--blue" data-source-finding><h3>Cách tự tìm đúng địa chỉ</h3><p>@findingAdvice</p></aside> }
        <p class="emergency-note">@Model.Value("sourcesNote")</p>
    </section>
    <p class="emergency-note">@site.Value("notOnDutyNote")</p>
    <div class="contact-print"><button class="emergency-button" type="button" data-contact-print>In hoặc lưu PDF</button></div>
</article>
@section Scripts { <script type="module" src="~/assets/js/contact-v2.js" asp-append-version="true"></script> }
