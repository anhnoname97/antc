@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.PublishedCache
@using Umbraco.Cms.Core.Services.Navigation
@using Umbraco.Cms.Core.Web
@inject IDocumentNavigationQueryService Navigation
@inject IPublishedContentCache PublishedCache
@inject IUmbracoContextAccessor ContextAccessor
@inject Umbraco.Plugin.Custom.Core.Quiz.IQuestionBank QuestionBank
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    var preview = ContextAccessor.TryGetUmbracoContext(out var context) && context.InPreviewMode;
    var title = Model.Value<string>("title");
    if (string.IsNullOrWhiteSpace(title)) { title = Model.Name; }
    var lead = Model.Value<string>("lead");
    var tools = Model.Value<IEnumerable<IPublishedContent>>("tools") ?? Enumerable.Empty<IPublishedContent>();
    var knowledge = Model.Value<BlockListModel>("know");
    var image = Model.Value<IPublishedContent>("illustration");
    var homeUrl = Model.Root().DescendantsOrSelfOfType("home").FirstOrDefault()?.Url() ?? "/";
    var checklists = new List<IPublishedContent>();
    // Draft entries are only available to the authenticated Umbraco preview.
    Navigation.TryGetChildrenKeysOfType(Model.Root().Key, "contentManagement", out var libraries);
    foreach (var library in libraries)
    {
        Navigation.TryGetChildrenKeysOfType(library, "checklistFolderV2", out var folders);
        foreach (var folderKey in folders)
        {
            if (PublishedCache.GetById(preview, folderKey) is null) { continue; }
            Navigation.TryGetChildrenKeysOfType(folderKey, "checklistPage", out var keys);
            checklists.AddRange(keys.Select(key => PublishedCache.GetById(preview, key)).OfType<IPublishedContent>()
                .Where(item => item.Value<IEnumerable<string>>("p1Qs")?.Any() == true));
        }
    }
    string? PublicLink(IPublishedContent? target)
    {
        if (target?.TemplateId is not > 0) { return null; }
        if (target.ContentType.Alias is "truocKhiChuyenTienPage" or "truocKhiDauTuVayPage"
            && target.Value<BlockListModel>("qs")?.Any() != true) { return null; }
        if (target.ContentType.Alias == "khiNghiBiLuaPage" && target.Value<BlockListModel>("bq")?.Any() != true) { return null; }
        if (target.ContentType.Alias == "checklistPage" && target.Value<IPublishedContent>("src") is null) { return null; }
        var url = target.Url();
        return url.StartsWith('/') && !url.StartsWith("//") ? url : null;
    }
    string ToolIcon(IPublishedContent target) => target.Value<string>("icon") is { Length: > 0 } icon ? icon : target.ContentType.Alias switch
    {
        "truocKhiChuyenTienPage" => "icon-credit-card",
        "truocKhiDauTuVayPage" => "icon-chart",
        _ => "icon-alert"
    };
}
@section Head {
    <link rel="stylesheet" href="~/assets/css/self-check.css" asp-append-version="true">
}
<div class="self-check-page site-chrome-wrap" data-self-check-landing>
    <nav class="self-check-crumbs" aria-label="Bạn đang ở"><ol><li><a href="@homeUrl">Trang chủ</a></li><li aria-current="page">@title</li></ol></nav>
    <header class="self-check-heading">
        <div class="self-check-heading__title"><span class="self-check-spot">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-check")</span><h1>@title</h1></div>
        @if (!string.IsNullOrWhiteSpace(lead)) { <p>@lead</p> }
    @await Html.PartialAsync("~/Views/Partials/_SelfCheckUpdated.cshtml", Model)</header>
    @if (image is not null)
    {
        <figure class="self-check-illustration"><img src="@image.Url()" alt="@Model.Value("illustrationAlt")" loading="lazy" decoding="async"></figure>
    }
    <section class="self-check-section" aria-labelledby="self-check-tools-title">
        <h2 id="self-check-tools-title">@(Model.Value<string>("toolsTitle"))</h2>
        <div class="self-check-tools">
            @foreach (var tool in tools)
            {
                var toolTitle = tool.Value<string>("title");
                if (string.IsNullOrWhiteSpace(toolTitle)) { toolTitle = tool.Name; }
                @await Html.PartialAsync("~/Views/Partials/_SelfCheckCard.cshtml", new SelfCheckCard(toolTitle, tool.Value<string>("card"), ToolIcon(tool), PublicLink(tool), tool.ContentType.Alias == "khiNghiBiLuaPage", tool.Value<IPublishedContent>("cardImage")?.Url()), new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["ActionLabel"] = "Bắt đầu" })
            }
        </div>
    </section>
    <section class="self-check-section" aria-labelledby="self-check-lists-title">
        <h2 id="self-check-lists-title">@(Model.Value<string>("chkTitle"))</h2>
        <p class="self-check-section__lead">@(Model.Value<string>("chkLead"))</p>
        @if (checklists.Count > 0)
        {
            <div class="self-check-lists">
                @foreach (var checklist in checklists.OrderBy(item => item.SortOrder))
                {
                    var checklistTitle = checklist.Value<string>("title");
                    if (string.IsNullOrWhiteSpace(checklistTitle)) { checklistTitle = checklist.Name; }
                    var source = checklist.Value<IPublishedContent>("src");
                    var sourceTitle = checklist.Value<string>("cardCaption");
                    if (string.IsNullOrWhiteSpace(sourceTitle)) { sourceTitle = source?.Name; }
                    @await Html.PartialAsync("~/Views/Partials/_SelfCheckCard.cshtml", new SelfCheckCard(checklistTitle, sourceTitle, checklist.Value<string>("icon") ?? "icon-check", PublicLink(checklist), checklist.Value<string>("icon") == "icon-alert"), new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["CompactCard"] = true })
                }
            </div>
        }
        else
        {
            <p class="self-check-empty">Các danh sách kiểm tra đang được chuẩn bị. Bạn có thể bắt đầu với phần kiểm tra kiến thức bên dưới.</p>
        }
    </section>
    @if (knowledge?.Any() == true)
    {
        <section class="self-check-section" aria-labelledby="self-check-knowledge-title">
            <h2 id="self-check-knowledge-title">@(Model.Value<string>("knowTitle"))</h2>
            <div class="self-check-knowledge">
                @foreach (var block in knowledge)
                {
                    var content = block.Content;
                    var description = content.Value<string>("desc");
                    var label = content.Value<string>("nhan");
                    if (string.IsNullOrWhiteSpace(label)) { continue; }
                    var cardUrl = content.Value<string>("destinationUrl")?.Trim();
                    if (string.IsNullOrEmpty(cardUrl) || !cardUrl.StartsWith('/') || !Url.IsLocalUrl(cardUrl))
                    {
                        cardUrl = PublicLink(content.Value<IPublishedContent>("trang"));
                    }
                    if (cardUrl?.TrimEnd('/') == "/ngan-hang") { label = System.Text.RegularExpressions.Regex.Replace(label, @"\b\d+\s+câu\b", $"{QuestionBank.Current.GeneralQuestionCount} câu"); }
                    if (cardUrl == "/ngan-hang/#doanh-nghiep")
                    {
                        if (QuestionBank.Current.EnterpriseQuestionCount == 0) { continue; }
                        description = description?.Replace("{count}", QuestionBank.Current.EnterpriseQuestionCount.ToString());
                    }
                    @await Html.PartialAsync("~/Views/Partials/_SelfCheckCard.cshtml", new SelfCheckCard(label, description, content.Value<string>("ic") ?? "icon-help-alt", cardUrl), new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["CompactCard"] = true })
                }
            </div>
        </section>
    }
</div>
