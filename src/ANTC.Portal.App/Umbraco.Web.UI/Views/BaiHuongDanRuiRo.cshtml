@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Globalization
@using Umbraco.Cms.Core.Strings
@using Umbraco.Plugin.Custom.Core.Content
@using Umbraco.Plugin.Custom.Core.PortalV2.Editors
@using Umbraco.Plugin.Custom.Core.PortalV2.RuiRo
@using Umbraco.Plugin.Custom.Core.PortalV2.Schema
@inject RiskContentCache RiskCache
@inject RuiRoDerivation Derivation
@inject Umbraco.Plugin.Custom.Core.Articles.ArticleHtmlSanitizer Sanitizer
@inject Umbraco.Cms.Core.Services.Navigation.IDocumentNavigationQueryService Navigation
@{
    // V2-13i (phần bài): trang "Bài hướng dẫn" của Các rủi ro (riskArticlePage), theo màn lvart của bản dựng v2.
    // Neo #tactic-{khóa} giữ nguyên để trình hỏi Khẩn cấp vẫn trỏ đúng thủ đoạn; ?thu-doan=<mã> tô sáng dòng (WEB-04).
    // Thủ đoạn, đối tượng, kênh, mức độ, bài cùng nhóm, thời gian đọc lấy từ RuiRoDerivation (WEB-01).
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    var data = RiskSnapshot.Read(RiskCache, key => Umbraco.Content(key), Navigation);
    var derived = data.Node(Model.Key) is { } node ? Derivation.Derive(node, data.Nodes) : null;
    IPublishedContent[] Contents(IEnumerable<RiskNode>? nodes) => (nodes ?? []).Select(data.Content).OfType<IPublishedContent>().ToArray();
    var title = RiskAlertContent.Title(Model);
    var group = RiskStructure.GroupOf(Model.GetProperty("primaryGroup")?.GetSourceValue());
    var groupPage = group is null ? null : Umbraco.Content(group.Key);
    var groupPath = groupPage is null ? null : AntcPublicPaths.RiskGroupPath(groupPage.ContentType.Alias);
    var tabs = RiskAlertContent.Tabs(key => Umbraco.Content(key), groupPage?.ContentType.Alias ?? "");
    var icon = tabs.FirstOrDefault(x => x.Current)?.Icon ?? "book";
    var topic = Model.Value<IPublishedContent>("topic");
    var number = topic?.Value<int>("topicNumber") ?? 0;
    var reading = topic?.Value<IPublishedContent>("readingArticle");
    var checklist = topic?.Value<IPublishedContent>("checklist");
    // WEB-03 (QĐ-054): bốn câu dùng chung lấy từ chuyên đề của bài.
    string? TopicText(string alias) => topic?.Value<string>(alias)?.Trim() is { Length: > 0 } v ? v : null;
    var remember = TopicText("rememberLine");
    var mustAsk = TopicText("mustAsk");
    var stopWhen = TopicText("stopWhen");
    var holdWhen = TopicText("holdWhen");
    var signs = RiskAlertContent.Lines(Model, "warningSigns");
    var now = RiskAlertContent.Lines(Model, "actionsNow");
    var avoid = RiskAlertContent.Lines(Model, "avoidActions");
    var references = Model.Value<InlineListValue>("references") ?? InlineListValue.Empty;
    var action = RiskAlertContent.Picked(Model, "actionPage").FirstOrDefault(x => x.TemplateId is > 0);
    var reviewDate = RiskAlertContent.Date(Model, "reviewDate");
    // Anh dau bai (LVIMG cua ban dung): truong illustration cua composition, hien sau phan dau trang nhu trang canh bao.
    var image = Model.Value<IPublishedContent>("illustration");
    var tactics = Contents(derived?.Tactics);
    var audiences = Contents(derived?.Audiences);
    var channels = Contents(derived?.Channels);
    var level = AlertList.LevelCode(derived?.Level);
    var tone = AlertList.LevelTone(level);
    var related = Contents(derived?.Articles.Where(x => x.Key != Model.Key)).Where(x => x.TemplateId is > 0).ToArray();
    var others = related.Where(x => data.Node(x.Key)?.IsKind("huongDan") == true).ToArray();
    var extras = related.Where(x => data.Node(x.Key)?.IsKind("docThem") == true).Take(3).ToArray();
    // Ban chinh thuc 10/11/2026 (lvBody): Kich ban, bang "Vi sao...", Ba cach xu ly, Neu da lo lay tu bai doc chuyen de.
    var parts = RiskReadingParts.Parse(reading?.Value<IHtmlEncodedString>("readingBody")?.ToHtmlString());
    // Uu tien o cua bai huong dan, o trong thi lay tu bai doc chuyen de:
    // - "Tom tat" (summary): cac doan dau phan Kich ban; tieu de muc van lay tu bai doc (form chua co o tieu de).
    // - "Viec can lam ngay" (actionsNow): dong 1 la noi dung khung "Chuyen dang xay ra ngay luc nay?", dong 2 la "Lam ngay" khi phai dung.
    // WEB-12: tom tat qua bo loc HTML truoc khi xuat.
    var summary = Sanitizer.Clean(Model.Value<IHtmlEncodedString>("summary")?.ToHtmlString() ?? "");
    string Plain(string? html) => System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(html ?? "", "<[^>]+>", " "));
    var hasSummary = !string.IsNullOrWhiteSpace(Plain(summary));
    IReadOnlyList<string> urgentText = now.Count > 0 ? [now[0]] : parts.UrgentText;
    var urgentTitle = parts.UrgentTitle ?? (now.Count > 0 ? "Chuyện đang xảy ra ngay lúc này?" : null);
    var stopNow = (now.Count > 1 ? now[1] : null) ?? parts.Decision("DỪNG", "Làm ngay");
    var stopWhenText = stopWhen ?? parts.Decision("DỪNG", "Khi nào");
    var holdWhenText = holdWhen ?? parts.Decision("HOÃN", "Khi nào");
    var holdNow = parts.Decision("HOÃN", "Làm ngay");
    // Ban dung: Cong cu "Truoc khi dau tu, vay" cho chuyen de 3, 4; con lai "Truoc khi chuyen tien".
    var tool = number is 3 or 4
        ? (Url: AntcPublicPaths.GetPath("truocKhiDauTuVayPage", null), Name: "Công cụ: Trước khi đầu tư, vay", Icon: "chart")
        : (Url: AntcPublicPaths.GetPath("truocKhiChuyenTienPage", null), Name: "Công cụ: Trước khi chuyển tiền", Icon: "money");
    var readingName = reading is null ? null : number > 0 ? $"Bài đọc Chuyên đề {number}" : RiskAlertContent.Title(reading);
    // WEB-04: chỉ nhận mã có trong danh sách thủ đoạn của bài; giá trị khác bỏ qua.
    var targetCode = Context.Request.Query["thu-doan"].ToString().Trim();
    string[] numberWords = ["", "một", "hai", "ba", "bốn", "năm", "sáu", "bảy", "tám", "chín", "mười"];
    var signCount = signs.Count < numberWords.Length ? numberWords[signs.Count] + " việc" : "những việc";
    string Filter(string name, string code) => $"{groupPath}?{name}={Uri.EscapeDataString(code)}";
    // Thoi gian doc tinh tren chu cua ca trang, nhu minutes(L.body) cua ban dung.
    var minutes = AlertList.ReadingMinutes(string.Join(" ", new[] { remember, mustAsk, holdWhenText, parts.FirstHeading, urgentTitle, hasSummary ? Plain(summary) : null, stopWhenText, stopNow, holdNow, parts.NoFault, parts.RecoveryTitle, parts.RecoveryText }
        .Concat(audiences.Select(x => x.Name)).Concat(channels.Select(x => x.Name)).Concat(signs).Concat(hasSummary ? [] : parts.FirstParagraphs)
        .Concat(tactics.Select(x => x.Name)).Concat(parts.MythRows.SelectMany(x => new[] { x.Left, x.Right })).Concat(urgentText)
        .Concat(parts.Cases.SelectMany(x => new[] { x.Title, x.Text })).Concat(avoid)
        .Concat(tactics.Select(x => RiskAlertContent.LevelName(RiskAlertContent.Level(x))))
        .Concat(others.Concat(extras).Select(x => RiskAlertContent.Title(x) + " Bài hướng dẫn"))
        .Concat(tactics.Where(x => x.Value<IPublishedContent>("illustration") is not null).Select(x => x.Name)).Append(checklist is null ? null : "Kiểm tra: " + RiskAlertContent.Title(checklist)).Append(tool.Name)
        .Append(reading is null ? null : $"{readingName}: {RiskAlertContent.Title(reading)} Thử 1 câu của chuyên đề này Trang này tóm lại {readingName} do website biên soạn.")
        .Append(reviewDate is { } d ? $"Rà soát gần nhất: {d.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)}" : null)
        // Tieu de muc va nhan co dinh tren trang
        .Append("Tóm tắt Nhớ một câu Câu hỏi phải hỏi Ai thường bị nhắm đến Kênh tiếp cận Dấu hiệu Không chờ dấu hiệu thứ hai. Gặp một trong năm việc này thì chặn ngay việc đó, rồi mới tính tiếp. Cần hoãn lại để kiểm chứng khi Kịch bản Thủ đoạn thường gặp Vì sao người cẩn thận vẫn quyết định sai Điều nhiều người nghĩ Thực tế Việc cần làm ngay Khi phải dừng Làm ngay: Khi cần hoãn Làm ngay: Nếu đã lỡ Cảnh giác với người hứa lấy lại tiền Xem việc cần làm ngay Tự kiểm tra Không nên làm Bài liên quan Đọc thêm")));
    var sections = new List<(string Id, string Name)>();
    if (!string.IsNullOrEmpty(remember) || !string.IsNullOrEmpty(mustAsk) || audiences.Length > 0 || channels.Length > 0) { sections.Add(("lv-sum", "Tóm tắt")); }
    if (signs.Count > 0 || holdWhenText is not null) { sections.Add(("lv-sign", "Dấu hiệu")); }
    if (parts.FirstHeading is not null || hasSummary || tactics.Length > 0 || parts.MythRows.Count > 0) { sections.Add(("lv-how", "Kịch bản")); }
    sections.Add(("lv-now", "Việc cần làm ngay"));
    if (avoid.Count > 0) { sections.Add(("lv-no", "Không nên làm")); }
    var hasRelated = checklist?.TemplateId is > 0 || tool.Url is not null || others.Length > 0 || extras.Length > 0;
    if (hasRelated) { sections.Add(("lv-rel", "Bài liên quan")); }
    // Muc "Doc them": bai doc chuyen de, thu 1 cau, cau tom lai, ngay ra soat (bo dong tham dinh).
    var webRefs = references.Where(r => Uri.TryCreate(r.GetString("url")?.Trim(), UriKind.Absolute, out var u) && u.Scheme == Uri.UriSchemeHttps).ToArray();
    var hasSource = reading?.TemplateId is > 0 || webRefs.Length > 0 || reviewDate is not null;
    if (hasSource) { sections.Add(("lv-src", "Đọc thêm")); }
}
@section Head {
    <link rel="stylesheet" href="~/assets/css/self-check.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/risk-alerts.css" asp-append-version="true">
}
@section Scripts {
    @* Nghe, In, Gửi dùng chung với trang bài đọc; "Chữ lớn" do site.js xử lý qua data-font-toggle. *@
    <script type="module" src="~/assets/js/reading-article.js" asp-append-version="true"></script>
}
<div class="self-check-page risk-page site-chrome-wrap" data-reading>
    <nav class="self-check-crumbs" aria-label="Bạn đang ở">
        <ol>
            <li><a href="/">Trang chủ</a></li>
            <li><a href="/cac-rui-ro/">RỦI RO</a></li>
            @if (groupPage is not null && groupPath is not null) { <li><a href="@groupPath">@(tabs.FirstOrDefault(x => x.Current)?.Name ?? groupPage.Name)</a></li> }
            <li aria-current="page">@title</li>
        </ol>
    </nav>

    <article class="risk-alert risk-guide">
        <header class="risk-guide__head">
            <p class="risk-eyebrow">Bài hướng dẫn@(number > 0 ? $" · Chuyên đề {number}" : "")</p>
            <div class="self-check-heading__title">
                <span class="self-check-spot@(group?.Alias == "luaDaoPage" ? " risk-spot--d" : "")">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", icon)</span>
                <h1>@title</h1>
            </div>
            <p class="risk-docmeta">
                @if (reviewDate is { } date) { <span>Cập nhật: <time datetime="@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</time></span> }
                <span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "clock")Đọc khoảng @minutes phút</span>
                @if (level.Length > 0)
                {
                    <span class="risk-level risk-level--@tone">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", tone == "d" ? "stop" : tone == "h" ? "clock" : "info")<span>Mức độ cần thận trọng: @RiskAlertContent.LevelName(level)</span></span>
                }
            </p>
        </header>

        @if (image is not null)
        {
            <figure class="risk-figure"><img src="@image.Url()" alt="@Model.Value("illustrationAlt")" decoding="async"></figure>
        }

        <div class="risk-pagetools" role="group" aria-label="Công cụ cho trang này">
            <button type="button" class="tbtn" data-reading-speak hidden aria-pressed="false">
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11 5 6 9H3v6h3l5 4zM15.5 9a4 4 0 0 1 0 6M18 6.5a8 8 0 0 1 0 11"/></svg><span>Nghe bài viết</span>
            </button>
            <button type="button" class="tbtn" data-font-toggle data-font-label="Chữ lớn" aria-pressed="false"><b aria-hidden="true">A+</b><span>Chữ lớn</span></button>
            <button type="button" class="tbtn" data-reading-print>
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 8V3h10v5M7 17H4v-7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v7h-3M7 14h10v7H7z"/></svg><span>In</span>
            </button>
            <button type="button" class="tbtn" data-reading-share>
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"/></svg><span>Gửi</span>
            </button>
        </div>
        <p class="risk-okmsg" data-reading-status role="status" hidden></p>

        @if (sections.Count > 1)
        {
            <nav class="risk-toc" aria-label="Mục lục">
                <b>Trong bài này</b>
                <ol>@foreach (var s in sections) { <li><a href="#@s.Id">@s.Name</a></li> }</ol>
            </nav>
        }

        @* Phần "Nghe bài viết" đọc *@
        <div class="risk-alert__read" data-reading-body>
            @if (sections.Any(x => x.Id == "lv-sum"))
            {
                <section class="risk-section" id="lv-sum" aria-labelledby="lv-sum-h">
                    <h2 id="lv-sum-h">Tóm tắt</h2>
                    @if (!string.IsNullOrEmpty(remember)) { <div class="risk-remember"><span class="risk-kicker">Nhớ một câu</span><p>@remember</p></div> }
                    @if (!string.IsNullOrEmpty(mustAsk)) { <div class="risk-mustask"><span class="risk-kicker">Câu hỏi phải hỏi</span><p>@mustAsk</p></div> }
                    @if (audiences.Length > 0)
                    {
                        <h3>Ai thường bị nhắm đến</h3>
                        <ul class="risk-chips">@foreach (var a in audiences) { <li><a href="@Filter("doi-tuong", RiskAlertContent.AudienceCode(a))">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", RiskAlertContent.IconId(a.Value<string>("icon"), "users"))<span>@a.Name</span></a></li> }</ul>
                    }
                    @if (channels.Length > 0)
                    {
                        <h3>Kênh tiếp cận</h3>
                        <ul class="risk-chips">@foreach (var c in channels) { <li><a href="@Filter("kenh", RiskAlertContent.ChannelCode(c))">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", RiskAlertContent.IconId(c.Value<string>("icon"), "chat"))<span>@c.Name</span></a></li> }</ul>
                    }
                </section>
            }

            @if (sections.Any(x => x.Id == "lv-sign"))
            {
                <section class="risk-section" id="lv-sign" aria-labelledby="lv-sign-h">
                    <h2 id="lv-sign-h">Dấu hiệu</h2>
                    @if (signs.Count > 0)
                    {
                        <p class="risk-small">Không chờ dấu hiệu thứ hai. Gặp một trong @signCount này thì chặn ngay việc đó, rồi mới tính tiếp.</p>
                        <ul class="risk-signs">@foreach (var sign in signs) { <li>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "stop")<span>@sign</span></li> }</ul>
                    }
                    @if (holdWhenText is not null) { <div class="risk-note"><b>Cần hoãn lại để kiểm chứng khi</b><p>@holdWhenText</p></div> }
                </section>
            }

            @if (sections.Any(x => x.Id == "lv-how"))
            {
                <section class="risk-section" id="lv-how" aria-labelledby="lv-how-h">
                    <h2 id="lv-how-h">Kịch bản</h2>
                    @if (parts.FirstHeading is not null)
                    {
                        <h3>@parts.FirstHeading</h3>
                    }
                    @if (hasSummary) { <div class="risk-rte">@Html.Raw(summary)</div> }
                    else if (parts.FirstHeading is not null)
                    {
                        foreach (var para in parts.FirstParagraphs) { <p>@para</p> }
                    }
                    @if (tactics.Length > 0)
                    {
                        <h3>Thủ đoạn thường gặp</h3>
                        <ul class="risk-tactics">
                            @foreach (var tactic in tactics)
                            {
                                var tl = RiskAlertContent.Level(tactic);
                                var tt = AlertList.LevelTone(tl);
                                var hit = targetCode.Length > 0 && string.Equals(tactic.Value<string>("code")?.Trim(), targetCode, StringComparison.OrdinalIgnoreCase);
                                <li id="tactic-@tactic.Key.ToString("N")" tabindex="-1" class="@(hit ? "is-hit" : null)" aria-current="@(hit ? "true" : null)">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "alert")<span>@tactic.Name</span>
                                    @if (tl.Length > 0) { <span class="risk-level risk-level--@tt">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", tt == "d" ? "stop" : tt == "h" ? "clock" : "info")<span>@RiskAlertContent.LevelName(tl)</span></span> }
                                </li>
                            }
                        </ul>
                        @* Ban chinh thuc (TACIMG): luoi anh cua cac thu doan co anh; mot anh thi rong ca cot. *@
                        var gallery = tactics.Select(x => (Tactic: x, Image: x.Value<IPublishedContent>("illustration"))).Where(x => x.Image is not null).ToArray();
                        if (gallery.Length > 0)
                        {
                            <div class="risk-tgal@(gallery.Length == 1 ? " risk-tgal--one" : "")">
                                @foreach (var g in gallery)
                                {
                                    <figure class="risk-tfig"><img src="@g.Image!.Url()" alt="@g.Tactic.Value("illustrationAlt")" loading="lazy" decoding="async"><figcaption><span>@g.Tactic.Name</span></figcaption></figure>
                                }
                            </div>
                        }
                    }
                    @if (parts.MythRows.Count > 0)
                    {
                        <h3>Vì sao người cẩn thận vẫn quyết định sai</h3>
                        <div class="risk-tblwrap">
                            <table class="risk-dtbl">
                                <thead><tr><th scope="col">@(parts.MythHead?.Left ?? "Điều nhiều người nghĩ")</th><th scope="col">@(parts.MythHead?.Right ?? "Thực tế")</th></tr></thead>
                                <tbody>@foreach (var row in parts.MythRows) { <tr><td>@row.Left</td><td>@row.Right</td></tr> }</tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            <section class="risk-section" id="lv-now" aria-labelledby="lv-now-h">
                <h2 id="lv-now-h">Việc cần làm ngay</h2>
                @if (urgentTitle is not null && urgentText.Count > 0)
                {
                    <div class="risk-now"><b>@urgentTitle</b>@foreach (var para in urgentText) { <p>@para</p> }</div>
                }
                @if (stopWhenText is not null || stopNow is not null)
                {
                    <div class="risk-cond"><b>Khi phải dừng</b><ul>
                        @if (stopWhenText is not null) { <li>@stopWhenText</li> }
                        @if (stopNow is not null) { <li><b>Làm ngay:</b> @stopNow</li> }
                    </ul></div>
                }
                @if (holdNow is not null) { <div class="risk-cond"><b>Khi cần hoãn</b><ul><li><b>Làm ngay:</b> @holdNow</li></ul></div> }
                @if (parts.NoFault is not null || parts.Cases.Count > 0)
                {
                    <h3>Nếu đã lỡ</h3>
                    @if (parts.NoFault is not null) { <p><b>@parts.NoFault</b></p> }
                    @if (parts.Cases.Count > 0)
                    {
                        <ol class="risk-steps">@foreach (var c in parts.Cases) { <li><span>@if (c.Title.Length > 0) { <strong>@c.Title</strong> }@(c.Title.Length > 0 ? " " : "")@c.Text</span></li> }</ol>
                    }
                }
                @if (parts.RecoveryText is not null) { <div class="risk-note risk-note--r"><b>Cảnh giác với người hứa lấy lại tiền</b><p>@parts.RecoveryText</p></div> }
                <div class="risk-actions">
                    <a class="risk-btn risk-btn--stop" href="@(action?.Url() ?? "/khan-cap/")">Xem việc cần làm ngay</a>
                    @if (checklist?.TemplateId is > 0) { <a class="risk-btn" href="@checklist.Url()">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "quiz")Tự kiểm tra</a> }
                </div>
            </section>

            @if (avoid.Count > 0)
            {
                <section class="risk-section" id="lv-no" aria-labelledby="lv-no-h">
                    <h2 id="lv-no-h">Không nên làm</h2>
                    <ul class="risk-signs risk-signs--no">@foreach (var line in avoid) { <li>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "x")<span>@line.TrimEnd('.')</span></li> }</ul>
                </section>
            }
        </div>

        @if (hasRelated)
        {
            <section class="risk-section" id="lv-rel" aria-labelledby="lv-rel-h">
                <h2 id="lv-rel-h">Bài liên quan</h2>
                <ul class="risk-links">
                    @if (checklist?.TemplateId is > 0)
                    {
                        <li><a href="@checklist.Url()">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "quiz")<span>Kiểm tra: @RiskAlertContent.Title(checklist)</span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "chevron-right")</a></li>
                    }
                    @if (tool.Url is not null)
                    {
                        <li><a href="@tool.Url">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", tool.Icon)<span>@tool.Name</span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "chevron-right")</a></li>
                    }
                    @foreach (var other in others)
                    {
                        <li><a href="@other.Url()">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "doc")<span>@RiskAlertContent.Title(other)<small>Bài hướng dẫn</small></span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "chevron-right")</a></li>
                    }
                    @foreach (var extra in extras)
                    {
                        <li><a href="@extra.Url()">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "doc")<span>@RiskAlertContent.Title(extra)<small>Bài đọc thêm</small></span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "chevron-right")</a></li>
                    }
                </ul>
            </section>
        }

        @if (hasSource)
        {
            <section class="risk-section" id="lv-src" aria-labelledby="lv-src-h">
                <h2 id="lv-src-h">Đọc thêm</h2>
                <ul class="risk-links">
                    @if (reading?.TemplateId is > 0)
                    {
                        <li><a href="@reading.Url()">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "book")<span>@readingName: @RiskAlertContent.Title(reading)</span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "chevron-right")</a></li>
                    }
                    @foreach (var r in webRefs)
                    {
                        <li><a href="@r.GetString("url")!.Trim()" rel="noopener" target="_blank">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "doc")<span>@r.GetString("title")@if (r.GetString("organization") is { Length: > 0 } org) { <small>@org</small> }</span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "chevron-right")</a></li>
                    }
                    @{
                        var sampleUrl = (AntcPublicPaths.GetPath("thiThuPage", null) ?? "/thu-suc/") + (number > 0 ? $"?cd={number}" : "");
                    }
                    <li><a href="@sampleUrl">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-help")<span>Thử 1 câu của chuyên đề này</span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "chevron-right")</a></li>
                </ul>
                @if (reading?.TemplateId is > 0)
                {
                    <p class="risk-small">Trang này tóm lại <a class="content-source-link" href="@reading.Url()" title="@RiskAlertContent.Title(reading)">@readingName</a> do website biên soạn.</p>
                }
                @if (reviewDate is { } rd) { <p class="risk-small">Rà soát gần nhất: @rd.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</p> }
            </section>
        }
    </article>
</div>
