@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Globalization
@using System.Text.Json.Nodes
@using Umbraco.Cms.Core.Strings
@using Umbraco.Plugin.Custom.Core.Content
@using Umbraco.Plugin.Custom.Core.PortalV2.Editors
@using Umbraco.Plugin.Custom.Core.PortalV2.RuiRo
@using Umbraco.Plugin.Custom.Core.PortalV2.Schema
@{
    // V2-13i (phần bài): trang "Bài hướng dẫn" của Các rủi ro (riskArticlePage), theo màn lvart của bản dựng v2.
    // Neo #tactic-{khóa} giữ nguyên để trình hỏi Khẩn cấp vẫn trỏ đúng thủ đoạn.
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    var site = Model.Root();
    var title = RiskAlertContent.Title(Model);
    var group = RiskStructure.GroupOf(Model.GetProperty("primaryGroup")?.GetSourceValue());
    var groupPage = group is null ? null : Umbraco.Content(group.Key);
    var groupPath = groupPage is null ? null : AntcPublicPaths.RiskGroupPath(groupPage.ContentType.Alias);
    var tabs = RiskAlertContent.Tabs(key => Umbraco.Content(key), groupPage?.ContentType.Alias ?? "");
    var icon = tabs.FirstOrDefault(x => x.Current)?.Icon ?? "book";
    var topic = Model.Value<IPublishedContent>("topic");
    var number = topic?.Value<int>("topicNumber") ?? 0;
    var reading = topic?.Value<IPublishedContent>("readingArticle");
    var checklist = topic?.Value<IPublishedContent>("checklist");
    var summary = Model.Value<IHtmlEncodedString>("summary")?.ToHtmlString();
    var remember = Model.Value<string>("rememberLine")?.Trim();
    var mustAsk = Model.Value<string>("mustAsk")?.Trim();
    var signs = RiskAlertContent.Lines(Model, "warningSigns");
    var now = RiskAlertContent.Lines(Model, "actionsNow");
    var avoid = RiskAlertContent.Lines(Model, "avoidActions");
    var scenarios = Model.Value<InlineListValue>("scenarios") ?? InlineListValue.Empty;
    var references = Model.Value<InlineListValue>("references") ?? InlineListValue.Empty;
    var action = RiskAlertContent.Picked(Model, "actionPage").FirstOrDefault(x => x.TemplateId is > 0);
    var reviewDate = RiskAlertContent.Date(Model, "reviewDate");
    var reviewer = Model.Value<string>("reviewer")?.Trim();
    var version = Model.Value<string>("version")?.Trim();
    var tactics = site.Descendants().Where(x => x.ContentType.Alias == "tacticItem" && x.Value<bool>("isActive")
        && RiskAlertContent.Picked(x, "containingArticle").Any(a => a.Key == Model.Key)).OrderBy(x => x.SortOrder).ToArray();
    // Ai thuong bi nham den: doi tuong co thu doan cua bai (giong RuiRoDerivation va grpOfLv cua ban dung v2)
    var tacticKeys = tactics.Select(x => x.Key).ToHashSet();
    var audiences = site.Descendants().Where(x => x.ContentType.Alias == "audienceItem"
        && RiskAlertContent.Picked(x, "tactics").Any(t => tacticKeys.Contains(t.Key))).OrderBy(x => x.SortOrder).ToArray();
    var channels = tactics.SelectMany(x => RiskAlertContent.Picked(x, "channels")).DistinctBy(x => x.Key).ToArray();
    var levels = tactics.Select(RiskAlertContent.Level).Where(x => x.Length > 0).ToArray();
    var level = AlertList.Levels.Select(x => x.Code).FirstOrDefault(levels.Contains) ?? "";
    var tone = AlertList.LevelTone(level);
    var others = site.Descendants().Where(x => x.ContentType.Alias == "riskArticlePage" && x.Key != Model.Key && x.TemplateId is > 0
        && RiskAlertContent.IsKind(x, "Bài hướng dẫn") && group is not null
        && RiskStructure.GroupOf(x.GetProperty("primaryGroup")?.GetSourceValue())?.Key == group.Key).ToArray();
    string Plain(string? html) => System.Text.RegularExpressions.Regex.Replace(html ?? "", "<[^>]+>", " ");
    var minutes = AlertList.ReadingMinutes(string.Join(' ', new[] { Plain(summary), remember, mustAsk }.Concat(signs).Concat(now).Concat(avoid)
        .Concat(scenarios.Select(x => x.GetString("tacticName") + " " + x.Data["steps"]?.ToJsonString()))));
    IReadOnlyList<string> Steps(InlineListRow row) => row.Data["steps"] switch
    {
        JsonArray list => list.Select(x => x?.ToString().Trim() ?? "").Where(x => x.Length > 0).ToArray(),
        JsonValue v when v.TryGetValue(out string? s) => s.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
        _ => []
    };
    string[] numberWords = ["", "một", "hai", "ba", "bốn", "năm", "sáu", "bảy", "tám", "chín", "mười"];
    var signCount = signs.Count < numberWords.Length ? numberWords[signs.Count] + " việc" : "những việc";
    string Filter(string name, string code) => $"{groupPath}?{name}={Uri.EscapeDataString(code)}";
    var sections = new List<(string Id, string Name)>();
    if (!string.IsNullOrWhiteSpace(Plain(summary)) || !string.IsNullOrEmpty(remember) || !string.IsNullOrEmpty(mustAsk) || audiences.Length > 0 || channels.Length > 0) { sections.Add(("lv-sum", "Tóm tắt")); }
    if (signs.Count > 0) { sections.Add(("lv-sign", "Dấu hiệu")); }
    if (scenarios.Count > 0 || tactics.Length > 0) { sections.Add(("lv-how", "Kịch bản")); }
    if (now.Count > 0 || action is not null) { sections.Add(("lv-now", "Việc cần làm ngay")); }
    if (avoid.Count > 0) { sections.Add(("lv-no", "Không nên làm")); }
    var hasRelated = reading?.TemplateId is > 0 || checklist?.TemplateId is > 0 || others.Length > 0;
    if (hasRelated) { sections.Add(("lv-rel", "Bài liên quan")); }
    var hasSource = references.Count > 0 || !string.IsNullOrEmpty(reviewer) || reviewDate is not null;
    if (hasSource) { sections.Add(("lv-src", "Nguồn")); }
}
@section Head {
    <link rel="stylesheet" href="~/assets/css/self-check.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/risk-alerts.css" asp-append-version="true">
}
@section Scripts {
    @* Nghe, In, Gửi dùng chung với trang bài đọc; "Chữ lớn" do site.js xử lý qua data-font-toggle. *@
    <script type="module" src="~/assets/js/reading-article.js" asp-append-version="true"></script>
}
<div class="self-check-page risk-page site-chrome-wrap" data-reading>
    <nav class="self-check-crumbs" aria-label="Bạn đang ở">
        <ol>
            <li><a href="/">Trang chủ</a></li>
            <li><a href="/cac-rui-ro/">Các rủi ro</a></li>
            @if (groupPage is not null && groupPath is not null) { <li><a href="@groupPath">@(tabs.FirstOrDefault(x => x.Current)?.Name ?? groupPage.Name)</a></li> }
            <li aria-current="page">@title</li>
        </ol>
    </nav>

    <article class="risk-alert risk-guide">
        <header class="risk-guide__head">
            <p class="risk-eyebrow">Bài hướng dẫn@(number > 0 ? $" · Chuyên đề {number}" : "")</p>
            <div class="self-check-heading__title">
                <span class="self-check-spot@(group?.Alias == "luaDaoPage" ? " risk-spot--d" : "")">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", icon)</span>
                <h1>@title</h1>
            </div>
            <p class="risk-docmeta">
                @if (reviewDate is { } date) { <span>Cập nhật: <time datetime="@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</time></span> }
                <span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "clock")Đọc khoảng @minutes phút</span>
                @if (level.Length > 0)
                {
                    <span class="risk-level risk-level--@tone">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", tone == "d" ? "stop" : tone == "h" ? "clock" : "info")<span>Mức độ cần thận trọng: @RiskAlertContent.LevelName(level)</span></span>
                }
            </p>
        </header>

        <div class="risk-pagetools" role="group" aria-label="Công cụ cho trang này">
            <button type="button" class="tbtn" data-reading-speak hidden aria-pressed="false">
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11 5 6 9H3v6h3l5 4zM15.5 9a4 4 0 0 1 0 6M18 6.5a8 8 0 0 1 0 11"/></svg><span>Nghe bài viết</span>
            </button>
            <button type="button" class="tbtn" data-font-toggle data-font-label="Chữ lớn" aria-pressed="false"><b aria-hidden="true">A+</b><span>Chữ lớn</span></button>
            <button type="button" class="tbtn" data-reading-print>
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 8V3h10v5M7 17H4v-7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v7h-3M7 14h10v7H7z"/></svg><span>In</span>
            </button>
            <button type="button" class="tbtn" data-reading-share>
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"/></svg><span>Gửi</span>
            </button>
        </div>
        <p class="risk-okmsg" data-reading-status role="status" hidden></p>

        @if (sections.Count > 1)
        {
            <nav class="risk-toc" aria-label="Mục lục">
                <b>Trong bài này</b>
                <ol>@foreach (var s in sections) { <li><a href="#@s.Id">@s.Name</a></li> }</ol>
            </nav>
        }

        @* Phần "Nghe bài viết" đọc *@
        <div class="risk-alert__read" data-reading-body>
            @if (sections.Any(x => x.Id == "lv-sum"))
            {
                <section class="risk-section" id="lv-sum" aria-labelledby="lv-sum-h">
                    <h2 id="lv-sum-h">Tóm tắt</h2>
                    @if (!string.IsNullOrEmpty(remember)) { <div class="risk-remember"><span class="risk-kicker">Nhớ một câu</span><p>@remember</p></div> }
                    @if (!string.IsNullOrEmpty(mustAsk)) { <div class="risk-mustask"><span class="risk-kicker">Câu hỏi phải hỏi</span><p>@mustAsk</p></div> }
                    @if (!string.IsNullOrWhiteSpace(Plain(summary))) { <div class="risk-rte">@Html.Raw(summary)</div> }
                    @if (audiences.Length > 0)
                    {
                        <h3>Ai thường bị nhắm đến</h3>
                        <ul class="risk-chips">@foreach (var a in audiences) { <li><a href="@Filter("doi-tuong", RiskAlertContent.AudienceCode(a))">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", RiskAlertContent.IconId(a.Value<string>("icon"), "users"))<span>@a.Name</span></a></li> }</ul>
                    }
                    @if (channels.Length > 0)
                    {
                        <h3>Kênh tiếp cận</h3>
                        <ul class="risk-chips">@foreach (var c in channels) { <li><a href="@Filter("kenh", RiskAlertContent.ChannelCode(c))">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", RiskAlertContent.IconId(c.Value<string>("icon"), "chat"))<span>@c.Name</span></a></li> }</ul>
                    }
                </section>
            }

            @if (signs.Count > 0)
            {
                <section class="risk-section" id="lv-sign" aria-labelledby="lv-sign-h">
                    <h2 id="lv-sign-h">Dấu hiệu</h2>
                    <p class="risk-small">Không chờ dấu hiệu thứ hai. Gặp một trong @signCount này thì chặn ngay việc đó, rồi mới tính tiếp.</p>
                    <ul class="risk-signs">@foreach (var sign in signs) { <li>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "stop")<span>@sign</span></li> }</ul>
                </section>
            }

            @if (sections.Any(x => x.Id == "lv-how"))
            {
                <section class="risk-section" id="lv-how" aria-labelledby="lv-how-h">
                    <h2 id="lv-how-h">Kịch bản</h2>
                    @foreach (var row in scenarios)
                    {
                        var steps = Steps(row);
                        if (row.GetString("tacticName") is { Length: > 0 } name) { <h3>@name</h3> }
                        if (steps.Count > 0) { <ol class="risk-steps">@foreach (var step in steps) { <li><span>@step</span></li> }</ol> }
                    }
                    @if (tactics.Length > 0)
                    {
                        <h3>Thủ đoạn thường gặp</h3>
                        <ul class="risk-tactics">
                            @foreach (var tactic in tactics)
                            {
                                var tl = RiskAlertContent.Level(tactic);
                                var tt = AlertList.LevelTone(tl);
                                <li id="tactic-@tactic.Key.ToString("N")" tabindex="-1">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "alert")<span>@tactic.Name</span>
                                    @if (tl.Length > 0) { <span class="risk-level risk-level--@tt">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", tt == "d" ? "stop" : tt == "h" ? "clock" : "info")<span>@RiskAlertContent.LevelName(tl)</span></span> }
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            @if (sections.Any(x => x.Id == "lv-now"))
            {
                <section class="risk-section" id="lv-now" aria-labelledby="lv-now-h">
                    <h2 id="lv-now-h">Việc cần làm ngay</h2>
                    @if (now.Count > 0)
                    {
                        <div class="risk-now">@foreach (var line in now) { <p>@line</p> }</div>
                    }
                    <div class="risk-actions">
                        <a class="risk-btn risk-btn--stop" href="@(action?.Url() ?? "/khan-cap/")">Xem việc cần làm ngay</a>
                        @if (checklist?.TemplateId is > 0) { <a class="risk-btn" href="@checklist.Url()">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "quiz")Tự kiểm tra bằng checklist</a> }
                    </div>
                </section>
            }

            @if (avoid.Count > 0)
            {
                <section class="risk-section" id="lv-no" aria-labelledby="lv-no-h">
                    <h2 id="lv-no-h">Không nên làm</h2>
                    <ul class="risk-signs risk-signs--no">@foreach (var line in avoid) { <li>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "x")<span>@line.TrimEnd('.')</span></li> }</ul>
                </section>
            }
        </div>

        @if (hasRelated)
        {
            <section class="risk-section" id="lv-rel" aria-labelledby="lv-rel-h">
                <h2 id="lv-rel-h">Bài liên quan</h2>
                <ul class="risk-links">
                    @if (checklist?.TemplateId is > 0)
                    {
                        <li><a href="@checklist.Url()">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "quiz")<span>Checklist: @RiskAlertContent.Title(checklist)<small>Danh sách kiểm tra</small></span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "chevron-right")</a></li>
                    }
                    @if (reading?.TemplateId is > 0)
                    {
                        <li><a href="@reading.Url()">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "book")<span>@RiskAlertContent.Title(reading)<small>Bài đọc chuyên đề</small></span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "chevron-right")</a></li>
                    }
                    @foreach (var other in others)
                    {
                        <li><a href="@other.Url()">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "doc")<span>@RiskAlertContent.Title(other)<small>Bài hướng dẫn</small></span>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "chevron-right")</a></li>
                    }
                </ul>
            </section>
        }

        @if (hasSource)
        {
            <section class="risk-section" id="lv-src" aria-labelledby="lv-src-h">
                <h2 id="lv-src-h">Nguồn</h2>
                @if (references.Count > 0)
                {
                    <ul class="risk-refs">
                        @foreach (var r in references)
                        {
                            var name = r.GetString("title") ?? "";
                            var org = r.GetString("organization");
                            var url = Uri.TryCreate(r.GetString("url")?.Trim(), UriKind.Absolute, out var u) && u.Scheme == Uri.UriSchemeHttps ? u.AbsoluteUri : null;
                            <li>@if (url is not null) { <a href="@url" rel="noopener" target="_blank">@name</a> } else { <span>@name</span> }@if (!string.IsNullOrEmpty(org)) { <text> · @org</text> }</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrEmpty(reviewer) || !string.IsNullOrEmpty(version))
                {
                    <p class="risk-small">@(string.IsNullOrEmpty(version) ? "" : $"Bản {version}. ")@(string.IsNullOrEmpty(reviewer) ? "" : $"Thẩm định chuyên môn: {reviewer}.")</p>
                }
                @if (reviewDate is { } rd) { <p class="risk-small">Rà soát gần nhất: @rd.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</p> }
            </section>
        }
    </article>
</div>