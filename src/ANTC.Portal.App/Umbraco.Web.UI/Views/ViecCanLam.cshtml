@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
    var site = Model.Root();
    var title = Model.Value<string>("title") is { Length: > 0 } heading ? heading : Model.Name;
    var steps = ActionGuideData.Steps(Model);
    var screening = EmergencyContent.Rows(Model, "screeningQuestions");
    var image = Model.Value<IPublishedContent>("illustration");
    var bankSteps = site.Value<IEnumerable<string>>("bankLookupSteps") ?? [];
    var review = Model.Value<DateTime?>("reviewDate");
    var verification = Model.Value<string>("verificationSource");
    var hasReview = review is { Year: > 1900 } date && date.Date <= DateTime.UtcNow.Date && !string.IsNullOrWhiteSpace(verification);
    var displayNumber = 0;
}
@section Head {
    <link rel="stylesheet" href="~/assets/css/self-check.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/self-check-tool.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/emergency-v2.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/action-guide.css" asp-append-version="true">
}
<article class="self-check-page self-check-tool action-guide site-chrome-wrap" data-action-guide="@Model.Key.ToString("N")">
    <nav class="self-check-crumbs" aria-label="Bạn đang ở"><ol><li><a href="/">Trang chủ</a></li><li><a href="/khan-cap/">Khẩn cấp</a></li><li aria-current="page">@title</li></ol></nav>
    <header class="self-check-heading"><p class="self-check-eyebrow">KHẨN CẤP · Việc cần làm ngay</p><div class="self-check-heading__title"><span class="self-check-spot emergency-spot">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", Model.Value<string>("icon") ?? "alert")</span><h1>@title</h1></div><p>@Model.Value("lead")</p>@await Html.PartialAsync("~/Views/Partials/_SelfCheckUpdated.cshtml", Model)</header>
    @if (image is not null) { <figure class="emergency-image"><img src="@image.Url()" alt="@Model.Value("illustrationAlt")" decoding="async"></figure> }
    <div class="action-guide-page-tools" role="group" aria-label="Công cụ cho trang này">
        <button class="self-check-button" type="button" data-guide-speak aria-pressed="false" hidden>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-sound")<span>Nghe bài viết</span></button>
        <button class="self-check-button" type="button" data-font-toggle data-font-label="Chữ lớn" aria-pressed="false"><b aria-hidden="true">A+</b><span>Chữ lớn</span></button>
        <button class="self-check-button" type="button" data-guide-print>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-print")<span>In</span></button>
        <button class="self-check-button" type="button" data-guide-share>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-share")<span>Gửi</span></button>
    </div>
    <p class="emergency-note" role="status" data-guide-message hidden></p>
    @if (steps.Length > 0)
    {
        <div class="self-check-guidance">
        @foreach (var step in steps)
        {
            var condition = step.OnlyIf is { } conditionKey ? Umbraco.Content(conditionKey) : null;
            var after = step.SnippetAfter is { } snippetKey ? Umbraco.Content(snippetKey) : null;
            var followUp = step.FollowUpPage is { } followUpKey ? Umbraco.Content(followUpKey) : null;
            var actionable = !string.IsNullOrWhiteSpace(step.MainText);
            if (actionable) { displayNumber++; }
            <section id="buoc-@step.Number" class="@(step.MainText.Length == 0 ? "self-check-guidance__notice" : "action-guide-step")" data-guide-step>
                @if (actionable) { <span class="action-guide-step-number" aria-label="Bước @displayNumber">@displayNumber</span> }
                <div class="action-guide-step-body">
                @if (condition is not null) { <aside class="action-guide-condition"><b>Điều kiện áp dụng</b>@await Html.PartialAsync("~/Views/Partials/_ActionGuideSnippet.cshtml", condition, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["ShowSnippetBody"] = !steps.Any(item => item.SnippetAfter == step.OnlyIf) })</aside> }
                @if (actionable) { <h2>@step.MainText</h2> }
                @if (step.NoticeTitle.Length > 0 && (!step.HasFollowUp || step.NoticeTitle != step.FollowUpQuestion)) { <h2>@step.NoticeTitle</h2> }
                @if (step.Details.Any(paragraph => !string.IsNullOrWhiteSpace(paragraph))) { <div class="action-guide-details">@foreach (var paragraph in step.Details.Where(paragraph => !string.IsNullOrWhiteSpace(paragraph))) { <p class="action-guide-paragraph">@paragraph</p> }</div> }
                @if (step.SampleScript.Length > 0) { <blockquote><b>Câu nói mẫu</b><p>@step.SampleScript</p></blockquote> }
                @if (step.ShowBankLookup && bankSteps.Any()) { <details class="action-guide-bank"><summary>Cách tự tìm số ngân hàng của bạn</summary><ol>@foreach (var line in bankSteps) { <li>@line</li> }</ol></details> }
                @if (step.Links.Length > 0) { <div class="self-check-controls">@foreach (var link in step.Links) { if (ActionGuideLinks.IsAllowed(link.Url)) { <a class="self-check-button" href="@link.Url">@link.Label</a> } }</div> }
                @if (after is not null) { <aside class="action-guide-snippet">@await Html.PartialAsync("~/Views/Partials/_ActionGuideSnippet.cshtml", after, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["ShowSnippetTitle"] = step.NoticeTitle.Length == 0 })</aside> }
                @if (step.HasFollowUp && step.FollowUpQuestion.Length > 0) {
                    <aside class="action-guide-follow-up"><h3>@step.FollowUpQuestion</h3><p>@step.FollowUpNote</p>
                        @if (EmergencyContent.PublicUrl(followUp) is { } followUpUrl) { <a class="emergency-button" href="@followUpUrl">@step.FollowUpButton</a> }
                        else { <p>Hướng dẫn liên quan đang được cập nhật. <a href="/khan-cap/">Chọn việc cần làm ngay</a>.</p> }
                    </aside>
                }
                @if (actionable) { <label class="action-guide-check"><input type="checkbox" autocomplete="off" data-guide-check="@(step.Key != Guid.Empty ? step.Key.ToString("N") : $"step-{step.Number}")"><span>Đã làm xong việc này</span></label> }
                </div>
            </section>
        }
        </div>
        <div class="action-guide-tools"><span role="status" aria-live="polite" data-guide-status>Đánh dấu chỉ lưu trên máy của bạn, không gửi đi đâu.</span><button class="self-check-button" type="button" data-guide-reset>Xóa đánh dấu</button></div>
        <p class="self-check-result-notes">@site.Value("actionStepsNote")</p>
    }
    @if (screening.Length > 0)
    {
        <div class="self-check-guidance" data-emergency-screening>
        @foreach (var row in screening)
        {
            var target = EmergencyContent.DocumentKey(EmergencyContent.Text(row, "targetPage")) is { } key ? Umbraco.Content(key) : null;
            var url = EmergencyContent.PublicUrl(target);
            <section><h2>@EmergencyContent.Text(row, "question")</h2><p>@EmergencyContent.Text(row, "note")</p>
                @if (url is not null) { <a class="emergency-button" href="@url">@EmergencyContent.Text(row, "buttonText")</a> }
                else { <span class="emergency-pending">Sắp có</span> }
            </section>
        }
        </div>
    }
    @if (steps.Length == 0 && screening.Length == 0) { <p class="self-check-empty">Hướng dẫn đang được cập nhật. <a href="/khan-cap/">Chọn việc cần làm ngay</a>.</p> }
    @if (hasReview && review is { } reviewDate) { <p class="action-guide-review">Rà soát gần nhất: <time datetime="@reviewDate.ToString("yyyy-MM-dd")">@reviewDate.ToString("dd/MM/yyyy")</time> · Nguồn: @await Html.PartialAsync("~/Views/Partials/_ContentSourceLinks.cshtml", (Model, verification))</p>@if (reviewDate.Date < DateTime.UtcNow.Date.AddDays(-90)) { <aside class="action-guide-warning">Nội dung đã quá 90 ngày chưa rà soát. Hãy kiểm chứng lại thông tin tại nguồn chính thức trước khi dùng.</aside> } }
    else { <p class="action-guide-warning">Chưa có đầy đủ thông tin nguồn và ngày rà soát.</p> }
    <p class="emergency-note">@site.Value("notOnDutyNote")</p><p class="emergency-note">@site.Value("noReportNote")</p>
</article>
@section Scripts { <script type="module" src="~/assets/js/action-guide.js" asp-append-version="true"></script> }
