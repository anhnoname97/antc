@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var contestStyle = Model.ContentType.Alias == "thiPage";
    var site = Model.Root();
    var siteName = site?.Value<string>("siteName") ?? "antoantaichinh.vn";
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(Model.Value<string>("seoTitle") is { Length: > 0 } t ? t : Model.Name) — @siteName</title>
    <script>try { document.documentElement.dataset.fontScale = localStorage.getItem('at_font_scale') || '0' } catch (e) { }</script>
    <link rel="icon" href="/favicon.ico">
    <link rel="stylesheet" href="~/assets/css/fonts.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/tokens.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/header.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/footer.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(contestStyle ? "contest-site" : null)">
    <a class="site-skip" href="#noi-dung">Bỏ qua, tới nội dung chính</a>
    @if (contestStyle)
    {
        @await Html.PartialAsync("~/Views/Partials/_ContestHeader.cshtml", Model)
    }
    else
    {
        @await Html.PartialAsync("~/Views/Partials/_SiteHeader.cshtml", Model)
    }

    <main id="noi-dung" tabindex="-1">
        @RenderBody()
    </main>

    @await Html.PartialAsync("~/Views/Partials/_SiteFooter.cshtml", Model)

    <script type="module" src="~/assets/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
