@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@{
    var site = Model.Root();
    var siteName = site.Value<string>("siteName");
    if (string.IsNullOrWhiteSpace(siteName)) { siteName = "antoantaichinh.vn"; }
    var homeUrl = site.DescendantsOrSelfOfType("home").FirstOrDefault()?.Url() ?? "/";
    var logo = site.Value<IPublishedContent>("logoFooterImage");
    var logoAlt = site.Value<string>("footerLogoAlt");
    var tagline = site.Value<string>("footerTagline");
    var disclaimer = site.Value<string>("footerText");
    var menu = site.Value<BlockListModel>("footerMenu");
    var support = site.Value<BlockListModel>("footerSupport");
    var commitments = site.Value<BlockListModel>("footerCommitments");
    var operatorText = site.Value<string>("footerOperatorText");
    var path = Context.Request.Path.Value ?? "/";
    var sponsorLogo = site.Value<IPublishedContent>("sponsorLogo");
    var sponsorName = site.Value<string>("sponsorName");
    var hiddenPages = site.Value<IEnumerable<IPublishedContent>>("footerSponsorHiddenPages") ?? Enumerable.Empty<IPublishedContent>();
    // A configured section also covers its tool, FAQ or contest detail pages.
    var currentSectionKeys = Model.AncestorsOrSelf().Select(p => p.Key).ToHashSet();
    var hideSponsor = hiddenPages.Any(p => currentSectionKeys.Contains(p.Key));
    var showSponsor = site.Value<bool>("sponsorShow") && !hideSponsor && (sponsorLogo is not null || !string.IsNullOrWhiteSpace(sponsorName));
}
<footer class="site-footer" id="site-footer">
    <span class="sr-only" role="status" aria-live="polite" data-font-status></span>
    <div class="site-chrome-wrap site-footer__wrap">
        <div class="site-footer__top">
            <a class="site-footer__brand" href="@homeUrl" aria-label="@(siteName + ", trang chủ")">
                @if (logo is not null)
                {
                    <img src="@logo.Url()" height="44" loading="lazy" decoding="async" alt="@(string.IsNullOrWhiteSpace(logoAlt) ? siteName : logoAlt)">
                }
                else
                {
                    <span class="site-footer__mark">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-shield")</span>
                }
                <span class="site-footer__brand-text"><b>@siteName</b>@if (!string.IsNullOrWhiteSpace(tagline)) { <small>@tagline</small> }</span>
            </a>
            @if (!string.IsNullOrWhiteSpace(disclaimer))
            {
                <p class="site-footer__disclaimer">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-info")<span>@disclaimer</span></p>
            }
        </div>
        <div class="site-footer__columns">
            @if (menu?.Any() == true)
            {
                <div class="site-footer__column">
                    <h2 id="footer-info-title">@(site.Value<string>("footerMenuTitle"))</h2>
                    <nav class="site-footer__links" aria-labelledby="footer-info-title">
                        @await Html.PartialAsync("~/Views/Partials/_SharedLinks.cshtml", (menu.AsEnumerable(), path, (string?)null, false))
                    </nav>
                </div>
            }
            @if (support?.Any() == true)
            {
                <div class="site-footer__column">
                    <h2 id="footer-support-title">@(site.Value<string>("footerSupportTitle"))</h2>
                    <nav class="site-footer__links" aria-labelledby="footer-support-title">
                        @await Html.PartialAsync("~/Views/Partials/_SharedLinks.cshtml", (support.AsEnumerable(), path, (string?)null, false))
                        @{
                            var hasContestLink = support.Any(i => (i.Content.Value<string>("label") ?? "").Contains("Cuộc thi"));
                            if (!hasContestLink)
                            {
                                var contestPage = site.DescendantsOrSelfOfType("thiThangPage").FirstOrDefault();
                                var contestUrl = contestPage?.Url() ?? "/cuoc-thi/";
                                var isContestCurrent = path.TrimEnd('/').Equals(contestUrl.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)
                                    || path.StartsWith("/cuoc-thi", StringComparison.OrdinalIgnoreCase);
                                <a href="@contestUrl" aria-current="@(isContestCurrent ? "page" : null)">Cuộc thi tìm hiểu</a>
                            }
                        }
                    </nav>
                </div>
            }
            @if (commitments?.Any() == true)
            {
                <div class="site-footer__commitments">
                    <h2>@(site.Value<string>("footerCommitmentsTitle"))</h2>
                    <ul>
                        @foreach (var commitment in commitments)
                        {
                            var text = commitment.Content.Value<string>("text");
                            if (string.IsNullOrWhiteSpace(text)) { continue; }
                            <li>@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", commitment.Content.Value<string>("icon") ?? "")<span>@text</span></li>
                        }
                    </ul>
                </div>
            }
        </div>
        <div class="site-footer__bottom @(showSponsor ? "site-footer__bottom--sponsor" : null)">
            @if (!string.IsNullOrWhiteSpace(operatorText)) { <p class="site-footer__operator">@operatorText</p> }
            @if (showSponsor)
            {
                <div class="site-footer__sponsor" data-footer-sponsor>
                    <small>@(site.Value<string>("footerSponsorHeading"))</small>
                    @if (sponsorLogo is not null)
                    {
                        <img src="@sponsorLogo.Url()" width="88" height="44" loading="lazy" decoding="async" alt="@sponsorName">
                    }
                    @if (!string.IsNullOrWhiteSpace(sponsorName)) { <b>@sponsorName</b> }
                    <p>@(site.Value<string>("footerSponsorDisclaimer"))</p>
                </div>
            }
        </div>
    </div>
</footer>
