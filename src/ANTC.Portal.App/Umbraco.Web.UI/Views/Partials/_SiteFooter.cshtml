@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@{
    var site = Model.Root();
    var siteName = site.Value<string>("siteName");
    if (string.IsNullOrWhiteSpace(siteName)) { siteName = "antoantaichinh.vn"; }
    var homeUrl = site.DescendantsOrSelfOfType("home").FirstOrDefault()?.Url() ?? "/";
    var path = Context.Request.Path.Value ?? "/";
    var logo = site.Value<IPublishedContent>("logoFooterImage");
    var logoAlt = site.Value<string>("footerLogoAlt");
    var footerText = site.Value<string>("footerText");
    var operatorName = site.Value<string>("operatorName");
    var operatorAddress = site.Value<string>("operatorAddress");
    var operatorDetails = string.Join(" · ", new[] {
        string.IsNullOrWhiteSpace(operatorName) ? null : $"Đơn vị vận hành: {operatorName}",
        operatorAddress
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
    var menu = site.Value<BlockListModel>("footerMenu");
    var policies = site.Value<BlockListModel>("footerPolicies");
    var menuTitle = site.Value<string>("footerMenuTitle");
    var policiesTitle = site.Value<string>("footerPoliciesTitle");
    var policiesNote = site.Value<string>("footerPoliciesNote");
    var sponsorLogo = site.Value<IPublishedContent>("sponsorLogo");
    var sponsorName = site.Value<string>("sponsorName");
    var sponsorHeading = site.Value<string>("footerSponsorHeading");
    var sponsorDisclaimer = site.Value<string>("footerSponsorDisclaimer");
    var showSponsor = site.Value<bool>("sponsorShow") && (sponsorLogo is not null || !string.IsNullOrWhiteSpace(sponsorName));
    var copyright = site.Value<string>("copyright");
    var emergency = site.Value<BlockListModel>("emergencyNumbers")?
        .FirstOrDefault(item => item.Content.Value<string>("number")?.Trim() == "113" && item.Content.Value<bool>("enableCall"))?.Content;
}
<footer class="site-footer" id="site-footer">
    <span class="sr-only" role="status" aria-live="polite" data-font-status></span>
    <div class="site-footer__wrap site-footer__grid">
        <div class="site-footer__about">
            <a class="site-footer__brand" href="@homeUrl" aria-label="@(siteName + ", trang giới thiệu")">
                @if (logo is not null)
                {
                    <img src="@logo.Url()" height="48" loading="lazy" decoding="async" alt="@(string.IsNullOrWhiteSpace(logoAlt) ? siteName : logoAlt)">
                }
                else
                {
                    <span>@siteName</span>
                }
            </a>
            @if (!string.IsNullOrWhiteSpace(footerText))
            {
                <p>@footerText</p>
            }
            @if (!string.IsNullOrWhiteSpace(operatorDetails))
            {
                <p>@operatorDetails</p>
            }
        </div>
        @if (menu?.Any() == true)
        {
            <nav class="site-footer__column" aria-label="Điều hướng chân trang">
                @if (!string.IsNullOrWhiteSpace(menuTitle))
                {
                    <h2>@menuTitle</h2>
                }
                <div class="site-footer__links">
                    @await Html.PartialAsync("~/Views/Partials/_SharedLinks.cshtml", (menu.AsEnumerable(), path, (string?)null, false))
                </div>
            </nav>
        }
        @if (policies?.Any() == true || !string.IsNullOrWhiteSpace(policiesNote))
        {
            <div class="site-footer__column">
                @if (!string.IsNullOrWhiteSpace(policiesTitle))
                {
                    <h2>@policiesTitle</h2>
                }
                @if (policies?.Any() == true)
                {
                    <nav class="site-footer__links" aria-label="Quy định và chính sách">
                        @await Html.PartialAsync("~/Views/Partials/_SharedLinks.cshtml", (policies.AsEnumerable(), path, (string?)null, false))
                    </nav>
                }
                @if (!string.IsNullOrWhiteSpace(policiesNote))
                {
                    <p class="site-footer__note">@policiesNote</p>
                }
            </div>
        }
    </div>
    @if (showSponsor)
    {
        <div class="site-footer__wrap site-footer__sponsor">
            @if (!string.IsNullOrWhiteSpace(sponsorHeading))
            {
                <span class="site-footer__sponsor-heading">@sponsorHeading</span>
            }
            @if (sponsorLogo is not null)
            {
                <img src="@sponsorLogo.Url()" width="88" height="44" loading="lazy" decoding="async" alt="@(sponsorName ?? sponsorHeading)">
            }
            @if (!string.IsNullOrWhiteSpace(sponsorName))
            {
                <b>@sponsorName</b>
            }
            @if (!string.IsNullOrWhiteSpace(sponsorDisclaimer))
            {
                <p>@sponsorDisclaimer</p>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(copyright))
    {
        <div class="site-footer__wrap site-footer__bottom">
            @if (!string.IsNullOrWhiteSpace(copyright))
            {
                <p>@copyright</p>
            }
        </div>
    }
</footer>
@if (emergency is not null)
{
    <a class="site-emergency-call" href="tel:@(emergency.Value<string>("number")!.Trim())" aria-label="Gọi 113 khi có nguy hiểm tức thời">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
        <span>@(emergency.Value<string>("number")!.Trim())</span>
    </a>
}
