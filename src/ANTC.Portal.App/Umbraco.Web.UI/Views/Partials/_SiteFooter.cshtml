@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inject Umbraco.Plugin.Custom.Core.Contest.IContestCatalog Contests
@{
    var site = Model.Root();
    var siteName = site.Value<string>("siteName");
    if (string.IsNullOrWhiteSpace(siteName)) { siteName = "antoantaichinh.vn"; }
    var disclaimer = site.Value<string>("footerText");
    var menu = site.Value<BlockListModel>("footerMenu");
    var support = site.Value<BlockListModel>("footerSupport");
    var commitments = site.Value<BlockListModel>("footerCommitments");
    var library = site.Value<IPublishedContent>("footerLibraryPage");
    var libraryUrl = EmergencyContent.PublicUrl(library);
    var aiNote = site.Value<string>("footerAiNote");
    var path = Context.Request.Path.Value ?? "/";
    var sponsorLogo = site.Value<IPublishedContent>("sponsorLogo");
    var sponsorName = site.Value<string>("sponsorName");
    var hiddenPages = site.Value<IEnumerable<IPublishedContent>>("footerSponsorHiddenPages") ?? Enumerable.Empty<IPublishedContent>();
    // A configured section also covers its tool, FAQ or contest detail pages.
    var currentSectionKeys = Model.AncestorsOrSelf().Select(p => p.Key).ToHashSet();
    var hideSponsor = hiddenPages.Any(p => currentSectionKeys.Contains(p.Key)
        || (p.Url().TrimEnd('/') is { Length: > 0 } prefix && prefix.StartsWith('/')
            && path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase)));
    var showSponsor = site.Value<bool>("sponsorShow") && !hideSponsor && (sponsorLogo is not null || !string.IsNullOrWhiteSpace(sponsorName));
}
<footer class="site-footer" id="site-footer">
    <span class="sr-only" role="status" aria-live="polite" data-font-status></span>
    <div class="site-chrome-wrap site-footer__wrap">
        <div class="site-footer__main">
            <div class="site-footer__information">
                @if (!string.IsNullOrWhiteSpace(disclaimer)) { <p class="site-footer__scope">@disclaimer</p> }
                @if (menu?.Any() == true) {
                    <nav class="site-footer__links site-footer__links--information" aria-label="Thông tin website">
                        @await Html.PartialAsync("~/Views/Partials/_SharedLinks.cshtml", (menu.AsEnumerable(), path, (string?)null, false), new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["RequirePublicPage"] = true })
                    </nav>
                }
                <nav class="site-footer__links site-footer__links--support" aria-label="Hỗ trợ và kiến thức">
                    @if (libraryUrl is not null) { <a href="@libraryUrl">KIẾN THỨC NỀN TẢNG</a> }
                    @if (support?.Any() == true) {
                        @await Html.PartialAsync("~/Views/Partials/_SharedLinks.cshtml", (support.AsEnumerable(), path, (string?)null, false), new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["RequirePublicPage"] = true })
                    }
                    @* Chi hien link cuoc thi khi co cuoc thi dang dien ra *@
                    @if (support?.Any(i => (i.Content.Value<string>("label") ?? "").Contains("Cuộc thi")) != true
                        && await Contests.GetCurrentAsync(Context.RequestAborted) is not null) {
                        var contest = site.DescendantsOrSelfOfType("thiThangPage").FirstOrDefault();
                        if (EmergencyContent.PublicUrl(contest) is { } contestUrl) { <a href="@contestUrl">Cuộc thi tìm hiểu</a> }
                    }
                </nav>
                @if (!string.IsNullOrWhiteSpace(aiNote)) { <p class="site-footer__ai">@aiNote</p> }
            </div>
            @if (commitments?.Any() == true) {
                <div class="site-footer__commitments"><h2>@site.Value("footerCommitmentsTitle")</h2><ul>
                    @foreach (var commitment in commitments) {
                        var text = commitment.Content.Value<string>("text");
                        if (!string.IsNullOrWhiteSpace(text)) { <li>@text</li> }
                    }
                </ul></div>
            }
        </div>
        @if (showSponsor) {
        <div class="site-footer__bottom site-footer__bottom--sponsor">

            @if (showSponsor)
            {
                <div class="site-footer__sponsor" data-footer-sponsor>
                    <small>@(site.Value<string>("footerSponsorHeading"))</small>
                    @if (sponsorLogo is not null)
                    {
                        <img src="@sponsorLogo.Url()" width="88" height="44" loading="lazy" decoding="async" alt="@sponsorName">
                    }
                    @if (!string.IsNullOrWhiteSpace(sponsorName)) { <b>@sponsorName</b> }
                    <p>@(site.Value<string>("footerSponsorDisclaimer"))</p>
                </div>
            }
        </div>
        }
    </div>
</footer>
