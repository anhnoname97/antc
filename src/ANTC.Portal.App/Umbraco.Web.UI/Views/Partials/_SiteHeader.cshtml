@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Plugin.Custom.Core.Contest
@inject ContestPromotionService Promotions
@{
    var site = Model.Root();
    var siteName = site.Value<string>("siteName");
    if (string.IsNullOrWhiteSpace(siteName)) { siteName = "antoantaichinh.vn"; }
    var homeUrl = site.DescendantsOrSelfOfType("home").FirstOrDefault()?.Url() ?? "/";
    var logo = site.Value<IPublishedContent>("logoHeaderImage");
    var logoAlt = site.Value<string>("headerLogoAlt");
    var tagline = site.Value<string>("headerTagline");
    var mobileTagline = site.Value<string>("headerMobileTagline");
    if (string.IsNullOrWhiteSpace(mobileTagline)) { mobileTagline = tagline; }
    var menu = site.Value<BlockListModel>("menu");
    var showFont = site.Value<bool>("showFontSizeControl");
    var mobileNavigation = site.Value<bool>("showMobileNavigation");
    var fontLabel = site.Value<string>("fontSizeControlLabel");
    if (string.IsNullOrWhiteSpace(fontLabel)) { fontLabel = "Chữ lớn"; }
    var contest = Model.ContentType.Alias != "ungPhoPage" ? await Promotions.GetAsync(Context.RequestAborted) : null;
}
@if (contest is not null || showFont)
{
    <div class="site-utility">
        <div class="site-chrome-wrap site-utility__inner">
            @if (contest is not null)
            {
                @await Html.PartialAsync("~/Views/Partials/_ContestAnnouncement.cshtml", Model, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["InlineAnnouncement"] = true, ["PromotedContest"] = contest })
            }
            @if (showFont)
            {
                <button type="button" class="site-font-toggle" data-font-toggle data-font-label="@fontLabel" aria-pressed="false"><b aria-hidden="true">A+</b><span>@fontLabel</span></button>
            }
        </div>
    </div>
}
<header class="site-header @(!mobileNavigation ? "site-header--inline-mobile" : null)" id="site-header" data-site-header>
    <div class="site-chrome-wrap site-header__inner">
        <a class="site-brand" href="@homeUrl" aria-label="@(siteName + ", trang chủ")">
            @if (logo is not null)
            {
                <img class="site-brand__logo" src="@logo.Url()" height="38" alt="@(string.IsNullOrWhiteSpace(logoAlt) ? siteName : logoAlt)">
            }
            else
            {
                <span class="site-brand__mark">@await Html.PartialAsync("~/Views/Partials/_SiteIcon.cshtml", "icon-shield")</span>
            }
            <span class="site-brand__text"><b>@siteName</b>@if (!string.IsNullOrWhiteSpace(tagline)) { <small class="site-brand__tagline--desktop">@tagline</small><small class="site-brand__tagline--mobile">@mobileTagline</small> }</span>
        </a>
        <nav class="site-header__nav" aria-label="Danh mục chính">
            @await Html.PartialAsync("~/Views/Partials/_SiteNavigation.cshtml", (menu?.AsEnumerable(), (IPublishedContent)Model, false))
        </nav>
    </div>
</header>
