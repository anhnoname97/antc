@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var c = Model.Content;
    string T(string alias) => c.Value<string>(alias) ?? string.Empty;
    var rawTitle = T("title");
    var titleAccent = T("titleAccent");

    // Nếu chưa cấu hình tiêu đề, mặc định dùng "Gửi câu hỏi, kiến nghị riêng" theo chuẩn antoantaichinh_v2.html
    var fullTitle = !string.IsNullOrWhiteSpace(rawTitle)
        ? (rawTitle + (!string.IsNullOrWhiteSpace(titleAccent) ? " " + titleAccent : "")).Trim()
        : "Gửi câu hỏi, kiến nghị riêng";

    var s1Title = !string.IsNullOrWhiteSpace(T("step1Title")) ? T("step1Title") : "Bạn gửi kín";
    var s1Desc = !string.IsNullOrWhiteSpace(T("step1Description")) ? T("step1Description") : "Câu hỏi, kiến nghị không hiện lên trang.";
    var s2Title = !string.IsNullOrWhiteSpace(T("step2Title")) ? T("step2Title") : "Ban biên tập gộp";
    var s2Desc = !string.IsNullOrWhiteSpace(T("step2Description")) ? T("step2Description") : "Các câu giống nhau được gộp làm một.";
    var s3Title = !string.IsNullOrWhiteSpace(T("step3Title")) ? T("step3Title") : "Trả lời công khai";
    var s3Desc = !string.IsNullOrWhiteSpace(T("step3Description")) ? T("step3Description") : "Người biên tập duyệt từng câu trước khi đăng, đã che mọi thông tin cá nhân.";
}

<section class="sec" id="gui-cau-hoi" aria-labelledby="h-ask">
    <h2 id="h-ask">@fullTitle</h2>
    <div class="flowwrap">
        <ol class="flow" aria-label="Cách mục Hỏi – Đáp làm việc">
            <li>
                <span class="spot" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
                    </svg>
                </span>
                <span>
                    <b>@s1Title</b>
                    @s1Desc
                </span>
            </li>
            <li>
                <span class="spot" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="8" r="3.2"/><path d="M3 19.5c.6-3.3 3-5 6-5s5.4 1.7 6 5"/><path d="M15.5 4.9a3.2 3.2 0 0 1 0 6.2M17.5 14.7c2 .6 3.2 2.3 3.5 4.8"/>
                    </svg>
                </span>
                <span>
                    <b>@s2Title</b>
                    @s2Desc
                </span>
            </li>
            <li>
                <span class="spot" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3.5 10v4a1 1 0 0 0 1 1H7l7 4.5V4.5L7 9H4.5a1 1 0 0 0-1 1z"/><path d="M17.5 9a4 4 0 0 1 0 6"/>
                    </svg>
                </span>
                <span>
                    <b>@s3Title</b>
                    @s3Desc
                </span>
            </li>
        </ol>
        <div class="flow-img">
            <picture>
                <source media="(max-width:767px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7">
                <img src="/assets/img/v2/img-22-hoi-dap-750.webp" srcset="/assets/img/v2/img-22-hoi-dap-480.webp 480w, /assets/img/v2/img-22-hoi-dap-750.webp 750w" sizes="340px" width="750" height="500" alt="Những phong thư kín được gộp vào một hộp, rồi thành một lời trả lời chung cho mọi người." loading="lazy" decoding="async">
            </picture>
        </div>
    </div>
</section>
