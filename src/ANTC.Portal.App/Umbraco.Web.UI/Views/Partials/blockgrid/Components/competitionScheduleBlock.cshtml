@using System.Globalization
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Plugin.Custom.Core.Contest
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@inject ContestScheduleService Schedules
@{
    var c = Model.Content;
    string T(string alias) => c.Value<string>(alias) ?? string.Empty;
    var schedule = await Schedules.GetAsync(Context.RequestAborted);
    var vietnam = TimeZoneInfo.FindSystemTimeZoneById("Asia/Ho_Chi_Minh");
    var titleId = $"schedule-{Model.ContentKey:N}";
    var currentIndex = schedule.ToList().FindLastIndex(x => x.State == "now");
    var pastCount = schedule.Count(x => x.State == "past");
    var progress = schedule.Count == 0 ? 0 : currentIndex >= 0
        ? (currentIndex + .5) / schedule.Count * 100 : (double)pastCount / schedule.Count * 100;
    var results = c.Value<Link>("resultsLink");
}
<section class="sec schedule-section" aria-labelledby="@titleId">
    <div class="wrap">
        <div class="sec-head" data-schedule-reveal>
            <div><p class="eyebrow">@T("eyebrow")</p><h2 id="@titleId">@T("title")<br><em>@T("titleAccent")</em></h2></div>
            <p>@T("description")</p>
        </div>
        @if (schedule.Count > 0)
        {
            <div class="sched" style="--schedule-count:@schedule.Count;--schedule-progress:@(progress.ToString("0.###", CultureInfo.InvariantCulture))%" data-schedule-progress="@progress.ToString("0.###", CultureInfo.InvariantCulture)">
                <span class="sched-line" aria-hidden="true"></span><span class="sched-fill" aria-hidden="true"></span>
                <ol class="sched-track">
                    @foreach (var item in schedule)
                    {
                        var start = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(item.StartAt, DateTimeKind.Utc), vietnam);
                        var topic = item.Name.StartsWith("Chuyên đề:", StringComparison.OrdinalIgnoreCase) ? item.Name["Chuyên đề:".Length..].Trim() : item.Name;
                        <li class="mo @item.State" aria-current="@(item.State == "now" ? "true" : null)">
                            <span class="d" aria-hidden="true">@start.ToString("MM")</span>
                            <span class="m">Tháng @start.ToString("M/yyyy")</span>
                            <b>@topic</b>
                            <span class="st">
                                @if (item.State == "past")
                                {
                                    @T("pastLabel")
                                    @if (results is not null) { <text> · </text><a href="@results.Url" target="@results.Target">@results.Name</a> }
                                }
                                else if (item.State == "now") { <span aria-hidden="true">● </span>@T("currentLabel") }
                                else { @T("upcomingLabel") }
                            </span>
                        </li>
                    }
                </ol>
            </div>
        }
        else { <p>@T("emptyMessage")</p> }
        @if (!string.IsNullOrWhiteSpace(T("note"))) { <p class="schedule-note" data-schedule-reveal>@T("note")</p> }
    </div>
</section>
