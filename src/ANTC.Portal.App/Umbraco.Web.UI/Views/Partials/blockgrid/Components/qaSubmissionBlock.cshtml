@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var c = Model.Content;
    string T(string alias) => c.Value<string>(alias) ?? string.Empty;

    // Lấy thông tin lưu ý "Trước khi gõ" (từ block qaGuidelinesBlock trên cùng trang nếu có, hoặc mặc định theo antoantaichinh_v2.html)
    var page = Umbraco.AssignedContentItem;
    var pageLayout = page?.Value<BlockGridModel>("layout");
    var guidelinesBlock = pageLayout?.FirstOrDefault(b => b.Content.ContentType.Alias == "qaGuidelinesBlock")?.Content;

    var warnTitle = guidelinesBlock?.Value<string>("title");
    if (string.IsNullOrWhiteSpace(warnTitle)) { warnTitle = "Trước khi gõ"; }

    var warn1 = guidelinesBlock?.Value<string>("warning1");
    if (string.IsNullOrWhiteSpace(warn1)) { warn1 = "Đừng viết mật khẩu, mã OTP, mã PIN, số thẻ hay số tài khoản."; }

    var warn2 = guidelinesBlock?.Value<string>("warning2");
    if (string.IsNullOrWhiteSpace(warn2)) { warn2 = "Đừng gửi họ tên, số điện thoại, ảnh giấy tờ của người khác."; }

    var warn3 = guidelinesBlock?.Value<string>("info");
    if (string.IsNullOrWhiteSpace(warn3)) { warn3 = "Website không nhận tệp đính kèm và ảnh chụp màn hình."; }

    var contentLabel = !string.IsNullOrWhiteSpace(T("contentLabel")) ? T("contentLabel") : "Câu hỏi hoặc kiến nghị của bạn";
    var placeholder = !string.IsNullOrWhiteSpace(T("placeholder")) ? T("placeholder") : "Ví dụ: Tôi được mời làm cộng tác viên, họ bảo nạp 300 nghìn để mở tài khoản. Có nên nạp không?";
    var replyLabel = !string.IsNullOrWhiteSpace(T("replyLabel")) ? T("replyLabel") : "Tôi muốn nhận trả lời riêng";
    var replyNote = !string.IsNullOrWhiteSpace(T("replyNote")) ? T("replyNote") : "(không bắt buộc)";
    var contactLabel = !string.IsNullOrWhiteSpace(T("contactLabel")) ? T("contactLabel") : "Thư điện tử hoặc số điện thoại để trả lời";
    var contactHint = !string.IsNullOrWhiteSpace(T("contactHint"))
        ? T("contactHint")
        : "Chỉ dùng để trả lời đúng câu hỏi này, xóa ngay sau khi đã gửi câu trả lời. Chúng tôi không chủ động liên hệ vì việc khác.";
    var consentLabel = !string.IsNullOrWhiteSpace(T("consentLabel"))
        ? T("consentLabel")
        : "Tôi đồng ý cho Ban biên tập đọc và xử lý câu hỏi này để trả lời.";
    var publishLabel = !string.IsNullOrWhiteSpace(T("publishLabel"))
        ? T("publishLabel")
        : "Không bắt buộc. Tôi đồng ý cho Ban biên tập che mọi thông tin nhận dạng, biên tập rồi đăng công khai câu hỏi cùng câu trả lời. Không đồng ý vẫn được trả lời riêng.";
    var buttonLabel = !string.IsNullOrWhiteSpace(T("buttonLabel")) ? T("buttonLabel") : "Gửi";
    var legal = !string.IsNullOrWhiteSpace(T("legal"))
        ? T("legal")
        : "Website này không phải là nơi tiếp nhận tố giác, tin báo về tội phạm. Nếu bạn cần trình báo, hãy liên hệ trực tiếp cơ quan Công an nơi bạn cư trú.";
    var successTitle = !string.IsNullOrWhiteSpace(T("successTitle")) ? T("successTitle") : "Đã nhận câu hỏi, kiến nghị của bạn";
    var successDescription = !string.IsNullOrWhiteSpace(T("successDescription"))
        ? T("successDescription")
        : "Nội dung bạn gửi không hiện lên trang. Ban biên tập cố gắng trả lời trong 72 giờ làm việc, có lúc lâu hơn.";
}

<form class="box form" data-form="ask" novalidate>
    @* Honeypot chống bot rác *@
    <div class="hp" aria-hidden="true">
        <label>Để trống ô này<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>

    @* Hộp lưu ý "Trước khi gõ" đặt ở đầu form đúng chuẩn antoantaichinh_v2.html (dòng 2639) *@
    <div class="warn">
        <b>@warnTitle</b>
        <ul>
            @if (!string.IsNullOrWhiteSpace(warn1)) { <li>@warn1</li> }
            @if (!string.IsNullOrWhiteSpace(warn2)) { <li>@warn2</li> }
            @if (!string.IsNullOrWhiteSpace(warn3)) { <li>@warn3</li> }
        </ul>
    </div>

    <div>
        <label class="lbl" for="qtext">@contentLabel</label>
        <textarea id="qtext" name="content" placeholder="@placeholder"></textarea>
    </div>

    <label class="check" for="qreply">
        <input type="checkbox" id="qreply" name="wantReply">
        <span>@replyLabel <span class="small">@replyNote</span></span>
    </label>

    <div id="qcontactwrap" hidden>
        <label class="lbl" for="qcontact">@contactLabel</label>
        <input type="text" id="qcontact" name="contact" autocomplete="off">
        <p class="small qa-hint">@contactHint</p>
    </div>

    <label class="check one" for="qok">
        <input type="checkbox" id="qok" name="consent">
        <span><b>Bắt buộc.</b> @consentLabel</span>
    </label>

    <label class="check" for="qpub">
        <input type="checkbox" id="qpub" name="publish">
        @if (publishLabel.StartsWith("Không bắt buộc.", StringComparison.OrdinalIgnoreCase))
        {
            <span><b>Không bắt buộc.</b>@publishLabel.Substring("Không bắt buộc.".Length)</span>
        }
        else
        {
            <span>@publishLabel</span>
        }
    </label>

    <p class="err" id="qerr" hidden></p>

    <div class="btnrow">
        <button type="submit" class="btn pri">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5h-9l-4.5 3.5v-3.5H5A1.5 1.5 0 0 1 3.5 15V6A1.5 1.5 0 0 1 5 4.5z"/>
            </svg>
            @buttonLabel
        </button>
    </div>

    <p class="small">@legal</p>
</form>

@* Trạng thái đã gửi thành công *@
<section class="sec qa-sent" id="qa-sent" hidden aria-labelledby="h-sent">
    <header class="pageh">
        <p class="eyebrow">Hỏi – Đáp</p>
        <div class="pageh-title">
            <span class="spot g" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 12.5 4.5 4.5L19 7.5"/>
                </svg>
            </span>
            <h2 id="h-sent" tabindex="-1">@successTitle</h2>
        </div>
        <p class="lead">@successDescription</p>
    </header>

    <div class="note r">
        <b>Đang có chuyện gấp? Đừng chờ câu trả lời.</b>
        <p>Nếu bạn đang bị giục chuyển tiền, vừa chuyển tiền, hoặc đang bị đe dọa, hãy làm ngay:</p>
        <div class="btnrow">
            <a href="/hay-tu-kiem-tra/huong-dan/co-nguoi-dang-de-doa-ep-buoc-ban/" class="btn red sm">Tôi đang bị đe dọa</a>
            <a href="/hay-tu-kiem-tra/huong-dan/ban-vua-chuyen-tien-hoac-giao-hang/" class="btn red sm">Tôi vừa chuyển tiền hoặc giao hàng</a>
            <a href="/hay-tu-kiem-tra/huong-dan/co-nguoi-dang-thuc-ban-lam-ngay/" class="btn red sm">Có người đang thúc tôi làm ngay</a>
        </div>
        <a href="/khan-cap/" class="more">
            Xem tất cả lựa chọn
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 5 7 7-7 7"/>
            </svg>
        </a>
    </div>

    <div class="note g">
        <b>Muốn trình báo?</b>
        <p>@legal Mang theo tin nhắn, biên lai và mọi bằng chứng đang có.</p>
    </div>

    <div class="btnrow">
        <button type="button" class="btn ghost" id="btn-back-qa">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 5 8 12l7 7"/>
            </svg>
            Về Hỏi – Đáp
        </button>
    </div>
</section>
