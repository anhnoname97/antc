@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using Umbraco.Plugin.Custom.Core.Contest
@inject ICurrentContestService CurrentContests
@using Umbraco.Cms.Core.Models
@{
    var content = Model.Content;
    var primary = content.Value<Link>("primaryLink");
    var next = content.Value<Link>("nextLink");
    var urgent = content.Value<Link>("urgentLink");
    var isContest = next is not null || urgent is not null;
    var monthly = Umbraco.AssignedContentItem?.ContentType.Alias == "thiThangPage";
    var contest = monthly ? await CurrentContests.GetAsync(Context.RequestAborted) : null;
    var topic = contest?.Name ?? string.Empty;
    if (topic.StartsWith("Chuyên đề:", StringComparison.OrdinalIgnoreCase))
    {
        topic = topic["Chuyên đề:".Length..].Trim();
    }
    bool Safe(Link? link) => !string.IsNullOrWhiteSpace(link?.Url)
        && ((link.Url.StartsWith('/') && !link.Url.StartsWith("//")) || link.Url.StartsWith('#')
            || (Uri.TryCreate(link.Url, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https" or "tel"));
}
@if (isContest)
{
    <section class="next" aria-label="Phần tiếp theo">
        @if (Umbraco.AssignedContentItem.ContentType.Alias == "thuDoanPage")
        {
            <div class="next-drum" aria-hidden="true"><img src="~/assets/images/trong-dong.svg" width="1000" height="1000" alt="" loading="lazy"></div>
        }
        else
        {
            <svg class="next-drum" data-drum viewBox="-500 -500 1000 1000" aria-hidden="true"></svg>
        }
        <div class="wrap next-in"><div><p class="eyebrow">@content.Value("eyebrow")</p>
            @if (Safe(next))
            {
                <a class="big" href="@next!.Url" target="@next.Target" rel="@(next.Target == "_blank" ? "noopener noreferrer" : null)">
                    @if (monthly && !string.IsNullOrWhiteSpace(topic))
                    {
                        <text>Thủ đoạn:</text><span class="monthly-next-topic">@topic <span aria-hidden="true">⟶</span></span>
                    }
                    else
                    {
                        @(next.Name?.TrimEnd().TrimEnd('⟶').TrimEnd()) <span aria-hidden="true">⟶</span>
                    }
                </a>
            }
            <p>@content.Value("description")</p></div><div class="next-cta">
            @if (Safe(urgent))
            {
                <a class="btn @(urgent!.Url.StartsWith("tel:", StringComparison.OrdinalIgnoreCase) ? "btn-red" : "btn-light")" href="@urgent.Url" target="@urgent.Target" rel="@(urgent.Target == "_blank" ? "noopener noreferrer" : null)">@urgent.Name</a>
            }
        </div></div>
    </section>
}
else
{
    var title = content.Value<string>("title");
    <div class="next emergency-section">
        <div class="next-drum" aria-hidden="true"><img src="~/assets/images/trong-dong.svg" width="1000" height="1000" alt="" loading="lazy"></div>
        <div class="next-in" data-emergency-reveal><div><p class="eyebrow">@content.Value("eyebrow")</p>
            @if (Safe(primary))
            {
                <a class="big" href="@primary!.Url" target="@primary.Target" rel="@(primary.Target == "_blank" ? "noopener noreferrer" : null)">@(string.IsNullOrWhiteSpace(title) ? primary.Name : title) <span aria-hidden="true">⟶</span></a>
            }
            <p>@content.Value("description")</p></div><div class="next-cta">@await Html.PartialAsync("~/Views/Partials/blockgrid/_EmergencyCall.cshtml", content)</div>
        </div>
    </div>
}
