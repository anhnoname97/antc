@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Plugin.Custom.Core.Contest
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@inject ContestPromotionService Promotions
@{
    var c = Model.Content;
    string T(string alias) => c.Value<string>(alias) ?? string.Empty;
    var contest = await Promotions.GetAsync(Context.RequestAborted);
    var topic = contest?.Name ?? "chuyên đề cuộc thi";
    if (topic.StartsWith("Chuyên đề:", StringComparison.OrdinalIgnoreCase))
    {
        topic = topic["Chuyên đề:".Length..].Trim();
    }
    string Description(int step) => T($"step{step}Description")
        .Replace("{maxAttempts}", contest?.MaxAttempts == 0 ? "không giới hạn" : contest?.MaxAttempts.ToString() ?? "theo thể lệ")
        .Replace("{topic}", topic)
        .Replace("{questionCount}", contest?.QuestionCount.ToString() ?? "Các")
        .Replace("{topicCount}", contest?.Topics.Count.ToString() ?? "các");
    var titleId = $"participation-{Model.ContentKey:N}";
}
<section class="sec participation" id="dang-ky" aria-labelledby="@titleId">
    <div class="wrap">
        <div class="sec-head" data-participation-reveal>
            <div>
                <p class="eyebrow">@T("eyebrow")</p>
                <h2 id="@titleId">@T("title")<br><em>@T("titleAccent")</em></h2>
            </div>
            <p>@T("description")</p>
        </div>
        <div class="how">
            @for (var step = 1; step <= 4; step++)
            {
                <div class="hw">
                    <h3>@T($"step{step}Title")</h3>
                    <p>@Description(step)</p>
                </div>
            }
        </div>
        <div class="participation-actions" data-participation-reveal>
            @if (contest is not null && !Promotions.IsUpcoming(contest) && c.Value<Link>("registrationLink") is { } registration)
            {
                <a class="btn btn-red" href="/cuoc-thi/lam-bai/?c=@contest.Id" target="@registration.Target">@registration.Name <span aria-hidden="true">⟶</span></a>
            }
        </div>
    </div>
</section>
