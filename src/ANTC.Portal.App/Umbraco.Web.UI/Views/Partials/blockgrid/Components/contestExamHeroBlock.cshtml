@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{ string T(string alias) => Model.Content.Value<string>(alias) ?? string.Empty; }
<section class="page-hero page-hero--contest page-hero--image" aria-labelledby="h-page">
    @Html.HeroImage(Umbraco.AssignedContentItem, 4)
    <div class="container">
        <nav class="crumb" aria-label="Vị trí"><a href="/">Trang chủ</a> / <a href="/cuoc-thi/">Cuộc thi</a> / Làm bài</nav>
        <p class="eyebrow eyebrow--on-brand">@T("eyebrow")</p>
        <p id="h-page" class="page-hero__title">@T("title")</p>
        <p>@T("description")</p>
    </div>
</section>

