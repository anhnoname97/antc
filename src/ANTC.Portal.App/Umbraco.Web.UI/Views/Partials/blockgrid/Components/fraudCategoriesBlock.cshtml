@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Plugin.Custom.Core.Contest
@inject ContestPromotionService Promotions
@{
    var c = Model.Content;
    var source = c.Value<IPublishedContent>("sourceRoot");
    var fields = source?.Children().Where(x => x.ContentType.Alias == "articleList" && x.Value<bool>("isField")).ToList();
    var contest = await Promotions.GetAsync(Context.RequestAborted);
    var index = 0;
}
<div class="sec"><div class="wrap">
    @await Html.PartialAsync("~/Views/Partials/blockgrid/_FraudHeading.cshtml", c)
    <div class="areas" data-fraud-categories data-rvx data-empty-text="@c.Value("emptyText")" data-privacy-message="@c.Value("privacyMessage")">
    @foreach (var field in fields ?? Enumerable.Empty<IPublishedContent>())
    {
        var active = contest is not null && (string.Equals(contest.FocusArea, field.UrlSegment, StringComparison.OrdinalIgnoreCase) || contest.Topics.Any(t => string.Equals(t.Title.Trim(), field.Name.Trim(), StringComparison.OrdinalIgnoreCase)));
        var count = field.Children().Count(x => x.ContentType.Alias == "article");
        <a class="area @(active ? "is-ct" : null)" href="@field.Url()" data-k="@field.Value("summary")">
            <span class="n">@((++index).ToString("00"))</span><b>@field.Name @if (active) { <span class="ctbadge">★ Cuộc thi tháng @TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(contest!.StartAt, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById("Asia/Ho_Chi_Minh")).ToString("MM/yyyy")</span> }</b><span class="c">@count bài viết</span><i aria-hidden="true">›</i>
        </a>
    }
    </div>
    @if (contest is not null)
    {
        var contestPage = Umbraco.AssignedContentItem.Root().DescendantsOrSelfOfType("thiThangPage").FirstOrDefault();
        @if (contestPage is not null) { <div class="ctstrip" data-rv><div><b>@contest.Name</b><p>@ContestPromotionService.ShortSafetyNotice</p></div><a class="btn btn-light" href="@contestPage.Url()">Xem cuộc thi ⟶</a></div> }
    }
    <p class="nores" data-fraud-results role="status" aria-live="polite"></p>
</div></div>
