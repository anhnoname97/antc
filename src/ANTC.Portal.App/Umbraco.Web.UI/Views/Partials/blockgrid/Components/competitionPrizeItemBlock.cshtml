@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var c = Model.Content;
    string T(string alias) => c.Value<string>(alias) ?? string.Empty;
    var medal = T("medal");
    var variant = medal == "2" ? "p2" : medal == "3" ? "p3" : string.Empty;
}
<div class="pz @variant" role="listitem">
    <span class="medal @(medal == "KK" ? "encouragement" : null)" aria-hidden="true">@medal</span>
    <span><b>@T("title")</b><span>@T("description")</span></span>
    <em>@T("quantity")</em>
</div>
