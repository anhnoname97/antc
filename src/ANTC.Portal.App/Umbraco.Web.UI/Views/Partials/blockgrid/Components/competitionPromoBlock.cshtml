@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using Umbraco.Cms.Core.Models
@using Umbraco.Plugin.Custom.Core.Contest
@inject ContestPromotionService Promotions
@{
    var content = Model.Content;
    var contest = await Promotions.GetAsync(Context.RequestAborted);
    var vietnam = TimeZoneInfo.FindSystemTimeZoneById("Asia/Ho_Chi_Minh");
    DateTime Local(DateTime value) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value, DateTimeKind.Utc), vietnam);
    var eyebrow = contest is null ? null : $"Cuộc thi tháng {Local(contest.StartAt):MM/yyyy}";
    var title = contest?.Name;
    var schedule = contest is null ? null : $"{Local(contest.StartAt):d/M/yyyy} – {Local(contest.EndAt):d/M/yyyy}";
    var summary = contest is null ? null : $"{contest.QuestionCount} câu hỏi · " + (contest.MaxAttempts == 0 ? "Không giới hạn lượt / số điện thoại" : $"Tối đa {contest.MaxAttempts} lượt / số điện thoại");
    var link = content.Value<Link>("link");
    var contestUrl = Umbraco.AssignedContentItem.Root().DescendantsOrSelfOfType("thiThangPage").FirstOrDefault()?.Url() ?? "/cuoc-thi/";
    var safetyNote = ContestPromotionService.ShortSafetyNotice;
    var metadata = string.Join(" · ", new[] { schedule, summary }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
@if (!string.IsNullOrWhiteSpace(title))
{
    <aside class="competition-promo" aria-labelledby="competition-promo-@Model.ContentKey">
        @if (!string.IsNullOrWhiteSpace(eyebrow))
        {
            <p class="competition-promo__eyebrow"><span aria-hidden="true"></span>@eyebrow</p>
        }
        <h2 id="competition-promo-@Model.ContentKey">@title</h2>
        @if (!string.IsNullOrWhiteSpace(metadata))
        {
            <p class="competition-promo__meta">@metadata</p>
        }
        <a class="intro-hero__button intro-hero__button--primary competition-promo__link" href="@contestUrl">@(string.IsNullOrWhiteSpace(link?.Name) ? "Xem cuộc thi" : link.Name) <span aria-hidden="true">⟶</span></a>
        @if (!string.IsNullOrWhiteSpace(safetyNote))
        {
            <p class="competition-promo__safety">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.8 19.5 5.6v6.1c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V5.6z"/></svg>
                <span>@safetyNote</span>
            </p>
        }
    </aside>
}
