@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Plugin.Custom.Core.Questions
@using Microsoft.AspNetCore.WebUtilities
@inject IPublishedQuestionService PublishedQuestions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var c = Model.Content;
    string T(string alias) => c.Value<string>(alias) ?? string.Empty;
    var id = $"qa-published-{Model.ContentKey:N}";
    var currentPage = int.TryParse(Context.Request.Query["qaPage"], out var requestedPage) && requestedPage > 0 ? requestedPage : 1;
    var result = await PublishedQuestions.ListAsync(new PublishedQuestionQuery(Page: currentPage, PageSize: 6), Context.RequestAborted);
    if (currentPage > result.TotalPages)
    {
        currentPage = result.TotalPages;
        result = await PublishedQuestions.ListAsync(new PublishedQuestionQuery(Page: currentPage, PageSize: 6), Context.RequestAborted);
    }
    string PageUrl(int number)
    {
        var query = Context.Request.Query.ToDictionary(x => x.Key, x => (string?)x.Value.ToString());
        query["qaPage"] = number.ToString();
        return QueryHelpers.AddQueryString(Context.Request.Path.ToString(), query) + "#da-tra-loi";
    }
}
<section class="sec" id="da-tra-loi" data-qa-published aria-labelledby="@id">
<div class="wrap">
<div class="sec-head" data-published-reveal><div><p class="eyebrow">@T("eyebrow")</p><h2 id="@id">@T("title")<br><em>@T("titleAccent")</em></h2></div><p>@T("description")</p></div>
@if (result.Items.Count > 0)
{
<div class="qa" data-published-list>
@for (var index = 0; index < result.Items.Count; index++)
{
    var question = result.Items[index];
<details open="@(index == 0)" data-question-id="@question.Id">
<summary><span class="t"><span class="tag">@T("tagLabel")</span><h3>@question.Question</h3></span><span class="pm" aria-hidden="true">+</span></summary>
<div class="ans"><p>@question.Answer</p>
@if (!string.IsNullOrWhiteSpace(question.GuidanceLabel) && QuestionGuidanceLink.IsSafe(question.GuidanceUrl))
{
<a href="@question.GuidanceUrl">@question.GuidanceLabel <span aria-hidden="true">⟶</span></a>
}
</div>
</details>
}
</div>
@if (result.TotalPages > 1)
{
<nav class="qa-pagination" aria-label="Xem thêm câu hỏi đã trả lời">
@if (currentPage > 1) { <a class="btn btn-line" href="@PageUrl(currentPage - 1)" rel="prev">← Trang trước</a> }
<span class="skip" data-qa-visible-count>Đang hiển thị @result.Items.Count / @result.Total câu hỏi</span>
@if (currentPage < result.TotalPages) { <a class="btn btn-line" data-qa-more href="@PageUrl(currentPage + 1)" rel="next">Xem thêm</a> }
</nav>
}
}
else
{
<p class="qa-empty" data-published-reveal>@T("emptyText")</p>
}
<p class="note" data-qa-more-status role="status" aria-live="polite"></p>
@if (!string.IsNullOrWhiteSpace(T("note"))) { <p class="note" data-published-reveal>@T("note")</p> }
</div>
</section>
