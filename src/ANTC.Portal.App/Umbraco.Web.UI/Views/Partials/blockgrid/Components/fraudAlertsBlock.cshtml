@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@{
    var c = Model.Content;
    var source = c.Value<IPublishedContent>("sourceRoot");
    var articles = source?.Children().Where(x => x.ContentType.Alias == "article").OrderByDescending(x => x.Value<DateTime?>("updatedDate") ?? x.UpdateDate).Take(6).ToList();
    var links = c.Value<IEnumerable<Link>>("readingLinks");
}
<div class="sec white"><div class="wrap">
    @await Html.PartialAsync("~/Views/Partials/blockgrid/_FraudHeading.cshtml", c)
    <div class="alerts" data-rvs>
    @foreach (var article in articles ?? Enumerable.Empty<IPublishedContent>())
    {
        var label = article.Value<string>("labelType") ?? "";
        var unverified = label.Contains("Cần kiểm chứng", StringComparison.OrdinalIgnoreCase);
        var agency = article.Value<string>("sourceAgency");
        var reviewed = article.Value<DateTime>("lastReviewedDate");
        var documentDate = article.Value<DateTime>("sourceDocDate");
        var updated = article.Value<DateTime?>("updatedDate") ?? article.UpdateDate;
        <article class="alert @(unverified ? "amber" : null)">
            @if (unverified) { <span class="tag amber">⚠ Cần kiểm chứng · Chưa có kết luận</span> }
            else if (label.Contains("cảnh báo", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(agency)) { <span class="tag">Dựa trên cảnh báo của @agency</span> }
            <h3><a href="@article.Url()">@article.Name</a></h3>
            <p class="meta">
                @if (!string.IsNullOrWhiteSpace(agency)) { <span>Nguồn: @agency · </span> }
                @if (!string.IsNullOrWhiteSpace(article.Value<string>("sourceDocNo"))) { <span>Văn bản số @article.Value("sourceDocNo") </span> }
                @if (documentDate != default) { <span>ngày @documentDate.ToString("dd/MM/yyyy") · </span> }
                Cập nhật: @updated.ToString("dd/MM/yyyy")
            </p>
            @if (reviewed != default && reviewed < DateTime.UtcNow.AddDays(-90)) { <p class="stale">Nội dung đang chờ rà soát lại. Lần rà soát gần nhất đã quá 90 ngày.</p> }
        </article>
    }
    </div>
    @if (articles?.Any() != true) { <p>@c.Value("emptyText")</p> }
    <div class="deep" data-rvs>
    @foreach (var link in links ?? Enumerable.Empty<Link>())
    {
        @if (link.Url?.StartsWith('/') == true && !link.Url.StartsWith("//")) { <a href="@link.Url"><b>@link.Name</b><span class="go">Đọc</span></a> }
    }
    </div>
</div></div>
