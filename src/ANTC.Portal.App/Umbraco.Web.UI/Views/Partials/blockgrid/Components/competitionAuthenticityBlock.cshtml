@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var titleId = $"authenticity-{Model.ContentKey:N}";
    var items = (Model.Content.Value<string>("items") ?? string.Empty)
        .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
<section class="safe" aria-labelledby="@titleId">
    <div class="wrap safe-in">
        <span class="safe-ic" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 19.5 5.6v6.1c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V5.6z"/><path d="m8.7 12 2.3 2.3 4.3-4.6"/></svg>
        </span>
        <div>
            <h2 id="@titleId">@Model.Content.Value("title")</h2>
            <ul>
                @foreach (var item in items) { <li>@item</li> }
            </ul>
        </div>
    </div>
</section>
