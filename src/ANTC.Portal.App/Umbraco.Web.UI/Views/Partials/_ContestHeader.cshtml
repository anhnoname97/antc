@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Plugin.Custom.Core.Contest
@inject ICurrentContestService CurrentContests
@{
    var site = Model.Root();
    var siteName = site.Value<string>("siteName") ?? "antoantaichinh.vn";
    var logo = site.Value<IPublishedContent>("logoHeaderImage");
    var menu = site.Value<BlockListModel>("menu");
    var cta = site.Value<BlockListModel>("headerCta");
    var path = Context.Request.Path.Value ?? "/";
    var contest = Model.ContentType.Alias == "thiPage" ? await CurrentContests.GetAsync(Context.RequestAborted) : null;
    var vietnam = TimeZoneInfo.FindSystemTimeZoneById("Asia/Ho_Chi_Minh");
    string DateLabel(DateTime value) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value, DateTimeKind.Utc), vietnam).ToString("dd/MM/yyyy");
}
<header class="contest-header" data-contest-header>
    @if (contest is not null)
    {
        <div class="contest-announcement" data-contest-banner role="region" aria-label="Cuộc thi đang diễn ra">
            <div class="contest-announcement-inner">
                <span class="contest-announcement-dot" aria-hidden="true"></span>
                <span><b>Cuộc thi đang diễn ra</b><span class="contest-announcement-details"> · @contest.Name · @DateLabel(contest.StartAt) – @DateLabel(contest.EndAt)</span></span>
                <a href="/cuoc-thi/lam-bai/?c=@contest.Id">Tham gia ⟶</a>
                <button type="button" class="contest-banner-close" data-contest-banner-close aria-label="Ẩn thông báo cuộc thi">×</button>
            </div>
        </div>
    }
    <div class="contest-header-inner">
        <button type="button" class="contest-menu-toggle" data-contest-menu aria-expanded="false" aria-controls="contest-nav" aria-label="Mở menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        <a class="contest-brand" href="/">
            @if (logo is not null)
            {
                <img src="@logo.Url()" height="40" alt="@(site.Value<string>("headerLogoAlt") ?? siteName)">
            }
            else
            {
                <span class="contest-brand-mark" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 19.5 5.6v6.1c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V5.6z"/><path d="m8.7 12 2.3 2.3 4.3-4.6"/></svg></span>
                <span><b>@siteName</b>
                @if (site.Value<bool>("showPreviewBanner")) { <small>BẢN DỰNG THỬ</small> }
                </span>
            }
        </a>
        <nav class="contest-nav" id="contest-nav" aria-label="Điều hướng chính">
            @await Html.PartialAsync("~/Views/Partials/_SharedLinks.cshtml", (menu?.AsEnumerable(), path, (string?)null, true))
        </nav>
        <div class="contest-tools">
            <button type="button" class="contest-font-toggle" data-font-toggle>A+ Chữ to</button>
            @await Html.PartialAsync("~/Views/Partials/_ContestCta.cshtml", cta?.AsEnumerable())
        </div>
    </div>
</header>

<a class="contest-fab" href="tel:113" aria-label="Gọi 113 khi có nguy hiểm tức thời"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>113</a>
