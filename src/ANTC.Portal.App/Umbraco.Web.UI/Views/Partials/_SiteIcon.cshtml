@if (UmbracoIconCatalog.Names.Contains(nativeIcon))
{
    var sprite = IconVersions.AddFileVersionToPath(Context.Request.PathBase, "/assets/icons/umbraco.svg");
    <svg class="site-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="@(sprite + "#" + nativeIcon)"></use></svg>
}
else
{
