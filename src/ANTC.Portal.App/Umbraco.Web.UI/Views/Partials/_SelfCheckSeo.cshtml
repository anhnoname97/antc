@model SelfCheckSeoData
<link rel="canonical" href="@Model.CanonicalUrl">
<meta property="og:type" content="@Model.Type">
<meta property="og:locale" content="vi_VN">
<meta property="og:title" content="@Model.Title">
<meta property="og:description" content="@Model.Description">
<meta property="og:site_name" content="@Model.SiteName">
<meta property="og:url" content="@Model.CanonicalUrl">
<meta name="twitter:card" content="@(Model.Image is null ? "summary" : "summary_large_image")">
<meta name="twitter:title" content="@Model.Title">
<meta name="twitter:description" content="@Model.Description">
@if (Model.Image is { } image)
{
    <meta property="og:image" content="@image.Url">
    <meta property="og:image:alt" content="@image.Alt">
    <meta name="twitter:image" content="@image.Url">
    <meta name="twitter:image:alt" content="@image.Alt">
    @if (image.Width is { } width) { <meta property="og:image:width" content="@width"> }
    @if (image.Height is { } height) { <meta property="og:image:height" content="@height"> }
}
@if (Model.Updated is { } updated)
{
    <meta property="og:updated_time" content="@updated.ToString("yyyy-MM-ddTHH:mm:ss")">
    @if (Model.Type == "article") { <meta property="article:modified_time" content="@updated.ToString("yyyy-MM-ddTHH:mm:ss")"> }
}
