@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ArticlePageModel>
@{
    var home = Model.Root().DescendantsOrSelfOfType("home").FirstOrDefault();
    var fraud = Model.Root().DescendantsOrSelfOfType("thuDoanPage").FirstOrDefault();
    var category = Model switch
    {
        ArticleDetailPageModel detail => detail.Article.Category,
        ArticleListPageModel list => list.Category,
        _ => null
    };
    var title = Model is ArticleDetailPageModel article ? article.Article.Title : category?.Title ?? Model.Name;
    var inFraud = category is not null && category.Role != "Chính sách";
}
<nav class="article-breadcrumbs" aria-label="Vị trí">
    <ol><li><a href="@(home?.Url() ?? "/")">Trang chủ</a></li>
        @if (inFraud && fraud is not null) { <li><a href="@fraud.Url()">Thủ đoạn</a></li> }
        @if (Model is ArticleDetailPageModel detailModel && category is not null)
        {
            <li>@if (detailModel.CategoryIsPublished) { <a href="@category.Url">@category.Title</a> } else { <span>@category.Title</span> }</li>
        }
        <li aria-current="page">@(Model is ArticleDetailPageModel ? "Bài viết" : title)</li>
    </ol>
</nav>
