@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var category = Model.ContentType.Alias == "articleList" ? Model : Model.Parent<IPublishedContent>();
    var fields = category?.Parent<IPublishedContent>()?.Children().Where(x => x.ContentType.Alias == "articleList" && x.Value<bool>("isField")).ToList();
    var emergency = Model.Root().DescendantsOrSelfOfType("ungPhoPage").FirstOrDefault();
}
<aside class="article-sidebar">
    @if (fields?.Any() == true)
    {
        <nav class="field-nav" aria-label="Các lĩnh vực thủ đoạn"><p class="article-side-label">Khám phá lĩnh vực</p>
        @foreach (var field in fields)
        {
            <a href="@field.Url()" class="@(field.Key == category?.Key ? "is-active" : null)" aria-current="@(field.Key == category?.Key ? "true" : null)"><span class="field-nav__icon">@await Html.PartialAsync("~/Views/Partials/articles/_FieldIcon.cshtml", field.Name)</span><span>@field.Name</span><span class="field-nav__arrow" aria-hidden="true">↗</span></a>
        }
        </nav>
    }
    @if (emergency is not null)
    {
        <div class="article-help"><span class="article-help__mark" aria-hidden="true">!</span><h2>Đang gặp chuyện<br>đáng ngờ?</h2><p>Dừng lại một nhịp.<br>Xem việc cần làm ngay.</p><a href="@emergency.Url()">Ứng phó khẩn cấp <span aria-hidden="true">↗</span></a></div>
    }
</aside>
