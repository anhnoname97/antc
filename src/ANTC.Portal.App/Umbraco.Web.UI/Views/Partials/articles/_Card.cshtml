@model ArticleCardModel
@{
    var article = Model.Article;
}
<article class="article-card" data-article-id="@article.Id">
    <div class="article-card__art" aria-hidden="true">
        <img class="article-card__image" data-card-image src="@article.Image?.Url" alt="" loading="lazy" width="400" height="300" hidden="@(article.Image is null)">
        <span class="article-card__orbit" data-card-placeholder hidden="@(article.Image is not null)"></span>
        <span class="article-card__field-icon" data-card-icon data-card-placeholder hidden="@(article.Image is not null)">@await Html.PartialAsync("~/Views/Partials/articles/_FieldIcon.cshtml", Model.Category?.Title ?? "")</span>
        <span class="article-card__art-label" data-card-art-label data-card-placeholder hidden="@(article.Image is not null)">@(Model.Category?.Role == "Chính sách" ? "VĂN BẢN CHÍNH SÁCH" : "NHẬN DIỆN THỦ ĐOẠN")</span>
    </div>
    <div class="article-card__copy">
        <p class="article-card__category" data-card-category hidden="@(!Model.ShowCategory)">@Model.Category?.Title</p>
        <div class="article-labels">@await Html.PartialAsync("~/Views/Partials/articles/_Status.cshtml", article)</div>
        <p class="article-meta"><span data-card-date-label hidden="@(article.UpdatedDate is null)">Cập nhật </span><time data-card-date datetime="@article.UpdatedDate?.ToString("yyyy-MM-dd")" hidden="@(article.UpdatedDate is null)">@article.UpdatedDate?.ToString("dd/MM/yyyy")</time><span data-card-date-empty hidden="@(article.UpdatedDate is not null)">Chưa cập nhật ngày</span></p>
        <h2><a data-card-link href="@article.Url">@article.Title</a></h2>
        <p class="article-card__summary" data-card-summary hidden="@(string.IsNullOrWhiteSpace(article.Summary))">@article.Summary</p>
    </div>
</article>
