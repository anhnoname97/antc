  <GenericProperties>
    <GenericProperty>
      <Key>714b6011-179d-4d16-9314-c3ad2fe3c1c5</Key>
      <Name>Số ngày nhắc rà soát bài viết</Name>
      <Alias>articleReviewAfterDays</Alias>
      <Definition>a347f345-d36b-4bc1-a247-d2b7992e327e</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>false</Mandatory>
      <Validation>^([1-9]|[1-9][0-9]{1,2}|[12][0-9]{3}|3[0-5][0-9]{2}|36[0-4][0-9]|3650)$</Validation>
      <Description><![CDATA[Số ngày tối đa kể từ lần rà soát gần nhất. Nhập số nguyên 1–3650; để trống dùng 90 ngày. Bài không có ngày rà soát sẽ không bị cảnh báo. Cần xuất bản cấu hình để API sử dụng.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="thôngTinChung">Thông tin chung</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Nhập số nguyên từ 1 đến 3650 hoặc để trống để dùng 90 ngày.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
