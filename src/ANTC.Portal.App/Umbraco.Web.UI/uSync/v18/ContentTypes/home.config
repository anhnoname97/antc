      <Definition>3e16f04d-bac1-58b9-8d8f-116fb65c7bc5</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>true</Mandatory>
      <Validation>^[1-3]$</Validation>
      <Description><![CDATA[Chọn từ 1–3. Chỉ lấy cảnh báo đã xuất bản, có ngày cập nhật trong 90 ngày. Không có bài phù hợp thì ẩn khối.]]></Description>
