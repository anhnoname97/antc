  <Info>
    <Name>Về website</Name>
    <Icon>icon-files</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>Trang Về website tại /ve-website/. Nội dung theo bản HTML mới. Bốn cam kết dùng chung với Cài đặt website &gt; Chân trang; địa chỉ lấy từ trang Xác minh đúng trang.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Trang+Portal+V2</Folder>
    <Compositions>
      <Composition Key="c21256cd-ac8b-5a10-a94e-f10ade1ff508">seoBase</Composition>
    </Compositions>
    <DefaultTemplate>VeWebsite</DefaultTemplate>
