      <Value><![CDATA[Chuyên đề 2]]></Value>
    </cardCaption>
    <doD>
      <Value><![CDATA[Đặt bút xuống hoặc thoát khỏi trang, chưa đưa gì cả.]]></Value>
    </doD>
    <doH>
      <Value><![CDATA[Xin bản đầy đủ mang về đọc.]]></Value>
    </doH>
