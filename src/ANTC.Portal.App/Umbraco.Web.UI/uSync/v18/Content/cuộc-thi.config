      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ho\u1EA1t \u0111\u1ED9ng"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Vi\u1EC7c l\u00E0m, l\u00E0m th\u00EAm"
        },
        {
          "alias": "lead",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ho\u1EA1t \u0111\u1ED9ng kh\u00F4ng th\u01B0\u1EDDng xuy\u00EAn c\u1EE7a Ch\u01B0\u01A1ng tr\u00ECnh. Kh\u00F4ng thu b\u1EA5t k\u1EF3 kho\u1EA3n ph\u00ED n\u00E0o."
        },
        {
          "alias": "image",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "b476e3d2-3c81-42df-a567-27b2e65c0101",
              "mediaKey": "e1a89c3e-8812-4eb5-8271-9c8e19bfa520",
              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "alias": "timeText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "01/11/2026 \u2013 20/11/2026"
        },
        {
          "alias": "eligibilityText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "M\u1ECDi l\u1EE9a tu\u1ED5i, ch\u1EC9 c\u1EA7n c\u00F3 s\u1ED1 \u0111i\u1EC7n tho\u1EA1i \u0111\u1EC3 li\u00EAn h\u1EC7. Kh\u00F4ng gi\u1EDBi h\u1EA1n l\u01B0\u1EE3t thi cho m\u1ED7i s\u1ED1 \u0111i\u1EC7n tho\u1EA1i."
        },
        {
          "alias": "formatText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u0103ng k\u00FD b\u1EB1ng h\u1ECD t\u00EAn v\u00E0 s\u1ED1 \u0111i\u1EC7n tho\u1EA1i, r\u1ED3i v\u00E0o thi ngay. 1 chuy\u00EAn \u0111\u1EC1, 19 c\u00E2u. L\u00E0m Chuy\u00EAn \u0111\u1EC1 1 tr\u01B0\u1EDBc. Kh\u00F4ng gi\u1EDBi h\u1EA1n l\u01B0\u1EE3t thi cho m\u1ED7i s\u1ED1 \u0111i\u1EC7n tho\u1EA1i."
        },
        {
          "alias": "prizeText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "1 gi\u1EA3i \u0111\u1EB7c bi\u1EC7t. Gi\u1EA3i th\u01B0\u1EDFng th\u1EF1c hi\u1EC7n ngh\u0129a v\u1EE5 thu\u1EBF thu nh\u1EADp c\u00E1 nh\u00E2n theo quy \u0111\u1ECBnh."
        },
        {
          "alias": "rulesText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Theo Th\u1EC3 l\u1EC7 \u0111\u00E3 ban h\u00E0nh c\u1EE7a Ban T\u1ED5 ch\u1EE9c."
        },
        {
          "alias": "rulesLink",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
