    <cardCaption>
      <Value><![CDATA[Chuyên đề 4]]></Value>
    </cardCaption>
    <doD>
      <Value><![CDATA[Cúp máy, nói với một người trong nhà.]]></Value>
    </doD>
    <doH>
      <Value><![CDATA[Đòi hồ sơ lưu được, tự cộng lại ba con số.]]></Value>
    </doH>
