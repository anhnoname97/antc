                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "B\u1EAFt n\u1ED9p th\u00EAm ph\u00ED \u0111\u1EC3 l\u1EA5y \u0111\u01B0\u1EE3c ti\u1EC1n ho\u1EB7c h\u00E0ng \u0111ang b\u1ECB gi\u1EEF: ph\u00ED r\u00FAt ti\u1EC1n, ph\u00ED m\u1EDF kh"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "B\u1EAFt \u003Cstrong\u003En\u1ED9p th\u00EAm ph\u00ED\u003C/strong\u003E \u0111\u1EC3 l\u1EA5y \u0111\u01B0\u1EE3c ti\u1EC1n ho\u1EB7c h\u00E0ng \u003Cstrong\u003E\u0111ang b\u1ECB gi\u1EEF\u003C/strong\u003E: ph\u00ED r\u00FAt ti\u1EC1n, ph\u00ED m\u1EDF kh\u00F3a, ti\u1EC1n x\u00E1c minh, ti\u1EC1n b\u1EA3o l\u00E3nh."
                    }
