    <doorLead>
      <Value><![CDATA[Chọn ô gần đúng nhất. Việc cần làm đi theo điều đã xảy ra, bạn không cần kể đúng câu chuyện.]]></Value>
    </doorLead>
    <doors>
      <Value><![CDATA[[
  {
    "key": "68d4c726-fce6-5bd0-94d6-59895d63db83",
    "title": "C\u00F3 ng\u01B0\u1EDDi \u0111ang \u0111e d\u1ECDa, \u00E9p bu\u1ED9c t\u00F4i",
    "description": "D\u1ECDa \u0111\u00F2i ti\u1EC1n, d\u1ECDa tung h\u00ECnh \u1EA3nh ho\u1EB7c th\u00F4ng tin, b\u1EAFt t\u00F4i im l\u1EB7ng.",
    "illustration": "threat",
    "openMode": "moTrang",
    "targetPage": "umb://document/68706bf34b275b5aa587ccccb499a810",
    "options": []
  },
  {
    "key": "ad5542bd-96b9-59fb-ac83-5be7ada1faed",
    "title": "Ti\u1EC1n, h\u00E0ng, \u0111i\u1EC7n tho\u1EA1i, t\u00E0i kho\u1EA3n ho\u1EB7c gi\u1EA5y t\u1EDD c\u1EE7a t\u00F4i \u0111\u00E3 c\u00F3 chuy\u1EC7n",
    "description": "\u0110\u00E3 \u0111\u01B0a \u0111i, \u0111\u00E3 m\u1EA5t, ho\u1EB7c b\u1ECB ng\u01B0\u1EDDi kh\u00E1c d\u00F9ng.",
    "illustration": "harm",
    "openMode": "moDanhSach",
    "optionsLead": "Ch\u1ECDn d\u00F2ng g\u1EA7n \u0111\u00FAng nh\u1EA5t v\u1EDBi \u0111i\u1EC1u b\u1EA1n nh\u00ECn th\u1EA5y. Kh\u00F4ng c\u1EA7n bi\u1EBFt v\u00EC sao n\u00F3 x\u1EA3y ra.",
    "options": [
      {
        "key": "1ca8c0e5-00e5-54a9-a7a8-12c669b11133",
        "icon": "money",
        "text": "T\u00F4i \u0111\u00E3 chuy\u1EC3n ti\u1EC1n, \u0111\u00E3 \u0111\u01B0a ti\u1EC1n, ho\u1EB7c t\u00F4i l\u00E0 ng\u01B0\u1EDDi b\u00E1n v\u00E0 \u0111\u00E3 giao h\u00E0ng \u0111i",
        "target": "umb://document/37ea5c835a975585a294d78e0c32a5f8"
      },
      {
        "key": "fa815bd0-3d0f-515a-bc86-fe87ae7eba53",
        "icon": "key",
        "text": "T\u00F4i \u0111\u00E3 \u0111\u1ECDc m\u00E3 OTP, \u0111\u01B0a m\u1EADt kh\u1EA9u, c\u00E0i \u1EE9ng d\u1EE5ng theo l\u1EDDi ng\u01B0\u1EDDi kh\u00E1c, ho\u1EB7c th\u1EA5y ng\u01B0\u1EDDi l\u1EA1 \u0111\u0103ng nh\u1EADp v\u00E0o t\u00E0i kho\u1EA3n c\u1EE7a t\u00F4i",
        "target": "umb://document/271372f509a1562da994344aac10d210"
      },
      {
        "key": "a5c8712b-36c4-53c2-9c2f-83d93e07072d",
        "icon": "sim",
        "text": "\u0110i\u1EC7n tho\u1EA1i ho\u1EB7c SIM c\u1EE7a t\u00F4i b\u1ECB m\u1EA5t, b\u1ECB chi\u1EBFm",
        "target": "umb://document/271372f509a1562da994344aac10d210"
      },
      {
        "key": "c9b8647c-efa6-5faf-8749-be585be3d789",
        "icon": "id",
        "text": "Gi\u1EA5y t\u1EDD, khu\u00F4n m\u1EB7t, ch\u1EEF k\u00FD ho\u1EB7c t\u00EAn t\u00F4i \u0111\u00E3 \u0111\u01B0\u1EE3c g\u1EEDi \u0111i, ho\u1EB7c b\u1ECB ng\u01B0\u1EDDi kh\u00E1c d\u00F9ng m\u00E0 t\u00F4i kh\u00F4ng h\u1EC1 l\u00E0m",
        "target": "umb://document/d59bdc96b741509ea95c2d0e56e31d5c"
      },
      {
        "key": "805d26a1-0dd1-5ce4-87b3-191d183e7f7f",
        "icon": "doc",
        "text": "T\u00F4i \u0111\u00E3 chuy\u1EC3n, g\u00F3p v\u1ED1n ho\u1EB7c \u0111\u1EB7t c\u1ECDc nh\u01B0ng kh\u00F4ng l\u1EA5y l\u1EA1i \u0111\u01B0\u1EE3c ti\u1EC1n, kh\u00F4ng l\u1EA5y \u0111\u01B0\u1EE3c h\u00E0ng, ho\u1EB7c h\u1EE3p \u0111\u1ED3ng \u0111\u00E3 k\u00FD ph\u00E1t sinh kho\u1EA3n ph\u1EA3i tr\u1EA3 t\u00F4i ch\u01B0a hi\u1EC3u",
        "target": "umb://document/6d7a117441475431a6d04f06f5067411"
      },
      {
        "key": "7a1e6036-c37f-5a8d-9e2b-a92bfcdada8c",
        "icon": "inbox",
        "text": "T\u1EF1 nhi\u00EAn c\u00F3 ti\u1EC1n l\u1EA1 chuy\u1EC3n v\u00E0o t\u00E0i kho\u1EA3n c\u1EE7a t\u00F4i",
        "target": "umb://document/e9b62b71e0595905ab79373ba41196ce"
      }
    ],
    "targetPage": ""
  },
  {
    "key": "dba168e6-600d-5a5c-9f51-7abb6027aac4",
    "title": "Ch\u01B0a c\u00F3 chuy\u1EC7n g\u00EC, nh\u01B0ng t\u00F4i \u0111ang \u0111\u01B0\u1EE3c y\u00EAu c\u1EA7u, \u0111\u01B0\u1EE3c m\u1EDDi, ho\u1EB7c s\u1EAFp l\u00E0m m\u1ED9t vi\u1EC7c",
    "description": "C\u00F2n k\u1ECBp. Ki\u1EC3m tra tr\u01B0\u1EDBc khi \u0111\u01B0a b\u1EA5t c\u1EE9 th\u1EE9 g\u00EC.",
    "illustration": "check",
    "openMode": "moDanhSach",
    "optionsLead": "C\u00F2n k\u1ECBp. Ch\u1ECDn d\u00F2ng g\u1EA7n \u0111\u00FAng nh\u1EA5t.",
    "options": [
      {
        "key": "f412163a-5884-56cc-9979-16762a5c94d7",
        "icon": "clock",
        "text": "C\u00F3 ng\u01B0\u1EDDi \u0111ang th\u00FAc t\u00F4i l\u00E0m ngay",
        "target": "umb://document/db66db609cd05c87ad508251494fcc60"
      },
      {
        "key": "45edcaf0-bc72-55cc-9569-51541df6ee69",
        "icon": "chart",
        "text": "C\u00F3 ng\u01B0\u1EDDi m\u1EDDi t\u00F4i g\u00F3p v\u1ED1n, \u0111\u1EA7u t\u01B0, l\u00E0m \u0103n, ho\u1EB7c m\u1EDDi vi\u1EC7c l\u00E0m",
        "target": "umb://document/859cf6531aee56c9a130e2176e1f7e77"
      },
      {
        "key": "162b7974-e5ff-5195-b4b5-c54bf07a4503",
        "icon": "search",
        "text": "Kh\u00F4ng ai th\u00FAc, kh\u00F4ng ai m\u1EDDi. T\u00F4i s\u1EAFp chuy\u1EC3n ti\u1EC1n, giao h\u00E0ng, \u0111\u01B0a th\u00F4ng tin ho\u1EB7c k\u00FD gi\u1EA5y, v\u00E0 mu\u1ED1n ki\u1EC3m tra tr\u01B0\u1EDBc",
        "target": "umb://document/5004d9d6d9055141a6237388e4066dfd"
      },
      {
        "key": "f57343bc-5409-515f-b6fa-f05f5a979435",
        "icon": "quiz",
        "text": "T\u00F4i nh\u1EADn \u0111\u01B0\u1EE3c cu\u1ED9c g\u1ECDi, tin nh\u1EAFn ho\u1EB7c l\u1EDDi m\u1EDDi \u0111\u00E1ng ng\u1EDD v\u00E0 mu\u1ED1n t\u1EF1 ki\u1EC3m tra",
        "target": "umb://document/202c54be43565c83a503f72ea6c47fb1"
      }
    ],
    "targetPage": ""
  }
]]]></Value>
