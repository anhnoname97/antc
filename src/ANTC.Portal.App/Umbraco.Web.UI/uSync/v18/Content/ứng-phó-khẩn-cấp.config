    },
    {
      "contentTypeKey": "a931fdd5-37a8-4037-825e-5c731141bb3d",
      "key": "5894450b-1709-5656-85ff-2b787c870b85",
      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u01B0\u1EDBc 1"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110i\u1EC1u g\u00EC \u0111ang x\u1EA3y ra\nv\u1EDBi b\u1EA1n?"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kh\u00F4ng c\u1EA7n k\u1EC3 chi ti\u1EBFt. Ch\u1EC9 c\u1EA7n ch\u1ECDn \u00F4 gi\u1ED1ng tr\u01B0\u1EDDng h\u1EE3p c\u1EE7a b\u1EA1n nh\u1EA5t."
        },
        {
          "alias": "helperText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110ang gi\u00FAp ng\u01B0\u1EDDi th\u00E2n, hay x\u1EED l\u00FD vi\u1EC7c c\u1EE7a c\u1EEDa h\u00E0ng? Ch\u1ECDn theo \u0111i\u1EC1u \u0111\u00E3 x\u1EA3y ra v\u1EDBi ng\u01B0\u1EDDi \u0111\u00F3."
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "5697d942-c948-4f4d-beae-151fdbec0bfe",
                "key": "c3c0dfcf-68ed-54a9-a4af-ec77539591e3",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "C\u00F3 ng\u01B0\u1EDDi \u0111ang \u0111e d\u1ECDa, \u00E9p bu\u1ED9c t\u00F4i"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "D\u1ECDa \u0111\u00F2i ti\u1EC1n, d\u1ECDa tung h\u00ECnh \u1EA3nh ho\u1EB7c th\u00F4ng tin, b\u1EAFt t\u00F4i im l\u1EB7ng."
                  },
                  {
                    "alias": "link",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "Xem vi\u1EC7c c\u1EA7n l\u00E0m",
                        "url": "#dau-hieu",
                        "udi": null,
                        "target": null
                      }
                    ]
                  }
                ]
              },
              {
                "contentTypeKey": "5697d942-c948-4f4d-beae-151fdbec0bfe",
                "key": "cd36119b-3675-5f5b-8168-160fe885931a",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Ti\u1EC1n, h\u00E0ng, \u0111i\u1EC7n tho\u1EA1i, t\u00E0i kho\u1EA3n ho\u1EB7c gi\u1EA5y t\u1EDD c\u1EE7a t\u00F4i \u0111\u00E3 c\u00F3 chuy\u1EC7n"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0110\u00E3 \u0111\u01B0a \u0111i, \u0111\u00E3 m\u1EA5t, ho\u1EB7c b\u1ECB ng\u01B0\u1EDDi kh\u00E1c d\u00F9ng."
                  },
                  {
                    "alias": "link",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "Xem vi\u1EC7c c\u1EA7n l\u00E0m",
                        "url": "#so-can-biet",
                        "udi": null,
                        "target": null
                      }
                    ]
                  }
                ]
              },
              {
                "contentTypeKey": "5697d942-c948-4f4d-beae-151fdbec0bfe",
                "key": "54675672-b51d-550f-9fb4-aaca0bc2eb5a",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Ch\u01B0a c\u00F3 chuy\u1EC7n g\u00EC, nh\u01B0ng t\u00F4i \u0111ang \u0111\u01B0\u1EE3c y\u00EAu c\u1EA7u, \u0111\u01B0\u1EE3c m\u1EDDi, ho\u1EB7c s\u1EAFp l\u00E0m m\u1ED9t vi\u1EC7c"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "C\u00F2n k\u1ECBp. Ki\u1EC3m tra tr\u01B0\u1EDBc khi \u0111\u01B0a b\u1EA5t c\u1EE9 th\u1EE9 g\u00EC."
