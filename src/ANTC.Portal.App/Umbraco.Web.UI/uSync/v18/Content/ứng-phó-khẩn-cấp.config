      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u1EF1 ki\u1EC3m tra"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u1EC9 c\u1EA7n 1 d\u1EA5u hi\u1EC7u:"
        },
        {
          "alias": "highlightTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "d\u1EEBng l\u1EA1i"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u1EF1 ki\u1EC3m tra"
        },
        {
          "alias": "idleTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u01B0a \u0111\u00E1nh d\u1EA5u d\u1EA5u hi\u1EC7u n\u00E0o"
        },
        {
          "alias": "idleText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u1EA1m v\u00E0o d\u00F2ng n\u00E0o gi\u1ED1ng \u0111i\u1EC1u b\u1EA1n \u0111ang g\u1EB7p."
        },
        {
          "alias": "hitTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "D\u1EEBng l\u1EA1i ngay. \u0110\u00E3 c\u00F3 {count} d\u1EA5u hi\u1EC7u."
        },
        {
          "alias": "hitText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u1EEBng chuy\u1EC3n ti\u1EC1n, \u0111\u1EEBng \u0111\u01B0a th\u00EAm th\u00F4ng tin. T\u1EF1 g\u1ECDi ng\u00E2n h\u00E0ng c\u1EE7a b\u1EA1n b\u1EB1ng s\u1ED1 in \u1EDF m\u1EB7t sau th\u1EBB."
        },
        {
          "alias": "sourceNote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "N\u0103m d\u00F2ng \u0111\u1EA7u theo \u201CN\u0103m vi\u1EC7c ph\u1EA3i ch\u1EB7n ngay\u201D c\u1EE7a B\u00E0i \u0111\u1ECDc Chuy\u00EAn \u0111\u1EC1 1. D\u00F2ng th\u1EE9 s\u00E1u l\u00E0 ph\u1EA7n website b\u1ED5 sung."
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "c95be742-cf71-4213-8a00-50ffe1444c51",
                "key": "2dab30d3-fdfa-503b-be7c-08fb27278529",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "B\u1EA3o b\u1EA1n \u0111\u1ECDc ho\u1EB7c g\u1EEDi m\u1EADt kh\u1EA9u, m\u00E3 OTP, m\u00E3 PIN, ho\u1EB7c cho ng\u01B0\u1EDDi kh\u00E1c nh\u00ECn, \u0111i\u1EC1u kh"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "B\u1EA3o b\u1EA1n \u003Cstrong\u003E\u0111\u1ECDc\u003C/strong\u003E ho\u1EB7c \u003Cstrong\u003Eg\u1EEDi\u003C/strong\u003E m\u1EADt kh\u1EA9u, m\u00E3 OTP, m\u00E3 PIN, ho\u1EB7c cho ng\u01B0\u1EDDi kh\u00E1c nh\u00ECn, \u0111i\u1EC1u khi\u1EC3n m\u00E0n h\u00ECnh."
                    }
                  },
                  {
                    "alias": "isExtra",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "0"
                  }
                ]
              },
              {
                "contentTypeKey": "c95be742-cf71-4213-8a00-50ffe1444c51",
                "key": "66f7cad6-b1b6-5b18-a4cf-047b72f28de8",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Ng\u01B0\u1EDDi kh\u00E1c g\u1EEDi \u0111\u01B0\u1EDDng link v\u00E0 b\u1EA3o b\u1EA1n c\u00E0i \u1EE9ng d\u1EE5ng."
                  },
                  {
