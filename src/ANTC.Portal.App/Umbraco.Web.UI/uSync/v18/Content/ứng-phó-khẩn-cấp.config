                "key": "89684c08-f3f5-5e6f-8c3c-3b38dcb2a2f2",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Ng\u01B0\u1EDDi kh\u00E1c b\u1EA3o b\u1EA1n qu\u00E9t khu\u00F4n m\u1EB7t ho\u1EB7c g\u1EEDi \u1EA3nh gi\u1EA5y t\u1EDD.\u2713 B\u1EA1n t\u1EF1 m\u1EDF \u1EE9ng d\u1EE5ng c\u1EE7a "
