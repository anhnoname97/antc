      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ph\u1EA7n 2 / 5 \u00B7 Kh\u1EA9n c\u1EA5p"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u1EE8ng ph\u00F3 t\u00ECnh hu\u1ED1ng"
        },
        {
          "alias": "highlightTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "kh\u1EA9n c\u1EA5p"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u1ECDn \u00F4 g\u1EA7n \u0111\u00FAng nh\u1EA5t. Vi\u1EC7c c\u1EA7n l\u00E0m \u0111i theo \u0111i\u1EC1u \u0111\u00E3 x\u1EA3y ra, b\u1EA1n kh\u00F4ng c\u1EA7n k\u1EC3 \u0111\u00FAng c\u00E2u chuy\u1EC7n."
        },
        {
          "alias": "emergencyLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Nguy hi\u1EC3m t\u1EE9c th\u1EDDi: g\u1ECDi {number}"
        },
        {
          "alias": "breadcrumbLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ph\u1EA7n 2"
        },
