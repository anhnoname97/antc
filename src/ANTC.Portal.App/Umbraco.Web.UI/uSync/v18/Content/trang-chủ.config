                  {
                    "alias": "eyebrow",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Ch\u01B0\u01A1ng 1 / 4 \u00B7 21:47"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "M\u1ED9t tin nh\u1EAFn \u0111\u1EBFn."
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Ng\u01B0\u1EDDi g\u1EEDi x\u01B0ng l\u00E0 nh\u00E2n vi\u00EAn ng\u00E2n h\u00E0ng, nh\u1EDD b\u1EA1n \u0111\u1ECDc m\u00E3 OTP \u201C\u0111\u1EC3 kh\u00F3a t\u00E0i kho\u1EA3n \u0111ang b\u1ECB x\u00E2m nh\u1EADp\u201D. H\u00E3y nh\u00ECn nh\u1EEFng ch\u1EEF \u0111\u01B0\u1EE3c t\u00F4 \u0111\u1ECF: \u0111\u00F3 l\u00E0 d\u1EA5u hi\u1EC7u l\u1EEBa \u0111\u1EA3o."
                  },
                  {
                    "alias": "visualType",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "message"
                    ]
                  },
                  {
                    "alias": "senderName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "S\u1ED1 l\u1EA1"
                  },
                  {
                    "alias": "senderDisplay",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u002B84 9\u2022\u2022 \u2022\u2022\u2022 \u2022\u2022\u2022"
                  },
                  {
                    "alias": "messageContent",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "\u003Cp\u003ECh\u00E0o anh, em b\u00EAn ng\u00E2n h\u00E0ng \u1EA1. T\u00E0i kho\u1EA3n anh \u003Cstrong\u003E\u0111ang b\u1ECB x\u00E2m nh\u1EADp\u003C/strong\u003E.\u003C/p\u003E\u003Cp\u003EAnh \u003Cstrong\u003E\u0111\u1ECDc gi\u00FAp em m\u00E3 OTP\u003C/strong\u003E v\u1EEBa g\u1EEDi \u0111\u1EC3 em kh\u00F3a l\u1EA1i ngay nh\u00E9. \u003Cstrong\u003EG\u1EA5p l\u1EAFm anh \u1EA1!\u003C/strong\u003E\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "warningText",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "D\u1EEBng l\u1EA1i: d\u1ECDa b\u1EA1n, \u0111\u00F2i m\u00E3 OTP, th\u00FAc \u00E9p ph\u1EA3i l\u00E0m ngay."
                  },
                  {
                    "alias": "highlightTitle",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0111\u1EBFn."
                  }
