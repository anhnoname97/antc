    <SortOrder>0</SortOrder>
    <Published Default="true" />
    <Schedule />
    <Template />
  </Info>
  <Properties>
    <actions>
      <Value><![CDATA[<p><b>Có thẻ ngân hàng:</b> lật mặt sau thẻ, gọi số chăm sóc khách hàng in trên thẻ.<br><b>Không có thẻ:</b> mở ứng dụng ngân hàng bạn đã cài từ trước, vào mục Trợ giúp hoặc Liên hệ.<br><b>Luôn luôn:</b> không bấm đường link và không gọi số do người kia gửi.</p>]]></Value>
    </actions>
    <approvedBy>
      <Value><![CDATA[Ban biên tập]]></Value>
    </approvedBy>
    <question>
      <Value><![CDATA[Có người gọi nói tài khoản của tôi sắp bị khóa, bảo đọc mã OTP để xác minh. Tôi phải làm gì?]]></Value>
    </question>
    <reason>
      <Value><![CDATA[<p>Bảo bạn <b>đọc</b> hoặc <b>gửi</b> mật khẩu, mã OTP, mã PIN là một dấu hiệu phải dừng. Đừng nghe họ tự xưng là ai, hãy nhìn vào việc họ đang bảo mình làm.</p>]]></Value>
    </reason>
    <relatedPages>
      <Value><![CDATA[]]></Value>
    </relatedPages>
    <shortAnswer>
      <Value><![CDATA[Không đọc mã. Cúp máy, rồi tự gọi số in ở mặt sau thẻ hoặc tự mở ứng dụng ngân hàng để hỏi.]]></Value>
    </shortAnswer>
  </Properties>
</Content>
