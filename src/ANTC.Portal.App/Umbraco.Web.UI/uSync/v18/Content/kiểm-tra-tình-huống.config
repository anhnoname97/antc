    <illustration>
      <Value><![CDATA[]]></Value>
    </illustration>
    <illustrationAlt>
      <Value><![CDATA[Ảnh minh họa tình huống tự bảo vệ trước rủi ro tài chính]]></Value>
    </illustrationAlt>
    <lead>
      <Value><![CDATA[Trả lời 3 câu hỏi ngắn để nhận dấu hiệu cảnh báo và việc cần làm ngay.]]></Value>
    </lead>
    <maxSituations>
      <Value><![CDATA[3]]></Value>
    </maxSituations>
    <noMatchText>
      <Value><![CDATA[Chưa có tình huống mẫu khớp với lựa chọn của bạn. Điều đó không có nghĩa là an toàn. Trong lúc chưa rõ, nhớ bốn điều:]]></Value>
    </noMatchText>
    <ogImage>
      <Value><![CDATA[]]></Value>
    </ogImage>
    <privacyNote>
      <Value><![CDATA[Không cần đăng nhập. Câu trả lời không được lưu và không gửi đi đâu. Đừng nhập số điện thoại, số tài khoản hay tên riêng ở bất kỳ đâu.]]></Value>
    </privacyNote>
