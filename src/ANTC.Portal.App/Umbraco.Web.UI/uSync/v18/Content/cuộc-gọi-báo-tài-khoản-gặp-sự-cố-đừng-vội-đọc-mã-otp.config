    <safeAction>
      <Value><![CDATA[Kết thúc cuộc gọi. Không đọc mã OTP hoặc mật khẩu. Tự liên hệ ngân hàng bằng số trên thẻ hoặc trong ứng dụng chính thức; nếu đã cung cấp thông tin, đề nghị hỗ trợ bảo vệ tài khoản ngay.]]></Value>
    </safeAction>
    <seoDescription>
      <Value><![CDATA[Nhận diện cuộc gọi thúc ép cung cấp mã OTP, mật khẩu hoặc mở liên kết lạ; tự xác minh qua kênh ngân hàng trước khi làm theo.]]></Value>
