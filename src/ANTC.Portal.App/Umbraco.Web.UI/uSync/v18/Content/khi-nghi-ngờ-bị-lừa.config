  <Properties>
    <bq>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "59bbd435-7676-5908-aef1-901b8d36715c",
      "key": "3f8fe991-c543-5b54-a1b5-081c0bb26d20",
      "values": [
        {
          "alias": "q",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00F3 ai \u0111ang \u0111e d\u1ECDa, \u00E9p bu\u1ED9c b\u1EA1n ph\u1EA3i tr\u1EA3 ti\u1EC1n ho\u1EB7c ph\u1EA3i im l\u1EB7ng kh\u00F4ng?"
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u1EA1n \u0111ang b\u1ECB \u0111e d\u1ECDa, \u00E9p bu\u1ED9c"
        },
        {
          "alias": "yes",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "no",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "to",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "umb://document/68706bf34b275b5aa587ccccb499a810"
        },
        {
          "alias": "take",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "1,2,3,4"
        }
      ]
    },
    {
      "contentTypeKey": "59bbd435-7676-5908-aef1-901b8d36715c",
      "key": "6281f8a5-0838-5341-a45b-42cbbc31c121",
      "values": [
        {
          "alias": "q",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u1EA1n \u0111\u00E3 \u0111\u1ECDc m\u00E3 OTP, \u0111\u01B0a m\u1EADt kh\u1EA9u, c\u00E0i \u1EE9ng d\u1EE5ng theo l\u1EDDi ng\u01B0\u1EDDi kh\u00E1c, ho\u1EB7c cho ng\u01B0\u1EDDi kh\u00E1c xem, \u0111i\u1EC1u khi\u1EC3n m\u00E0n h\u00ECnh?"
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ng\u01B0\u1EDDi kh\u00E1c c\u00F3 th\u1EC3 \u0111ang c\u00F3 quy\u1EC1n v\u00E0o t\u00E0i kho\u1EA3n ho\u1EB7c \u0111i\u1EC7n tho\u1EA1i c\u1EE7a b\u1EA1n"
        },
        {
          "alias": "yes",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "no",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "to",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "umb://document/271372f509a1562da994344aac10d210"
        },
        {
          "alias": "take",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "1,2,4,6"
        }
      ]
    },
    {
      "contentTypeKey": "59bbd435-7676-5908-aef1-901b8d36715c",
      "key": "b361203f-2888-51fb-a1c4-0b246f890f74",
      "values": [
        {
          "alias": "q",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u1EA1n \u0111\u00E3 chuy\u1EC3n ti\u1EC1n, \u0111\u01B0a ti\u1EC1n, ho\u1EB7c \u0111\u00E3 giao h\u00E0ng \u0111i ch\u01B0a?"
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u1EA1n \u0111\u00E3 chuy\u1EC3n ti\u1EC1n ho\u1EB7c \u0111\u00E3 giao h\u00E0ng"
        },
        {
          "alias": "yes",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "R\u1ED3i"
        },
        {
          "alias": "no",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u01B0a"
        },
        {
          "alias": "to",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "umb://document/37ea5c835a975585a294d78e0c32a5f8"
        },
        {
          "alias": "take",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "1,2,4,5"
        }
      ]
    },
    {
      "contentTypeKey": "59bbd435-7676-5908-aef1-901b8d36715c",
      "key": "28cd7718-52d6-5d86-ad4d-c29218cfd567",
      "values": [
        {
          "alias": "q",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u1EA1n \u0111\u00E3 g\u1EEDi \u1EA3nh gi\u1EA5y t\u1EDD, qu\u00E9t khu\u00F4n m\u1EB7t, k\u00FD gi\u1EA5y, ho\u1EB7c cho m\u01B0\u1EE3n t\u00E0i kho\u1EA3n, SIM?"
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Gi\u1EA5y t\u1EDD, ch\u1EEF k\u00FD ho\u1EB7c t\u00E0i kho\u1EA3n c\u1EE7a b\u1EA1n \u0111\u00E3 \u0111\u01B0\u1EE3c \u0111\u01B0a \u0111i"
        },
        {
          "alias": "yes",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "R\u1ED3i"
        },
        {
          "alias": "no",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u01B0a"
        },
        {
          "alias": "to",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "umb://document/d59bdc96b741509ea95c2d0e56e31d5c"
        },
        {
          "alias": "take",
          "culture": null,
