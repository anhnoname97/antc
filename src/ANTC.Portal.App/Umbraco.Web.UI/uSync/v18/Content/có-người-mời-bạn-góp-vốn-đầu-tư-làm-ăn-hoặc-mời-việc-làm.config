  <Properties>
    <lead>
      <Value><![CDATA[Còn một câu chưa trả lời được thì chưa quyết định.]]></Value>
    </lead>
    <slug>
      <Value><![CDATA[co-nguoi-moi-ban-gop-von-dau-tu]]></Value>
    </slug>
    <sourceCode>
      <Value><![CDATA[p4]]></Value>
    </sourceCode>
    <steps>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "1a6c8d4b-177a-58e2-a070-700451fc5c49",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "H\u1ECFi ba c\u00E2u tr\u01B0\u1EDBc khi b\u1ECF ti\u1EC1n: l\u1EE3i nhu\u1EADn \u1EDF \u0111\u00E2u ra, ai c\u00F3 ngh\u0129a v\u1EE5 tr\u1EA3 ti\u1EC1n cho m\u00ECnh, v\u00E0 mu\u1ED1n r\u00FAt th\u00EC r\u00FAt b\u1EB1ng c\u00E1ch n\u00E0o."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "N\u1EBFu c\u00F2n \u0111i\u1EC1u ch\u01B0a r\u00F5, \u0111\u1EEBng chuy\u1EC3n ti\u1EC1n. H\u00E3y h\u1ECFi l\u1EA1i, \u0111\u1ECDc k\u1EF9 gi\u1EA5y t\u1EDD, ho\u1EB7c nh\u1EDD m\u1ED9t ng\u01B0\u1EDDi b\u1EA1n tin c\u1EADy xem gi\u00FAp.\n\u0110\u00E2y l\u00E0 ba c\u00E2u tr\u1EDF \u0111i tr\u1EDF l\u1EA1i c\u1EE7a Chuy\u00EAn \u0111\u1EC1 3."
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "7f2027a6-35c4-5f98-a921-f3a44040b4e0",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ki\u1EC3m tra xem h\u1ECD c\u00F3 gi\u1EA5y cho ph\u00E9p l\u00E0m \u0111\u00FAng lo\u1EA1i d\u1ECBch v\u1EE5 \u0111ang m\u1EDDi b\u1EA1n hay kh\u00F4ng."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00F3 \u0111\u0103ng k\u00FD doanh nghi\u1EC7p m\u1EDBi ch\u1EC9 l\u00E0 c\u00F3 \u0111\u0103ng k\u00FD kinh doanh. Nh\u1EADn ti\u1EC1n c\u1EE7a ng\u01B0\u1EDDi kh\u00E1c \u0111\u1EC3 \u0111\u1EA7u t\u01B0, cho vay hay b\u1EA3o hi\u1EC3m c\u00F2n c\u1EA7n gi\u1EA5y ph\u00E9p ri\u00EAng."
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "cad40e34-cbcd-5647-ae55-9a1b335e4ea4",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Xin to\u00E0n b\u1ED9 \u0111i\u1EC1u ki\u1EC7n b\u1EB1ng v\u0103n b\u1EA3n, mang v\u1EC1 \u0111\u1ECDc. Kh\u00F4ng k\u00FD, kh\u00F4ng chuy\u1EC3n ti\u1EC1n t\u1EA1i ch\u1ED7."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "962d99ec-873d-522a-a0e5-12f60cf26073",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "X\u00E1c \u0111\u1ECBnh tr\u01B0\u1EDBc m\u1EE9c thi\u1EC7t h\u1EA1i t\u1ED1i \u0111a b\u1EA1n ch\u1EA5p nh\u1EADn \u0111\u01B0\u1EE3c, v\u00E0 nh\u1EEFng kho\u1EA3n b\u1EA1n c\u00F3 th\u1EC3 ph\u1EA3i tr\u1EA3 th\u00EAm v\u1EC1 sau."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "77053434-f7e3-514f-a8fd-63b7b17b39e1",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kh\u00F4ng vay ti\u1EC1n, kh\u00F4ng d\u00F9ng ti\u1EC1n d\u00E0nh cho vi\u1EC7c thi\u1EBFt y\u1EBFu \u0111\u1EC3 \u0111\u1EA7u t\u01B0."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "001138fd-8e8b-57c3-acce-960a3c619fd0",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "N\u1EBFu h\u1ECD y\u00EAu c\u1EA7u tr\u1EA3 ti\u1EC1n tr\u01B0\u1EDBc, h\u00E3y d\u1EEBng li\u00EAn h\u1EC7 ngay. Mu\u1ED1n thu\u00EA d\u1ECBch v\u1EE5 th\u1EADt th\u00EC b\u1EA1n t\u1EF1 \u0111i t\u00ECm, \u0111\u1EEBng d\u00F9ng ng\u01B0\u1EDDi t\u1EF1 nh\u1EAFn tin \u0111\u1EBFn."
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u1EEBng tr\u1EA3 ph\u00ED cho ng\u01B0\u1EDDi h\u1EE9a l\u1EA5y l\u1EA1i ti\u1EC1n"
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    }
  ],
