    <cardCaption>
      <Value><![CDATA[Chuyên đề 1]]></Value>
    </cardCaption>
    <doD>
      <Value><![CDATA[Cúp máy hoặc thoát trang, chưa đưa gì cả.]]></Value>
    </doD>
    <doH>
      <Value><![CDATA[Tự kiểm tra bằng kênh chính thức mình tìm.]]></Value>
    </doH>
    <guidePage>
      <Value><![CDATA[]]></Value>
    </guidePage>
