    <steps>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "3d080081-51a3-547c-a35e-994362479a65",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "D\u1EEBng li\u00EAn l\u1EA1c. Kh\u00F4ng b\u1EA5m v\u00E0o b\u1EA5t k\u1EF3 \u0111\u01B0\u1EDDng link n\u00E0o h\u1ECD \u0111\u00E3 g\u1EEDi."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "b2dbafee-6724-5f55-a996-b909590e201f",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u1EF1 t\u00ECm \u0111\u01B0\u1EDDng li\u00EAn h\u1EC7 ch\u00EDnh th\u1EE9c c\u1EE7a n\u01A1i \u0111\u01B0\u1EE3c nh\u1EAFc t\u1EDBi, r\u1ED3i g\u1ECDi l\u1EA1i \u0111\u1EC3 h\u1ECFi."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "L\u1EA5y s\u1ED1 t\u1EEB \u1EE9ng d\u1EE5ng b\u1EA1n \u0111\u00E3 c\u00E0i t\u1EEB tr\u01B0\u1EDBc, t\u1EEB gi\u1EA5y t\u1EDD b\u1EA1n \u0111ang c\u00F3, ho\u1EB7c t\u1EEB c\u1ED5ng th\u00F4ng tin c\u1EE7a c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc.\nKh\u00F4ng d\u00F9ng s\u1ED1 ng\u01B0\u1EDDi \u0111\u00F3 \u0111\u01B0a. C\u0169ng kh\u00F4ng d\u00F9ng s\u1ED1 l\u1EA5y t\u1EEB qu\u1EA3ng c\u00E1o ho\u1EB7c t\u1EEB k\u1EBFt qu\u1EA3 t\u00ECm ki\u1EBFm \u0111\u1EA7u ti\u00EAn \u2014 s\u1ED1 gi\u1EA3 v\u1EABn mua \u0111\u01B0\u1EE3c ch\u1ED7 hi\u1EC3n th\u1ECB tr\u00EAn c\u00F9ng."
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "6c2873d7-3d48-501e-a632-190e13cedd04",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ki\u1EC3m tra t\u00EAn ch\u1EE7 t\u00E0i kho\u1EA3n nh\u1EADn ti\u1EC1n."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u00EAn kh\u00F4ng kh\u1EDBp v\u1EDBi b\u00EAn b\u1EA1n \u0111ang giao d\u1ECBch th\u00EC d\u1EEBng l\u1EA1i.\nNh\u01B0ng t\u00EAn kh\u1EDBp c\u0169ng KH\u00D4NG ch\u1EE9ng minh y\u00EAu c\u1EA7u l\u00E0 th\u1EADt. K\u1EBB l\u1EEBa \u0111\u1EA3o c\u00F3 th\u1EC3 d\u00F9ng t\u00E0i kho\u1EA3n mang \u0111\u00FAng t\u00EAn m\u1ED9t doanh nghi\u1EC7p c\u00F3 th\u1EADt."
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "bc7a5e1a-4468-5fa8-ad5c-837ee11833af",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "N\u00F3i chuy\u1EC7n v\u1EDBi m\u1ED9t ng\u01B0\u1EDDi b\u1EA1n tin c\u1EADy tr\u01B0\u1EDBc khi quy\u1EBFt \u0111\u1ECBnh."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "a506fe90-d427-53ed-a6c4-836c4e6b9a14",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kh\u00F4ng vay ti\u1EC1n, kh\u00F4ng th\u1EBF ch\u1EA5p t\u00E0i s\u1EA3n \u0111\u1EC3 \u0111\u00E1p \u1EE9ng m\u1ED9t y\u00EAu c\u1EA7u g\u1EA5p."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "93fc3a4e-a351-5aa2-aa6c-e67d66943848",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "N\u1EBFu vi\u1EC7c b\u1EAFt \u0111\u1EA7u t\u1EEB cu\u1ED9c g\u1ECDi ho\u1EB7c tin nh\u1EAFn, ph\u1EA3n \u00E1nh t\u1EDBi 156."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u00E2y l\u00E0 n\u01A1i ph\u1EA3n \u00E1nh cu\u1ED9c g\u1ECDi, tin nh\u1EAFn c\u00F3 d\u1EA5u hi\u1EC7u l\u1EEBa \u0111\u1EA3o. Vi\u1EC7c n\u00E0y kh\u00F4ng thay cho vi\u1EC7c b\u00E1o ng\u00E2n h\u00E0ng hay tr\u00ECnh b\u00E1o C\u00F4ng an."
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "G\u1ECDi 156",
              "target": null,
              "unique": null,
              "type": null,
              "udi": null,
              "url": "tel:156",
              "queryString": null,
              "culture": null
            },
            {
              "name": "Nh\u1EAFn tin 156",
              "target": null,
              "unique": null,
              "type": null,
              "udi": null,
              "url": "sms:156",
              "queryString": null,
              "culture": null
            }
          ]
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "143995be-5164-55b8-ab02-d27ea2981dcc",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "N\u1EBFu h\u1ECD y\u00EAu c\u1EA7u tr\u1EA3 ti\u1EC1n tr\u01B0\u1EDBc, h\u00E3y d\u1EEBng li\u00EAn h\u1EC7 ngay. Mu\u1ED1n thu\u00EA d\u1ECBch v\u1EE5 th\u1EADt th\u00EC b\u1EA1n t\u1EF1 \u0111i t\u00ECm, \u0111\u1EEBng d\u00F9ng ng\u01B0\u1EDDi t\u1EF1 nh\u1EAFn tin \u0111\u1EBFn."
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u1EEBng tr\u1EA3 ph\u00ED cho ng\u01B0\u1EDDi h\u1EE9a l\u1EA5y l\u1EA1i ti\u1EC1n"
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    }
  ],
