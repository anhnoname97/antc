    </canonicalUrl>
    <chkLead>
      <Value><![CDATA[Mỗi mục kiểm tra có hai phần: năm việc phải chặn ngay và phần kiểm tra bỏ túi, lấy nguyên văn từ bài đọc chuyên đề. Bản trên website có nút In để in hoặc lưu thành PDF.]]></Value>
    </chkLead>
    <chkOrder>
      <Value><![CDATA[]]></Value>
    </chkOrder>
    <chkTitle>
      <Value><![CDATA[Kiểm tra theo việc sắp làm]]></Value>
    </chkTitle>
