    <canonicalUrl>
      <Value><![CDATA[]]></Value>
    </canonicalUrl>
    <doD>
      <Value><![CDATA[Đóng trang, chụp lại địa chỉ và tin nhắn.]]></Value>
    </doD>
    <doH>
      <Value><![CDATA[Yêu cầu sửa đơn cho khớp, hoặc tự mở kênh chính thức của bên bán để đối chiếu.]]></Value>
    </doH>
    <hideFromSearch>
      <Value><![CDATA[]]></Value>
    </hideFromSearch>
