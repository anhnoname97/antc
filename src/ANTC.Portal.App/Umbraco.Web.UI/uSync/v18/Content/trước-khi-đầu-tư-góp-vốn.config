    </canonicalUrl>
    <doD>
      <Value><![CDATA[Chụp lại lời mời, không tranh luận tiếp trong nhóm.]]></Value>
    </doD>
    <doH>
      <Value><![CDATA[Tự tra tên đơn vị, giấy phép và ngành nghề ở nguồn chính thức mình tự tìm.]]></Value>
    </doH>
