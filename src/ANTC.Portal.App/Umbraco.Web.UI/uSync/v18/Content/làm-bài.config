        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ph\u1EA7n 4 \u00B7 Thi tr\u1EAFc nghi\u1EC7m"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Cu\u1ED9c thi tr\u1EF1c tuy\u1EBFn"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u1ECDn cu\u1ED9c thi \u0111ang di\u1EC5n ra, \u0111\u0103ng k\u00FD xong l\u00E0 v\u00E0o thi ngay."
        }
      ]
    },
    {
      "contentTypeKey": "ede5cedd-e719-56cf-b59a-3ae1fbb724c7",
      "key": "beb3261a-153a-5d0f-b16e-51168c1ca5bb",
