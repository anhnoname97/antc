      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u01B0\u1EDBc 1"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u0103ng k\u00FD d\u1EF1 thi"
        },
        {
          "alias": "modeLegend",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u1EA1n mu\u1ED1n d\u1EF1 thi theo c\u00E1ch n\u00E0o?"
        },
        {
          "alias": "namedTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "D\u1EF1 thi c\u00F3 t\u00EAn"
        },
        {
          "alias": "namedDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ghi h\u1ECD t\u00EAn v\u00E0 s\u1ED1 \u0111i\u1EC7n tho\u1EA1i. \u0110\u01B0\u1EE3c x\u00E9t gi\u1EA3i."
        },
        {
          "alias": "anonymousTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Thi \u1EA9n danh"
        },
        {
          "alias": "anonymousDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kh\u00F4ng c\u1EA7n h\u1ECD t\u00EAn, s\u1ED1 \u0111i\u1EC7n tho\u1EA1i. Kh\u00F4ng x\u00E9t gi\u1EA3i."
        },
        {
          "alias": "submitLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u0103ng k\u00FD v\u00E0 b\u1EAFt \u0111\u1EA7u l\u00E0m b\u00E0i \u203A"
        },
        {
          "alias": "anonymousSubmitLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u1EAFt \u0111\u1EA7u thi \u1EA9n danh \u203A"
        },
        {
          "alias": "practiceLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u1EC9 mu\u1ED1n luy\u1EC7n t\u1EADp, kh\u00F4ng d\u1EF1 thi: v\u00E0o ng\u00E2n h\u00E0ng c\u00E2u h\u1ECFi"
        }
      ]
    },
    {
      "contentTypeKey": "0733b193-c9ea-5f2e-b6ec-e6d6a8147602",
