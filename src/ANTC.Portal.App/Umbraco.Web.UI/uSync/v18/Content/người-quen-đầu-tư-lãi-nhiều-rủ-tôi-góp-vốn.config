  </Info>
  <Properties>
    <actions>
      <Value><![CDATA[<p>Dùng phần kiểm tra nhanh “Trước khi đầu tư, vay”. Không vay, không thế chấp nhà đất, không dùng tiền dưỡng già để góp.</p>]]></Value>
    </actions>
    <approvedBy>
      <Value><![CDATA[Ban biên tập]]></Value>
    </approvedBy>
    <question>
      <Value><![CDATA[Người quen đầu tư lãi nhiều, rủ tôi góp vốn. Có nên theo không?]]></Value>
    </question>
    <reason>
      <Value><![CDATA[<p>Người thân quen có thể cũng đang bị dẫn. Nhiều mô hình sống được chính là nhờ người quen rủ người quen. Rút thử được một khoản nhỏ chỉ chứng minh lần rút đó đã xong; khoản trả đầu tiên thường chính là tiền mồi.</p>]]></Value>
    </reason>
    <relatedPages>
      <Value><![CDATA[]]></Value>
    </relatedPages>
    <shortAnswer>
      <Value><![CDATA[Trước hết hỏi ba câu: lợi nhuận ở đâu ra, ai có nghĩa vụ trả tiền cho mình, và muốn rút thì rút bằng cách nào.]]></Value>
    </shortAnswer>
  </Properties>
</Content>
