      <Value><![CDATA[Dừng liên hệ, nói với một người trong nhà.]]></Value>
    </doD>
    <doH>
      <Value><![CDATA[Tự tìm tổ chức đó và bộ phận tuyển dụng chính thức để hỏi.]]></Value>
