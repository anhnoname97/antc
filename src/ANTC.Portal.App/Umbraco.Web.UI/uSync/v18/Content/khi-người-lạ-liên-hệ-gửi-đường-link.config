    </canonicalUrl>
    <doD>
      <Value><![CDATA[Cúp máy, chụp lại số gọi đến và tin nhắn, chưa đưa gì cả.]]></Value>
    </doD>
    <doH>
      <Value><![CDATA[Tự mở ứng dụng chính thức hoặc gọi số in trên thẻ để hỏi lại.]]></Value>
    </doH>
    <hideFromSearch>
      <Value><![CDATA[]]></Value>
