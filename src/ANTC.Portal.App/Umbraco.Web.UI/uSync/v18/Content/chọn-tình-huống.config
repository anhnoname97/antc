    <title>
      <Value><![CDATA[Chuyện gì đây???]]></Value>
    </title>
    <unknownText>
      <Value><![CDATA[Không nhớ rõ đã làm gì? Không chắc thì cứ làm như thể đã lỡ: gọi ngân hàng bằng số in sau thẻ để hỏi.]]></Value>
    </unknownText>
    <urgentNote>
      <Value><![CDATA[Đang bị đe dọa tính mạng, có người tìm đến tận nơi? Gọi 113 ngay.]]></Value>
    </urgentNote>
  </Properties>
