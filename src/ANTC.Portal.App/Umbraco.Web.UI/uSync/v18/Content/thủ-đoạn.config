          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u00E2y l\u00E0 nh\u1EEFng c\u00E1ch hay g\u1EB7p, kh\u00F4ng ph\u1EA3i to\u00E0n b\u1ED9. Chuy\u1EC7n b\u1EA1n g\u1EB7p kh\u00F4ng c\u00F3 \u1EDF \u0111\u00E2y? H\u00E3y h\u1ECFi: ng\u01B0\u1EDDi n\u00E0y mu\u1ED1n l\u1EA5y th\u1EE9 n\u00E0o trong b\u1ED1n th\u1EE9 tr\u00EAn, v\u00E0 \u0111ang d\u00F9ng c\u00E1ch n\u00E0o? Kh\u00F4ng tr\u1EA3 l\u1EDDi \u0111\u01B0\u1EE3c th\u00EC d\u00F9ng hai c\u00E2u h\u1ECFi \u1EDF Ph\u1EA7n 2."
        },
        {
          "alias": "helpLink",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "Hai c\u00E2u t\u1EF1 ki\u1EC3m tra \u2192",
              "url": "/ung-pho/#hai-cau",
              "udi": null,
              "target": null
            }
          ]
        }
      ]
    },
    {
      "contentTypeKey": "8e21ac3b-8a0a-4f67-8a64-da8a3cde7093",
      "key": "120a51fc-363e-5f5e-8317-89e490ac5030",
      "values": []
    },
    {
      "contentTypeKey": "f5a7d893-62bf-4ef8-8a02-d3cf9de98891",
      "key": "67975487-eb80-5537-9001-bdb4a79781c5",
      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Theo l\u0129nh v\u1EF1c"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Th\u1EE7 \u0111o\u1EA1n theo"
        },
        {
          "alias": "highlightTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "t\u1EEBng l\u0129nh v\u1EF1c"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u1ECDn l\u0129nh v\u1EF1c g\u1EA7n v\u1EDBi vi\u1EC7c b\u1EA1n \u0111ang g\u1EB7p."
        },
        {
          "alias": "sourceRoot",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "umb://document/33df5aae56585ea18b01500630acfd60"
        },
        {
          "alias": "emptyText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u01B0a th\u1EA5y l\u0129nh v\u1EF1c kh\u1EDBp. H\u00E3y t\u1EF1 h\u1ECFi: ng\u01B0\u1EDDi n\u00E0y mu\u1ED1n l\u1EA5y th\u1EE9 n\u00E0o trong b\u1ED1n th\u1EE9, v\u00E0 \u0111ang d\u00F9ng c\u00E1ch n\u00E0o?"
        },
        {
          "alias": "privacyMessage",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Website kh\u00F4ng tra c\u1EE9u theo s\u1ED1 \u0111i\u1EC7n tho\u1EA1i hay s\u1ED1 t\u00E0i kho\u1EA3n. H\u00E3y g\u00F5 t\u00EAn th\u1EE7 \u0111o\u1EA1n ho\u1EB7c l\u0129nh v\u1EF1c."
        }
      ]
    },
    {
      "contentTypeKey": "8e21ac3b-8a0a-4f67-8a64-da8a3cde7093",
      "key": "a3842bc5-97cf-5354-9697-f11a88034061",
      "values": []
    },
    {
      "contentTypeKey": "559841ae-7190-4873-b2bf-f8aecfe05aa9",
      "key": "da0fe82a-bbdc-5d29-b2cb-3f9005c5ad0e",
      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Xu h\u01B0\u1EDBng"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Xu h\u01B0\u1EDBng v\u00E0"
        },
        {
          "alias": "highlightTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "c\u1EA3nh b\u00E1o m\u1EDBi"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "M\u1ED7i c\u1EA3nh b\u00E1o ghi r\u00F5 c\u01A1 quan ban h\u00E0nh v\u00E0 ng\u00E0y c\u1EADp nh\u1EADt."
        },
        {
          "alias": "sourceRoot",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "umb://document/cda7084d12ac4edfbbd994b53d78cecc"
        },
        {
          "alias": "emptyText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u01B0a c\u00F3 c\u1EA3nh b\u00E1o \u0111\u01B0\u1EE3c xu\u1EA5t b\u1EA3n."
        },
        {
          "alias": "readingLinks",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "B\u00E0i \u0111\u1ECDc theo chuy\u00EAn \u0111\u1EC1",
              "url": null,
              "udi": "umb://document/e2aa83a78e13436b95698de11c44ce4d",
              "target": null
            },
            {
              "name": "L\u1EEBa \u0111\u1EA3o: T\u1EEB c\u1ED5 ch\u00ED kim",
              "url": null,
              "udi": "umb://document/3ca68856dc5b4335af7d42addb4e4db6",
              "target": null
            }
          ]
        }
      ]
    },
    {
      "contentTypeKey": "8e21ac3b-8a0a-4f67-8a64-da8a3cde7093",
      "key": "e7dbcf26-ab90-5032-b677-9197588cb54c",
      "values": []
    },
    {
      "contentTypeKey": "b4dcec02-b18c-4498-9f97-eab55cb8ea94",
      "key": "40e31d61-1fb9-5b27-9473-ececf42e6709",
      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ph\u1EA7n ti\u1EBFp theo \u00B7 4 / 5"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Thi tr\u1EAFc nghi\u1EC7m, g\u00F3p \u00FD cho Ch\u01B0\u01A1ng tr\u00ECnh, r\u1EE7 ng\u01B0\u1EDDi th\u00E2n c\u00F9ng h\u1ECDc."
        },
        {
          "alias": "nextLink",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "Cu\u1ED9c thi ch\u1ED1ng l\u1EEBa \u0111\u1EA3o",
              "url": null,
              "udi": "umb://document/88abf9effb9345c59cff4aa76ca6f250",
              "target": null
            }
          ]
        },
        {
          "alias": "urgentLink",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "\u0110ang g\u1EB7p chuy\u1EC7n? L\u00E0m ngay",
              "url": "/ung-pho/",
              "udi": null,
              "target": null
            }
          ]
        }
      ]
