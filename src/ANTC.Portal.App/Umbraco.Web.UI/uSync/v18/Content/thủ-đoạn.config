      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ph\u1EA7n 3 / 5 \u00B7 Th\u1EE7 \u0111o\u1EA1n"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00E1c th\u1EE7 \u0111o\u1EA1n"
        },
        {
          "alias": "highlightTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "l\u1EEBa \u0111\u1EA3o"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Th\u1EE7 \u0111o\u1EA1n \u0111\u1ED5i li\u00EAn t\u1EE5c. Nh\u00ECn v\u00E0o th\u1EE9 h\u1ECD mu\u1ED1n l\u1EA5y v\u00E0 c\u00E1ch h\u1ECD l\u00E0m, b\u1EA1n nh\u1EADn ra \u0111\u01B0\u1EE3c c\u1EA3 th\u1EE7 \u0111o\u1EA1n ch\u01B0a ai \u0111\u1EB7t t\u00EAn."
        },
        {
          "alias": "breadcrumbLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ph\u1EA7n 3"
        },
        {
          "alias": "searchPlaceholder",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u00ECm th\u1EE7 \u0111o\u1EA1n, v\u00ED d\u1EE5: \u0111\u1EB7t c\u1ECDc, vi\u1EC7c l\u00E0m, vay\u2026"
        },
        {
          "alias": "searchButtonLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u00ECm"
        },
        {
          "alias": "privacyNote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u1EEBng nh\u1EADp s\u1ED1 \u0111i\u1EC7n tho\u1EA1i, s\u1ED1 t\u00E0i kho\u1EA3n hay t\u00EAn ri\u00EAng. Website kh\u00F4ng tra c\u1EE9u theo nh\u1EEFng th\u1EE9 \u0111\u00F3."
        }
      ]
    },
