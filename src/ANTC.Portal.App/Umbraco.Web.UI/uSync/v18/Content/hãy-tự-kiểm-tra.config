    <chkLead>
      <Value><![CDATA[Mỗi danh sách có hai phần: năm việc phải chặn ngay và bảng kiểm bỏ túi, lấy nguyên văn từ bài đọc chuyên đề. Bản trên website có nút In để in hoặc lưu thành PDF.]]></Value>
    </chkLead>
    <chkOrder>
      <Value><![CDATA[]]></Value>
    </chkOrder>
    <chkTitle>
      <Value><![CDATA[Danh sách kiểm tra theo việc sắp làm]]></Value>
    </chkTitle>
