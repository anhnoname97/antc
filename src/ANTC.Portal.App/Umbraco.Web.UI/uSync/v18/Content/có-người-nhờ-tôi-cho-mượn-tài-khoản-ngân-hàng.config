    <SortOrder>6</SortOrder>
    <Published Default="true" />
    <Schedule />
    <Template />
  </Info>
  <Properties>
    <actions>
      <Value><![CDATA[<p>Nếu đã lỡ giao thẻ, SIM hoặc mã xác thực, báo cả ngân hàng và nhà mạng bằng số chính thức bạn tự tìm.</p>]]></Value>
    </actions>
    <approvedBy>
      <Value><![CDATA[Ban biên tập]]></Value>
    </approvedBy>
    <question>
      <Value><![CDATA[Có người nhờ tôi cho mượn tài khoản ngân hàng, trả tiền công. Có sao không?]]></Value>
    </question>
    <reason>
      <Value><![CDATA[<p>Không mở, cho mượn, cho thuê hay bán tài khoản ngân hàng, và không nhận chuyển tiền hộ. Đây là hành vi bị cấm, và nó kéo người đứng tên vào dòng tiền phạm pháp.</p>]]></Value>
    </reason>
    <relatedPages>
      <Value><![CDATA[]]></Value>
    </relatedPages>
    <shortAnswer>
      <Value><![CDATA[Từ chối ngay, dù được trả tiền công.]]></Value>
    </shortAnswer>
  </Properties>
</Content>
