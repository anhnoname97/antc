    </articleKind>
    <avoidActions>
      <Value><![CDATA[Không ký giấy còn trống
Không bấm đồng ý khi chưa đọc
Không ký nghiệm thu khi chưa kiểm
Không chuyển vào tài khoản lệch tên
Không ký vội vì bị giục]]></Value>
    </avoidActions>
    <canonicalUrl>
      <Value><![CDATA[]]></Value>
    </canonicalUrl>
    <description>
      <Value><![CDATA[Bốn điều phải rõ trước khi ký: ai là bên cung cấp, mình phải trả bao nhiêu, mình được hưởng gì, và muốn dừng thì làm thế nào.]]></Value>
    </description>
