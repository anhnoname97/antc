      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "H\u1ECFi \u2013 \u0111\u00E1p nhanh"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "H\u1ECFi \u2013 \u0111\u00E1p nhanh"
        },
        {
          "alias": "titleAccent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00E2u h\u1ECFi th\u01B0\u1EDDng g\u1EB7p, tr\u1EA3 l\u1EDDi ng\u1EAFn g\u1ECDn k\u00E8m c\u0103n c\u1EE9 v\u00E0 vi\u1EC7c c\u1EA7n l\u00E0m."
        },
        {
          "alias": "tagLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "H\u1ECFi \u2013 \u0111\u00E1p nhanh"
        },
        {
          "alias": "emptyText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u01B0a c\u00F3 c\u00E2u h\u1ECFi n\u00E0o trong danh s\u00E1ch."
        },
        {
          "alias": "note",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u1EA3n d\u1EF1ng th\u1EED: \u0111\u00E2y l\u00E0 v\u00ED d\u1EE5 c\u00E1ch tr\u00ECnh b\u00E0y. Khi v\u1EADn h\u00E0nh, m\u1ED7i c\u00E2u tr\u1EA3 l\u1EDDi \u0111\u1EC1u do Ban bi\u00EAn t\u1EADp duy\u1EC7t v\u00E0 d\u1EABn v\u1EC1 m\u1ED9t n\u1ED9i dung \u0111\u00E3 th\u1EA9m \u0111\u1ECBnh."
        }
      ]
    },
    {
      "contentTypeKey": "52332014-566e-4589-9571-a7496322a8aa",
      "key": "04c920c9-cd55-505a-a5a7-d702726947dd",
      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00E1ch ho\u1EA1t \u0111\u1ED9ng"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "G\u1EEDi c\u00E2u h\u1ECFi, ki\u1EBFn ngh\u1ECB ri\u00EAng"
        },
        {
          "alias": "titleAccent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "step1Title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u1EA1n g\u1EEDi k\u00EDn"
        },
        {
          "alias": "step1Description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00E2u h\u1ECFi, ki\u1EBFn ngh\u1ECB kh\u00F4ng hi\u1EC7n l\u00EAn trang."
        },
        {
          "alias": "step2Title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ban bi\u00EAn t\u1EADp g\u1ED9p"
        },
        {
          "alias": "step2Description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00E1c c\u00E2u gi\u1ED1ng nhau \u0111\u01B0\u1EE3c g\u1ED9p l\u00E0m m\u1ED9t."
        },
        {
          "alias": "step3Title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tr\u1EA3 l\u1EDDi c\u00F4ng khai"
        },
        {
          "alias": "step3Description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ng\u01B0\u1EDDi bi\u00EAn t\u1EADp duy\u1EC7t t\u1EEBng c\u00E2u tr\u01B0\u1EDBc khi \u0111\u0103ng, \u0111\u00E3 che m\u1ECDi th\u00F4ng tin c\u00E1 nh\u00E2n."
        },
        {
          "alias": "urgentTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110ang g\u1EB7p chuy\u1EC7n g\u1EA5p?"
        },
        {
          "alias": "urgentDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u1EEBng ch\u1EDD tr\u1EA3 l\u1EDDi, xem vi\u1EC7c c\u1EA7n l\u00E0m ngay."
        },
        {
          "alias": "urgentLink",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "Ph\u1EA7n 2 \u00B7 \u1EE8ng ph\u00F3",
              "target": null,
              "unique": null,
              "type": null,
              "udi": null,
              "url": "/ung-pho/",
              "queryString": null,
              "culture": null
            }
          ]
        }
      ]
    },
    {
      "contentTypeKey": "d5af8a38-04ca-4120-b78e-ac5fb7cc00af",
      "key": "8458c717-71a3-5f4f-ad3a-1c36515a7d7d",
      "values": [
        {
          "alias": "eyebrow",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "G\u1EEDi k\u00EDn"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "G\u1EEDi c\u00E2u h\u1ECFi, ki\u1EBFn ngh\u1ECB"
        },
        {
          "alias": "feedbackTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "G\u00F3p \u00FD cho Ch\u01B0\u01A1ng tr\u00ECnh"
        },
        {
          "alias": "contentLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00E2u h\u1ECFi ho\u1EB7c ki\u1EBFn ngh\u1ECB c\u1EE7a b\u1EA1n"
        },
        {
          "alias": "placeholder",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "V\u00ED d\u1EE5: T\u00F4i \u0111\u01B0\u1EE3c m\u1EDDi l\u00E0m c\u1ED9ng t\u00E1c vi\u00EAn, h\u1ECD b\u1EA3o n\u1EA1p 300 ngh\u00ECn \u0111\u1EC3 m\u1EDF t\u00E0i kho\u1EA3n. C\u00F3 n\u00EAn n\u1EA1p kh\u00F4ng?"
        },
        {
          "alias": "hint",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Vi\u1EBFt ng\u1EAFn g\u1ECDn, kh\u00F4ng c\u1EA7n k\u1EC3 t\u00EAn ai."
        },
        {
          "alias": "replyLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u00F4i mu\u1ED1n nh\u1EADn tr\u1EA3 l\u1EDDi ri\u00EAng"
        },
        {
          "alias": "replyNote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "(kh\u00F4ng b\u1EAFt bu\u1ED9c)"
        },
        {
          "alias": "contactLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Th\u01B0 \u0111i\u1EC7n t\u1EED ho\u1EB7c s\u1ED1 \u0111i\u1EC7n tho\u1EA1i \u0111\u1EC3 nh\u1EADn tr\u1EA3 l\u1EDDi"
        },
        {
          "alias": "consentLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u00F4i \u0111\u1ED3ng \u00FD cho Ban bi\u00EAn t\u1EADp \u0111\u1ECDc v\u00E0 x\u1EED l\u00FD c\u00E2u h\u1ECFi n\u00E0y \u0111\u1EC3 tr\u1EA3 l\u1EDDi."
        },
        {
          "alias": "submitHint",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u1EA7n \u0111\u00E1nh d\u1EA5u \u0111\u1ED3ng \u00FD \u0111\u1EC3 g\u1EEDi."
        },
        {
          "alias": "buttonLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "G\u1EEDi"
        },
        {
          "alias": "feedbackButtonLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "G\u1EEDi g\u00F3p \u00FD"
        },
        {
          "alias": "legal",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Website n\u00E0y kh\u00F4ng ph\u1EA3i l\u00E0 n\u01A1i ti\u1EBFp nh\u1EADn t\u1ED1 gi\u00E1c, tin b\u00E1o v\u1EC1 t\u1ED9i ph\u1EA1m. N\u1EBFu b\u1EA1n c\u1EA7n tr\u00ECnh b\u00E1o, h\u00E3y li\u00EAn h\u1EC7 tr\u1EF1c ti\u1EBFp c\u01A1 quan C\u00F4ng an n\u01A1i b\u1EA1n c\u01B0 tr\u00FA."
        },
        {
          "alias": "successTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u00E3 nh\u1EADn c\u00E2u h\u1ECFi c\u1EE7a b\u1EA1n"
        },
        {
          "alias": "feedbackSuccessTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u00E3 nh\u1EADn g\u00F3p \u00FD c\u1EE7a b\u1EA1n"
        },
        {
          "alias": "successDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ban bi\u00EAn t\u1EADp \u0111\u00E3 nh\u1EADn n\u1ED9i dung c\u1EE7a b\u1EA1n. N\u1EBFu \u0111ang g\u1EB7p chuy\u1EC7n g\u1EA5p, \u0111\u1EEBng ch\u1EDD tr\u1EA3 l\u1EDDi, h\u00E3y xem ph\u1EA7n \u1EE8ng ph\u00F3 kh\u1EA9n c\u1EA5p."
        },
        {
          "alias": "publishLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kh\u00F4ng b\u1EAFt bu\u1ED9c. T\u00F4i \u0111\u1ED3ng \u00FD cho Ban bi\u00EAn t\u1EADp che m\u1ECDi th\u00F4ng tin nh\u1EADn d\u1EA1ng, bi\u00EAn t\u1EADp r\u1ED3i \u0111\u0103ng c\u00F4ng khai c\u00E2u h\u1ECFi c\u00F9ng c\u00E2u tr\u1EA3 l\u1EDDi. Kh\u00F4ng \u0111\u1ED3ng \u00FD v\u1EABn \u0111\u01B0\u1EE3c tr\u1EA3 l\u1EDDi ri\u00EAng."
        }
      ]
    },
    {
      "contentTypeKey": "7e4b8036-823f-43ab-94aa-fb1fbc633561",
      "key": "9ccd3570-bc58-519a-9d8f-f5933162ef4d",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tr\u01B0\u1EDBc khi g\u00F5"
        },
        {
          "alias": "warning1",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u1EEBng vi\u1EBFt m\u1EADt kh\u1EA9u, m\u00E3 OTP, m\u00E3 PIN, s\u1ED1 th\u1EBB hay s\u1ED1 t\u00E0i kho\u1EA3n."
        },
        {
          "alias": "warning2",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u1EEBng g\u1EEDi h\u1ECD t\u00EAn, s\u1ED1 \u0111i\u1EC7n tho\u1EA1i, \u1EA3nh gi\u1EA5y t\u1EDD c\u1EE7a ng\u01B0\u1EDDi kh\u00E1c."
        },
        {
          "alias": "info",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Giai \u0111o\u1EA1n \u0111\u1EA7u ch\u01B0a nh\u1EADn t\u1EC7p \u0111\u00EDnh k\u00E8m v\u00E0 \u1EA3nh ch\u1EE5p m\u00E0n h\u00ECnh."
        }
      ]
    }
