    <safeAction>
      <Value><![CDATA[Đừng lấy việc từng được trả lãi làm bằng chứng duy nhất. Hỏi tiền được tạo ra từ đâu, tự kiểm tra đơn vị và giao dịch; dừng nạp thêm khi bị ép đóng phí để rút.]]></Value>
    </safeAction>
    <seoDescription>
      <Value><![CDATA[Nhìn lại tên gọi Ponzi từ những năm 1920, phân biệt dòng tiền thật với lợi nhuận hiển thị và rút ra câu hỏi tự kiểm tra cho hôm nay.]]></Value>
    </seoDescription>
