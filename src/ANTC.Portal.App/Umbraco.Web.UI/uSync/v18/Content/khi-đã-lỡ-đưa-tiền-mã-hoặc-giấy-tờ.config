    <cardCaption>
      <Value><![CDATA[Chuyên đề 8 · sau sự cố]]></Value>
    </cardCaption>
    <doD>
      <Value><![CDATA[Lưu nội dung rồi mới chặn.]]></Value>
    </doD>
    <doH>
      <Value><![CDATA[Tự tra ở nguồn chính thức, gọi số lấy từ nguồn độc lập.]]></Value>
    </doH>
