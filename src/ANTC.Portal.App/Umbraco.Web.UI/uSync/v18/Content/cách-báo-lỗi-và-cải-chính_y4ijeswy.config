    <body>
      <Value><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Ch3\u003E1. Ai b\u00E1o l\u1ED7i c\u0169ng \u0111\u01B0\u1EE3c\u003C/h3\u003E\u003Cp\u003EKh\u00F4ng c\u1EA7n t\u00E0i kho\u1EA3n, kh\u00F4ng c\u1EA7n \u0111\u1EC3 l\u1EA1i t\u00EAn hay s\u1ED1 \u0111i\u1EC7n tho\u1EA1i. G\u1EEDi qua m\u1EE5c \u003Cb\u003EG\u00F3p \u00FD\u003C/b\u003E tr\u00EAn website.\u003C/p\u003E\u003Cp\u003EN\u1EBFu b\u1EA1n mu\u1ED1n nh\u1EADn ph\u1EA3n h\u1ED3i v\u1EC1 vi\u1EC7c ch\u00FAng t\u00F4i x\u1EED l\u00FD ra sao, h\u00E3y \u0111\u1EC3 l\u1EA1i m\u1ED9t c\u00E1ch li\u00EAn h\u1EC7; nh\u01B0ng \u0111\u00F3 l\u00E0 \u003Cb\u003Et\u00F9y b\u1EA1n\u003C/b\u003E, kh\u00F4ng b\u1EAFt bu\u1ED9c.\u003C/p\u003E\u003Ch3\u003E2. B\u1ED1n lo\u1EA1i l\u1ED7i ch\u00FAng t\u00F4i ti\u1EBFp nh\u1EADn\u003C/h3\u003E\u003Col\u003E\u003Cli\u003E\u003Cp\u003E\u003Cb\u003ESai v\u1EC1 n\u1ED9i dung:\u003C/b\u003E h\u01B0\u1EDBng d\u1EABn sai, n\u00EAu quy \u0111\u1ECBnh sai, s\u1ED1 li\u1EC7u sai.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cb\u003EL\u1EA1c h\u1EADu:\u003C/b\u003E quy \u0111\u1ECBnh \u0111\u00E3 thay \u0111\u1ED5i, quy tr\u00ECnh \u0111\u00E3 kh\u00E1c, s\u1ED1 \u0111i\u1EC7n tho\u1EA1i \u0111\u00E3 \u0111\u1ED5i.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cb\u003EKh\u00F3 hi\u1EC3u ho\u1EB7c d\u1EC5 hi\u1EC3u nh\u1EA7m:\u003C/b\u003E c\u00E2u ch\u1EEF khi\u1EBFn ng\u01B0\u1EDDi \u0111\u1ECDc l\u00E0m sai. Lo\u1EA1i n\u00E0y quan tr\u1ECDng ngang lo\u1EA1i th\u1EE9 nh\u1EA5t, v\u00EC h\u1EADu qu\u1EA3 gi\u1ED1ng nhau.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cb\u003EL\u1ED9 th\u00F4ng tin c\u00E1 nh\u00E2n:\u003C/b\u003E m\u1ED9t b\u00E0i \u0111\u00E3 \u0111\u0103ng c\u00F2n s\u00F3t t\u00EAn, s\u1ED1 \u0111i\u1EC7n tho\u1EA1i, s\u1ED1 t\u00E0i kho\u1EA3n ho\u1EB7c chi ti\u1EBFt nh\u1EADn ra \u0111\u01B0\u1EE3c ng\u01B0\u1EDDi n\u00E0o \u0111\u00F3.\u003C/p\u003E\u003C/li\u003E\u003C/ol\u003E\u003Ch3\u003E3. Th\u1EDDi h\u1EA1n x\u1EED l\u00FD\u003C/h3\u003E\u003Ctable\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth\u003E\u003Cp\u003ELo\u1EA1i l\u1ED7i\u003C/p\u003E\u003C/th\u003E\u003Cth\u003E\u003Cp\u003EC\u1ED1 g\u1EAFng x\u1EED l\u00FD trong\u003C/p\u003E\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp\u003E\u003Cstrong\u003EL\u1ED9 th\u00F4ng tin c\u00E1 nh\u00E2n\u003C/strong\u003E\u003C/p\u003E\u003C/td\u003E\u003Ctd\u003E\u003Cp\u003EG\u1EE1 ho\u1EB7c che ngay khi ti\u1EBFp nh\u1EADn, ch\u1EADm nh\u1EA5t trong ng\u00E0y\u003C/p\u003E\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp\u003E\u003Cstrong\u003ESai n\u1ED9i dung c\u00F3 th\u1EC3 g\u00E2y thi\u1EC7t h\u1EA1i cho ng\u01B0\u1EDDi \u0111\u1ECDc\u003C/strong\u003E\u003C/p\u003E\u003C/td\u003E\u003Ctd\u003E\u003Cp\u003E24 gi\u1EDD\u003C/p\u003E\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp\u003E\u003Cstrong\u003ESai n\u1ED9i dung kh\u00E1c, ho\u1EB7c l\u1EA1c h\u1EADu\u003C/strong\u003E\u003C/p\u003E\u003C/td\u003E\u003Ctd\u003E\u003Cp\u003E03 ng\u00E0y l\u00E0m vi\u1EC7c\u003C/p\u003E\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp\u003E\u003Cstrong\u003EKh\u00F3 hi\u1EC3u, d\u1EC5 hi\u1EC3u nh\u1EA7m\u003C/strong\u003E\u003C/p\u003E\u003C/td\u003E\u003Ctd\u003E\u003Cp\u003E07 ng\u00E0y l\u00E0m vi\u1EC7c\u003C/p\u003E\u003C/td\u003E\u003C/tr\u003E\u003C/tbody\u003E\u003C/table\u003E\u003Cp\u003EN\u1EBFu c\u1EA7n th\u00EAm th\u1EDDi gian \u0111\u1EC3 x\u00E1c minh, ch\u00FAng t\u00F4i \u003Cb\u003Eg\u1EAFn nh\u00E3n c\u1EA3nh b\u00E1o l\u00EAn b\u00E0i\u003C/b\u003E trong th\u1EDDi gian ch\u1EDD, ch\u1EE9 kh\u00F4ng \u0111\u1EC3 b\u00E0i nguy\u00EAn tr\u1EA1ng.\u003C/p\u003E\u003Ch3\u003E4. Ch\u00FAng t\u00F4i c\u1EA3i ch\u00EDnh th\u1EBF n\u00E0o\u003C/h3\u003E\u003Col\u003E\u003Cli\u003E\u003Cp\u003E\u003Cb\u003ES\u1EEDa t\u1EA1i ch\u1ED7\u003C/b\u003E tr\u00EAn ch\u00EDnh b\u00E0i c\u00F3 l\u1ED7i, kh\u00F4ng s\u1EEDa l\u1EB7ng l\u1EBD.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cb\u003EGhi r\u00F5 \u0111\u00E3 s\u1EEDa g\u00EC\u003C/b\u003E \u1EDF cu\u1ED1i b\u00E0i: ng\u00E0y s\u1EEDa \u00B7 n\u1ED9i dung c\u0169 sai \u1EDF \u0111\u00E2u \u00B7 n\u1ED9i dung m\u1EDBi. Kh\u00F4ng x\u00F3a d\u1EA5u v\u1EBFt c\u1EE7a l\u1ED7i.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EV\u1EDBi l\u1ED7i c\u00F3 th\u1EC3 \u0111\u00E3 khi\u1EBFn ng\u01B0\u1EDDi \u0111\u1ECDc l\u00E0m sai, ph\u1EA7n c\u1EA3i ch\u00EDnh \u003Cb\u003E\u0111\u1EB7t \u1EDF \u0111\u1EA7u b\u00E0i\u003C/b\u003E, kh\u00F4ng \u0111\u1EB7t \u1EDF cu\u1ED1i.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EN\u1EBFu b\u00E0i \u0111\u00E3 \u0111\u01B0\u1EE3c in ph\u00E1t tay ho\u1EB7c chia s\u1EBB r\u1ED9ng, \u0111\u0103ng th\u00EAm m\u1ED9t \u003Cb\u003Eth\u00F4ng b\u00E1o c\u1EA3i ch\u00EDnh ri\u00EAng\u003C/b\u003E t\u1EA1i m\u1EE5c C\u1EA2NH B\u00C1O.\u003C/p\u003E\u003C/li\u003E\u003C/ol\u003E\u003Ch3\u003E5. Tr\u01B0\u1EDDng h\u1EE3p ph\u1EA3i g\u1EE1 ngay\u003C/h3\u003E\u003Cp\u003EG\u1EE1 b\u00E0i kh\u1ECFi trang c\u00F4ng khai ngay, kh\u00F4ng ch\u1EDD x\u00E1c minh xong, khi: b\u00E0i l\u00E0m l\u1ED9 th\u00F4ng tin c\u00E1 nh\u00E2n \u00B7 b\u00E0i c\u00F3 h\u01B0\u1EDBng d\u1EABn c\u00F3 th\u1EC3 g\u00E2y thi\u1EC7t h\u1EA1i tr\u1EF1c ti\u1EBFp \u00B7 quy \u0111\u1ECBnh li\u00EAn quan \u0111\u00E3 thay \u0111\u1ED5i l\u00E0m n\u1ED9i dung kh\u00F4ng c\u00F2n \u0111\u00FAng \u00B7 c\u00F3 y\u00EAu c\u1EA7u h\u1EE3p ph\u00E1p c\u1EE7a c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc c\u00F3 th\u1EA9m quy\u1EC1n.\u003C/p\u003E\u003Cp\u003ESau khi g\u1EE1, \u0111\u0103ng m\u1ED9t d\u00F2ng t\u1EA1i v\u1ECB tr\u00ED c\u0169 n\u00F3i r\u00F5 b\u00E0i \u0111\u00E3 \u0111\u01B0\u1EE3c g\u1EE1 v\u00E0 v\u00EC sao \u2014 kh\u00F4ng \u0111\u1EC3 b\u00E0i bi\u1EBFn m\u1EA5t kh\u00F4ng d\u1EA5u v\u1EBFt.\u003C/p\u003E\u003Ch3\u003E6. Y\u00EAu c\u1EA7u t\u1EEB c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc\u003C/h3\u003E\u003Cp\u003EWebsite th\u1EF1c hi\u1EC7n ngay y\u00EAu c\u1EA7u g\u1EE1 ho\u1EB7c ch\u1EC9nh s\u1EEDa n\u1ED9i dung c\u1EE7a c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc c\u00F3 th\u1EA9m quy\u1EC1n.\u003C/p\u003E\u003Ch3\u003E7. Ghi l\u1EA1i vi\u1EC7c \u0111\u00E3 s\u1EEDa\u003C/h3\u003E\u003Cp\u003EM\u1ED7i l\u1EA7n c\u1EA3i ch\u00EDnh \u0111\u01B0\u1EE3c ghi ngay tr\u00EAn b\u00E0i \u0111\u00E3 s\u1EEDa: ng\u00E0y s\u1EEDa v\u00E0 n\u1ED9i dung \u0111\u00E3 s\u1EEDa.\u003C/p\u003E\u003Cp\u003EL\u00FD do: m\u1ED9t website h\u01B0\u1EDBng d\u1EABn ng\u01B0\u1EDDi d\u00E2n ki\u1EC3m ch\u1EE9ng th\u00EC ph\u1EA3i \u0111\u1EC3 ng\u01B0\u1EDDi d\u00E2n ki\u1EC3m ch\u1EE9ng \u0111\u01B0\u1EE3c ch\u00EDnh n\u00F3.\u003C/p\u003E\u003Ch3\u003E8. N\u1EBFu b\u1EA1n kh\u00F4ng \u0111\u1ED3ng \u00FD v\u1EDBi c\u00E1ch ch\u00FAng t\u00F4i x\u1EED l\u00FD\u003C/h3\u003E\u003Cp\u003EH\u00E3y g\u1EEDi l\u1EA1i qua m\u1EE5c G\u00F3p \u00FD v\u00E0 n\u00F3i r\u00F5 b\u1EA1n kh\u00F4ng \u0111\u1ED3ng \u00FD \u1EDF \u0111i\u1EC3m n\u00E0o. N\u1EBFu v\u1EABn ch\u01B0a th\u1ECFa \u0111\u00E1ng, b\u1EA1n c\u00F3 quy\u1EC1n khi\u1EBFu n\u1EA1i t\u1EDBi c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc c\u00F3 th\u1EA9m quy\u1EC1n theo quy \u0111\u1ECBnh c\u1EE7a ph\u00E1p lu\u1EADt.\u003C/p\u003E"
}]]></Value>
