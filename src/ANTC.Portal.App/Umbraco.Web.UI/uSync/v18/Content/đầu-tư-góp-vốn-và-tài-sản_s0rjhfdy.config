    <actionPage>
      <Value><![CDATA[]]></Value>
    </actionPage>
    <actionsNow>
      <Value><![CDATA[Nếu đang bị đòi nộp thêm một khoản mới rút tiền ra được — “thuế xác minh”, “phí mở khóa”, “nâng gói VIP” — thì dừng lại, đừng nộp. Đọc thẳng mục “Nếu đã lỡ” ở cuối bài trước, rồi quay lại đọc từ đầu sau.
Chụp lại lời mời, không tranh luận tiếp trong nhóm.]]></Value>
    </actionsNow>
    <alsoInCategories>
      <Value><![CDATA[]]></Value>
    </alsoInCategories>
    <articleKind>
      <Value><![CDATA[[
  "B\u00E0i h\u01B0\u1EDBng d\u1EABn"
]]]></Value>
    </articleKind>
    <avoidActions>
      <Value><![CDATA[Không nộp thêm để rút
Không đọc mã, không cấp quyền
Không chuyển vào tài khoản cá nhân
Không vay, không thế chấp để góp
Không rủ người nhà khi mình chưa kiểm xong]]></Value>
    </avoidActions>
    <canonicalUrl>
      <Value><![CDATA[]]></Value>
    </canonicalUrl>
    <description>
      <Value><![CDATA[Ba câu trở đi trở lại: lợi nhuận ở đâu ra, ai có nghĩa vụ trả tiền cho mình, và muốn rút thì rút bằng cách nào.]]></Value>
    </description>
