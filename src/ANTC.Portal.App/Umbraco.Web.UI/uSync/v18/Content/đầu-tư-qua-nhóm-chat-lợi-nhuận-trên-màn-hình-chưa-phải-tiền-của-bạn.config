    <safeAction>
      <Value><![CDATA[Dừng nạp tiền khi bị yêu cầu đóng thêm phí để rút. Kiểm tra đơn vị và kênh giao dịch độc lập; không dựa riêng vào nhóm chat, ảnh giấy phép hoặc số dư hiển thị.]]></Value>
    </safeAction>
    <seoDescription>
      <Value><![CDATA[Nhận diện lời mời đầu tư qua nhóm kín, khoản lãi hiển thị và yêu cầu nộp thêm tiền để rút vốn; tự kiểm tra trước khi quyết định.]]></Value>
