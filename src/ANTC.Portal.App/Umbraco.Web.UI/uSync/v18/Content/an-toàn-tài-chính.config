        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kh\u00F4ng h\u1ECFi m\u1EADt kh\u1EA9u, m\u00E3 x\u00E1c th\u1EF1c ho\u1EB7c s\u1ED1 t\u00E0i kho\u1EA3n c\u1EE7a b\u1EA1n."
