    <methodsItems>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "58546d2c-4c5c-5686-bc37-ce4cfeb23343",
      "key": "7edfb35a-663c-5f27-a627-c7e1bb41ffef",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u00F3ng vai ng\u01B0\u1EDDi c\u00F3 quy\u1EC1n"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00F4ng an, t\u00F2a \u00E1n, ng\u00E2n h\u00E0ng, c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc, nh\u00E2n vi\u00EAn c\u1EE7a m\u1ED9t \u0111\u01A1n v\u1ECB, c\u1EA5p tr\u00EAn."
        },
        {
          "alias": "iconKey",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "C\u01A1 quan, t\u1ED5 ch\u1EE9c"
          ]
        },
        {
          "alias": "isWarning",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "0"
        }
      ]
    },
    {
      "contentTypeKey": "58546d2c-4c5c-5686-bc37-ce4cfeb23343",
      "key": "52e6be0b-b7ce-52d6-8e24-630841382f6b",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u00F3ng vai ng\u01B0\u1EDDi quen"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Chi\u1EBFm t\u00E0i kho\u1EA3n c\u1EE7a ng\u01B0\u1EDDi th\u00E2n, gi\u1EA3 con ch\u00E1u, ho\u1EB7c l\u00E0m quen l\u00E2u ng\u00E0y \u0111\u1EC3 t\u1EA1o tin c\u1EADy."
        },
        {
          "alias": "iconKey",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "Ng\u01B0\u1EDDi quen"
          ]
        },
        {
          "alias": "isWarning",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "0"
        }
      ]
    },
    {
      "contentTypeKey": "58546d2c-4c5c-5686-bc37-ce4cfeb23343",
      "key": "0aa37262-219b-5b1a-89ba-56d09af8f3d9",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "H\u1EE9a cho b\u1EA1n \u0111\u01B0\u1EE3c nhi\u1EC1u h\u01A1n"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "L\u00E3i cao, hoa h\u1ED3ng, tr\u00FAng th\u01B0\u1EDFng, vi\u1EC7c nh\u1EB9 l\u01B0\u01A1ng cao, vay d\u1EC5, ti\u1EC1n c\u00F4ng."
        },
        {
          "alias": "iconKey",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "L\u1EE3i nhu\u1EADn"
          ]
        },
        {
          "alias": "isWarning",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "0"
        }
      ]
    },
    {
      "contentTypeKey": "58546d2c-4c5c-5686-bc37-ce4cfeb23343",
      "key": "4fe189c2-20b7-554e-87a4-fe83c9fc8d42",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Cho b\u1EA1n n\u1EBFm th\u1EED th\u1EADt"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tr\u1EA3 hoa h\u1ED3ng \u0111\u01A1n \u0111\u1EA7u, cho r\u00FAt th\u1EED m\u1ED9t l\u1EA7n, cho l\u00E3i v\u00E0i k\u1EF3 \u0111\u1EA7u. \u0110\u1EBFn khi b\u1EA1n tin v\u00E0 b\u1ECF s\u1ED1 ti\u1EC1n l\u1EDBn th\u00EC m\u1EA5t."
        },
        {
          "alias": "iconKey",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "Kh\u00F3a"
          ]
        },
        {
          "alias": "isWarning",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "1"
        }
      ]
    },
    {
      "contentTypeKey": "58546d2c-4c5c-5686-bc37-ce4cfeb23343",
      "key": "57f7f3e5-25c2-5203-9280-096313e40e09",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "D\u1ECDa b\u1EA1n s\u1EAFp m\u1EA5t"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "D\u00EDnh \u00E1n, b\u1ECB ph\u1EA1t, b\u1ECB kh\u00F3a t\u00E0i kho\u1EA3n, m\u1EA5t h\u00E0ng, m\u1EA5t vi\u1EC7c."
        },
        {
          "alias": "iconKey",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "C\u1EA3nh b\u00E1o"
          ]
        },
        {
          "alias": "isWarning",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "0"
        }
      ]
    },
    {
      "contentTypeKey": "58546d2c-4c5c-5686-bc37-ce4cfeb23343",
      "key": "92f5b130-50fa-5f6f-84b1-983a363cc17f",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Gi\u1EEF ti\u1EC1n ho\u1EB7c h\u00E0ng r\u1ED3i \u0111\u00F2i ph\u00ED \u0111\u1EC3 th\u1EA3 ra"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ph\u00ED r\u00FAt, ph\u00ED m\u1EDF kh\u00F3a, ti\u1EC1n x\u00E1c minh, ti\u1EC1n b\u1EA3o l\u00E3nh."
        },
        {
          "alias": "iconKey",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "Ph\u00ED, thanh to\u00E1n"
          ]
        },
        {
          "alias": "isWarning",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "0"
        }
      ]
    },
    {
      "contentTypeKey": "58546d2c-4c5c-5686-bc37-ce4cfeb23343",
      "key": "63564bdd-8929-5431-8341-620b7b3d1571",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u01B0a b\u1EB1ng ch\u1EE9ng gi\u1EA3"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Bi\u00EAn lai gi\u1EA3, gi\u1EA5y t\u1EDD gi\u1EA3, website gi\u1EA3, \u1EE9ng d\u1EE5ng gi\u1EA3."
        },
        {
          "alias": "iconKey",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "Gi\u1EA5y t\u1EDD"
          ]
        },
        {
          "alias": "isWarning",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "0"
        }
      ]
    }
  ],
