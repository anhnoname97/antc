  <Properties>
    <actions>
      <Value><![CDATA[<p>Với ứng dụng cho vay, xem thêm quyền mà nó đòi. Quyền nào không cần cho chức năng rõ ràng thì không cấp.</p>]]></Value>
    </actions>
    <approvedBy>
      <Value><![CDATA[Ban biên tập]]></Value>
    </approvedBy>
    <question>
      <Value><![CDATA[Ứng dụng vay đòi nộp phí trước rồi mới giải ngân. Có nên nộp?]]></Value>
    </question>
    <reason>
      <Value><![CDATA[<p>Ba con số phải ghi ra giấy trước khi quyết: số thực nhận là tiền thật sự về tay sau khi trừ phí, bảo hiểm và khoản giữ lại; tổng phải trả gồm gốc, lãi, phí và bảo hiểm cộng lại; mỗi kỳ trả là số phải nộp mỗi lần theo lịch.</p>]]></Value>
    </reason>
    <relatedPages>
      <Value><![CDATA[]]></Value>
    </relatedPages>
    <shortAnswer>
      <Value><![CDATA[Chưa nộp. Xem tiền chảy về phía nào. Bạn phải nộp tiền trước thì dừng lại.]]></Value>
    </shortAnswer>
  </Properties>
</Content>
