    <bankListNote>
      <Value><![CDATA[Danh sách này là tiện ích, không phải chỗ dựa duy nhất. Số in ở mặt sau thẻ và số trong ứng dụng bạn đã cài từ trước vẫn chắc chắn hơn.]]></Value>
    </bankListNote>
    <bankListRules>
      <Value><![CDATA[Cách tự tìm số ở trên đúng với mọi ngân hàng, kể cả ngân hàng không có trong danh sách. Mỗi số dưới đây chỉ được đăng khi chép lại từ văn bản hoặc cổng thông tin của cơ quan nhà nước, kèm ngày kiểm chứng gần nhất.]]></Value>
    </bankListRules>
