    </illustration>
    <illustrationAlt>
      <Value><![CDATA[Ảnh minh họa tình huống tự bảo vệ trước rủi ro tài chính]]></Value>
    </illustrationAlt>
    <lead>
      <Value><![CDATA[Đây có thể là chuyển nhầm thật, cũng có thể là một thủ đoạn. Trong cả hai trường hợp, việc cần làm giống nhau.]]></Value>
    </lead>
    <reviewDate>
      <Value><![CDATA[2026-10-20T00:00:00]]></Value>
    </reviewDate>
    <screeningQuestions>
      <Value><![CDATA[[
  {
    "key": "835d242c-dcb7-5537-a0f0-71edee0e7863",
    "question": "Ng\u01B0\u1EDDi \u0111\u00F3 c\u00F3 \u0111e d\u1ECDa b\u1EA1n kh\u00F4ng?",
    "buttonText": "C\u00F3 \u2014 xem vi\u1EC7c c\u1EA7n l\u00E0m khi b\u1ECB \u0111e d\u1ECDa",
    "note": "B\u1ECB \u0111e d\u1ECDa l\u00E0 chuy\u1EC7n kh\u00E1c v\u00E0 c\u1EA7n x\u1EED l\u00FD theo h\u01B0\u1EDBng kh\u00E1c.",
    "targetPage": "umb://document/68706bf34b275b5aa587ccccb499a810"
  }
]]]></Value>
