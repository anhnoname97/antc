    <steps>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "ab9ac814-fe8a-5a67-ae5e-a5df1556d678",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kh\u00F4ng ti\u00EAu, kh\u00F4ng r\u00FAt, kh\u00F4ng chuy\u1EC3n kho\u1EA3n ti\u1EC1n \u0111\u00F3 \u0111i \u0111\u00E2u."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "fd08de5c-b593-5a54-a27e-0bd43b2b1aeb",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kh\u00F4ng chuy\u1EC3n tr\u1EA3 theo s\u1ED1 t\u00E0i kho\u1EA3n m\u00E0 ng\u01B0\u1EDDi g\u1ECDi \u0111i\u1EC7n \u0111\u01B0a cho b\u1EA1n \u2014 k\u1EC3 c\u1EA3 khi h\u1ECD n\u00F3i l\u00E0 chuy\u1EC3n nh\u1EA7m."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00E1ch th\u01B0\u1EDDng g\u1EB7p: h\u1ECD chuy\u1EC3n ti\u1EC1n v\u00E0o, sau \u0111\u00F3 g\u1ECDi \u0111\u00F2i l\u1EA1i k\u00E8m ti\u1EC1n l\u00E3i, ho\u1EB7c y\u00EAu c\u1EA7u b\u1EA1n chuy\u1EC3n sang m\u1ED9t t\u00E0i kho\u1EA3n kh\u00E1c. Khi \u0111\u00F3 b\u1EA1n v\u1EEBa m\u1EA5t ti\u1EC1n, v\u1EEBa d\u00EDnh v\u00E0o \u0111\u01B0\u1EDDng \u0111i c\u1EE7a ti\u1EC1n kh\u00F4ng r\u00F5 ngu\u1ED3n g\u1ED1c."
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "4b99a30a-67d9-528e-a21c-a7dd82096742",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Li\u00EAn h\u1EC7 ng\u00E2n h\u00E0ng c\u1EE7a ch\u00EDnh b\u1EA1n \u0111\u1EC3 b\u00E1o c\u00F3 kho\u1EA3n ti\u1EC1n l\u1EA1 v\u00E0 \u0111\u1EC1 ngh\u1ECB h\u01B0\u1EDBng d\u1EABn x\u1EED l\u00FD."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00F3 th\u1EBB ng\u00E2n h\u00E0ng: l\u1EADt m\u1EB7t sau th\u1EBB, g\u1ECDi s\u1ED1 ch\u0103m s\u00F3c kh\u00E1ch h\u00E0ng in tr\u00EAn th\u1EBB.\nKh\u00F4ng c\u00F3 th\u1EBB: m\u1EDF \u1EE9ng d\u1EE5ng ng\u00E2n h\u00E0ng b\u1EA1n \u0111\u00E3 c\u00E0i t\u1EEB tr\u01B0\u1EDBc, v\u00E0o m\u1EE5c Tr\u1EE3 gi\u00FAp ho\u1EB7c Li\u00EAn h\u1EC7.\nLu\u00F4n lu\u00F4n: kh\u00F4ng b\u1EA5m \u0111\u01B0\u1EDDng link v\u00E0 kh\u00F4ng g\u1ECDi s\u1ED1 do ng\u01B0\u1EDDi kia g\u1EEDi."
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u00E0i kho\u1EA3n c\u1EE7a t\u00F4i v\u1EEBa nh\u1EADn m\u1ED9t kho\u1EA3n ti\u1EC1n kh\u00F4ng r\u00F5 ngu\u1ED3n g\u1ED1c. T\u00F4i ch\u01B0a s\u1EED d\u1EE5ng kho\u1EA3n n\u00E0y. Xin h\u01B0\u1EDBng d\u1EABn c\u00E1ch x\u1EED l\u00FD v\u00E0 ghi nh\u1EADn s\u1EF1 vi\u1EC7c."
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "ec4a3613-7f5a-5091-adfb-f3060654f862",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u1EC9 ho\u00E0n tr\u1EA3 theo \u0111\u00FAng c\u00E1ch ng\u00E2n h\u00E0ng h\u01B0\u1EDBng d\u1EABn, ho\u1EB7c theo h\u01B0\u1EDBng d\u1EABn c\u1EE7a c\u01A1 quan c\u00F3 th\u1EA9m quy\u1EC1n."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u00E2y l\u00E0 \u0111i\u1EC1u nhi\u1EC1u ng\u01B0\u1EDDi ch\u01B0a bi\u1EBFt, n\u00EAn b\u1ECB thuy\u1EBFt ph\u1EE5c chuy\u1EC3n th\u1EB3ng. Kh\u00F4ng chuy\u1EC3n th\u1EB3ng cho ng\u01B0\u1EDDi l\u1EA1, kh\u00F4ng chuy\u1EC3n sang m\u1ED9t t\u00E0i kho\u1EA3n kh\u00E1c, v\u00E0 kh\u00F4ng tr\u1EA3 th\u00EAm b\u1EA5t k\u1EF3 kho\u1EA3n l\u00E3i hay ph\u00ED n\u00E0o."
        },
        {
          "alias": "quote",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "noticeTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "ee230f5e-3bd0-5c0b-aebf-28c344b66508",
      "key": "3acb0d17-4790-5e7a-ac7a-e4ca78f01116",
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Gi\u1EEF nguy\u00EAn tin nh\u1EAFn b\u00E1o c\u00F3 ti\u1EC1n v\u00E0 m\u1ECDi li\u00EAn h\u1EC7 c\u1EE7a ng\u01B0\u1EDDi \u0111\u00F2i l\u1EA1i ti\u1EC1n."
        },
        {
          "alias": "details",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "quote",
