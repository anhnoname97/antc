        {
          "alias": "ticketDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "L\u00E0m b\u00E0i tr\u00EAn \u0111i\u1EC7n tho\u1EA1i ho\u1EB7c m\u00E1y t\u00EDnh, kh\u00F4ng c\u1EA7n c\u00E0i \u1EE9ng d\u1EE5ng."
        },
        {
          "alias": "promises",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kh\u00F4ng thu b\u1EA5t k\u1EF3 kho\u1EA3n ph\u00ED n\u00E0o\nKh\u00F4ng h\u1ECFi m\u1EADt kh\u1EA9u, m\u00E3 OTP, s\u1ED1 t\u00E0i kho\u1EA3n\nCh\u1EC9 thi tr\u00EAn antoantaichinh.vn"
