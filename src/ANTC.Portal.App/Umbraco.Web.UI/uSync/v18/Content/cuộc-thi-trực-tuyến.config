        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Th\u1EED s\u1EE9c: 8 c\u00E2u"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "M\u1ED7i chuy\u00EAn \u0111\u1EC1 m\u1ED9t c\u00E2u. Ch\u1ECDn xong l\u00E0 c\u00F3 gi\u1EA3i th\u00EDch ngay."
        },
        {
          "alias": "notice",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "8 c\u00E2u h\u1ECFi \u0111\u01B0\u1EE3c l\u1EA5y t\u1EEB ng\u00E2n h\u00E0ng c\u00E2u h\u1ECFi c\u1EE7a ch\u01B0\u01A1ng tr\u00ECnh."
        },
        {
          "alias": "inviteLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Thi th\u1EADt \u00B7 th\u00E1ng 10/2026"
        },
        {
          "alias": "inviteText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "200 c\u00E2u, chuy\u00EAn \u0111\u1EC1 Vi\u1EC7c l\u00E0m, l\u00E0m th\u00EAm. C\u00F3 x\u00E9t th\u01B0\u1EDFng."
        },
        {
          "alias": "inviteNotice",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kh\u00F4ng thu ph\u00ED, kh\u00F4ng h\u1ECFi m\u00E3 OTP, kh\u00F4ng g\u1ECDi b\u00E1o tr\u00FAng th\u01B0\u1EDFng."
        },
        {
          "alias": "entryLink",
          "culture": null,
          "editorAlias": null,
          "segment": null,
