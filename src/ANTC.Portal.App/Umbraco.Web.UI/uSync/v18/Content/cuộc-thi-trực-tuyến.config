          "segment": null,
          "value": "G\u00F3p \u00FD"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "G\u00F3p \u00FD cho Ch\u01B0\u01A1ng tr\u00ECnh"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u1EA8n danh. M\u1ED9t c\u00E2u ng\u1EAFn c\u0169ng qu\u00FD. Giai \u0111o\u1EA1n \u0111\u1EA7u c\u00F3 x\u00E9t th\u01B0\u1EDFng."
        },
        {
          "alias": "placeholder",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "B\u1EA1n mu\u1ED1n website gi\u1EA3i th\u00EDch th\u00EAm \u0111i\u1EC1u g\u00EC?"
        },
        {
          "alias": "warning",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u1EEBng vi\u1EBFt m\u1EADt kh\u1EA9u, m\u00E3 OTP, s\u1ED1 t\u00E0i kho\u1EA3n."
        },
        {
          "alias": "buttonLabel",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "G\u1EEDi g\u00F3p \u00FD \u27F6"
        },
        {
          "alias": "confirmation",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Ban bi\u00EAn t\u1EADp \u0111\u00E3 nh\u1EADn \u0111\u01B0\u1EE3c g\u00F3p \u00FD c\u1EE7a b\u1EA1n. C\u1EA3m \u01A1n b\u1EA1n \u0111\u00E3 g\u00F3p ph\u1EA7n x\u00E2y d\u1EF1ng Ch\u01B0\u01A1ng tr\u00ECnh."
        }
      ]
    },
