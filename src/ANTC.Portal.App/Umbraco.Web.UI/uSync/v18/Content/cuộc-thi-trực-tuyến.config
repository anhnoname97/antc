          "segment": null,
          "value": "Cu\u1ED9c thi tr\u1EF1c tuy\u1EBFn"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "200 c\u00E2u h\u1ECFi,"
        },
        {
          "alias": "titleAccent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "8 chuy\u00EAn \u0111\u1EC1"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "M\u1ED7i c\u00E2u h\u1ECFi gi\u00FAp b\u1EA1n nh\u1EADn ra m\u1ED9t d\u1EA5u hi\u1EC7u l\u1EEBa \u0111\u1EA3o. M\u1ED7i s\u1ED1 \u0111i\u1EC7n tho\u1EA1i thi t\u1ED1i \u0111a 2 l\u01B0\u1EE3t. Giai \u0111o\u1EA1n \u0111\u1EA7u c\u00F3 x\u00E9t th\u01B0\u1EDFng."
        },
        {
          "alias": "questionCount",
