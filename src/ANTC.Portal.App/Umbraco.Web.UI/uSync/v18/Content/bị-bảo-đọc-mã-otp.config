  <Properties>
    <answer>
      <Value><![CDATA[<p>Không đọc. Nhân viên ngân hàng không yêu cầu khách đọc mã OTP để khóa tài khoản. Hãy cúp máy, rồi tự gọi số in ở mặt sau thẻ hoặc tự mở ứng dụng ngân hàng để hỏi.</p>]]></Value>
    </answer>
    <label>
      <Value><![CDATA[Ví dụ cách trình bày]]></Value>
    </label>
    <question>
      <Value><![CDATA[Người gọi xưng là nhân viên ngân hàng, bảo tôi đọc mã OTP để khóa tài khoản đang bị xâm nhập. Có nên đọc?]]></Value>
    </question>
    <relatedLink>
      <Value><![CDATA[]]></Value>
    </relatedLink>
  </Properties>
</Content>