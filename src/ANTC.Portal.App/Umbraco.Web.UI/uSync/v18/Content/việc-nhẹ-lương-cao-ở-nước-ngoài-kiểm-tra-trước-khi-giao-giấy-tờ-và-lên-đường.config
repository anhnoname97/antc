    <safeAction>
      <Value><![CDATA[Chưa giao giấy tờ hoặc lên đường khi chưa xác minh đơn vị tuyển dụng, hợp đồng và thủ tục xuất nhập cảnh.]]></Value>
    </safeAction>
    <seoDescription>
      <Value><![CDATA[Cảnh giác lời mời xuất cảnh nhanh, không cần hợp đồng rõ ràng hoặc đi theo đường vòng; xác minh đơn vị tuyển và nơi làm việc.]]></Value>
