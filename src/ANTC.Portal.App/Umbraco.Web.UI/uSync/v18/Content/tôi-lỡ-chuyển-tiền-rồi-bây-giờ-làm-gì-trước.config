    <SortOrder>4</SortOrder>
    <Published Default="true" />
    <Schedule />
    <Template />
  </Info>
  <Properties>
    <actions>
      <Value><![CDATA[<p>Câu nói mẫu với tổng đài: “Tôi vừa chuyển tiền và nghi có rủi ro lừa đảo. Xin ghi nhận sự việc, tra soát giao dịch và hướng dẫn tôi cách bảo vệ tài khoản.”</p>]]></Value>
    </actions>
    <approvedBy>
      <Value><![CDATA[Ban biên tập]]></Value>
    </approvedBy>
    <question>
      <Value><![CDATA[Tôi lỡ chuyển tiền rồi. Bây giờ làm gì trước?]]></Value>
    </question>
    <reason>
      <Value><![CDATA[<p>Gọi càng sớm thì ngân hàng càng có cơ hội tra soát giao dịch. Số đúng là số bạn tự lấy từ thẻ hoặc ứng dụng của chính mình.</p>]]></Value>
    </reason>
    <relatedPages>
      <Value><![CDATA[]]></Value>
    </relatedPages>
    <shortAnswer>
      <Value><![CDATA[Gọi ngay ngân hàng hoặc ví điện tử bạn đã chuyển. Làm bước này trước, rồi mới làm các bước còn lại.]]></Value>
    </shortAnswer>
  </Properties>
</Content>
