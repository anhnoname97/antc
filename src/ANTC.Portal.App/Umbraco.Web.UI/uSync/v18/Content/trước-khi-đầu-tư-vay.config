                    "editorAlias": null,
                    "segment": null,
                    "value": "khong"
                  }
                ]
              },
              {
                "contentTypeKey": "43af497a-991d-51b6-a1b6-2e0c58ef0679",
                "key": "4307a01b-db0f-5b72-aa1f-9c99e4801564",
                "values": [
                  {
                    "alias": "label",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "T\u00F4i ch\u01B0a bi\u1EBFt"
                  },
                  {
