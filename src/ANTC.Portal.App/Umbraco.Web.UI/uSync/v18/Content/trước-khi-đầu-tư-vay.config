    <lead>
      <Value><![CDATA[5 câu hỏi trước khi góp vốn, đầu tư hoặc ký khoản vay. Mỗi lần một câu. Không chắc thì chọn “Tôi chưa biết”.]]></Value>
    </lead>
    <more>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "6d4a7ebb-ca6b-518e-a3c8-d87f04cac081",
      "key": "b451605f-b984-5099-a526-7c10ef6aac61",
      "values": [
        {
          "alias": "ic",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "icon-chart"
        },
        {
          "alias": "nhan",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "C\u00F3 ng\u01B0\u1EDDi m\u1EDDi b\u1EA1n g\u00F3p v\u1ED1n, \u0111\u1EA7u t\u01B0"
        },
        {
          "alias": "trang",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "umb://document/859cf6531aee56c9a130e2176e1f7e77"
        }
      ]
    },
    {
      "contentTypeKey": "6d4a7ebb-ca6b-518e-a3c8-d87f04cac081",
      "key": "86f4ec5a-a3a5-5183-a55a-6043ba9d06af",
      "values": [
        {
          "alias": "ic",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "icon-help-alt"
        },
        {
          "alias": "nhan",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Danh s\u00E1ch ki\u1EC3m tra: Tr\u01B0\u1EDBc khi \u0111\u1EA7u t\u01B0, g\u00F3p v\u1ED1n"
        },
        {
          "alias": "trang",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "umb://document/61166428080d5889a45f497578705cfa"
        }
      ]
    },
    {
      "contentTypeKey": "6d4a7ebb-ca6b-518e-a3c8-d87f04cac081",
      "key": "62cbadef-adbe-5e81-a829-3b33c67e4bf8",
      "values": [
        {
          "alias": "ic",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "icon-help-alt"
        },
        {
          "alias": "nhan",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Danh s\u00E1ch ki\u1EC3m tra: Tr\u01B0\u1EDBc khi vay, b\u1EA3o l\u00E3nh, \u0111\u1EE9ng t\u00EAn"
        },
        {
          "alias": "trang",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "umb://document/14fc28be7aaf595fa9d95e02c237cb8a"
        }
      ]
    },
    {
      "contentTypeKey": "6d4a7ebb-ca6b-518e-a3c8-d87f04cac081",
      "key": "d465a993-943a-5239-af79-72ea72d69e62",
