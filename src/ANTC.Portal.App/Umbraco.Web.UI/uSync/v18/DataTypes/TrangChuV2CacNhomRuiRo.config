  <Info>
    <Name>Trang chủ V2 · Các nhóm rủi ro</Name>
    <EditorAlias>Umbraco.Label</EditorAlias>
    <EditorUIAlias>Antc.PropertyEditorUi.EmergencyInfo</EditorUIAlias>
  </Info>
  <Config><![CDATA[{
  "linkLabel": "M\u1EDF C\u00E1c r\u1EE7i ro \u0111\u1EC3 ch\u1EC9nh c\u00E1c nh\u00F3m",
  "message": "Th\u1EBB nh\u00F3m l\u1EA5y t\u1EEB 5 trang trong C\u00E1c r\u1EE7i ro: L\u1EEBa \u0111\u1EA3o; Vay v\u00E0 n\u1EE3; \u0110\u1EA7u t\u01B0; B\u1EA3o hi\u1EC3m v\u00E0 ti\u1EBFt ki\u1EC7m; D\u1EEF li\u1EC7u c\u00E1 nh\u00E2n. Ch\u1EC9nh t\u00EAn, m\u00F4 t\u1EA3, bi\u1EC3u t\u01B0\u1EE3ng v\u00E0 \u1EA3nh t\u1EA1i t\u1EEBng nh\u00F3m. Khi d\u1EF1ng trang ch\u1EE7, s\u1ED1 b\u00E0i \u0111\u01B0\u1EE3c \u0111\u1EBFm t\u1EF1 \u0111\u1ED9ng; ch\u1EC9 d\u00F9ng n\u1ED9i dung \u0111\u00E3 xu\u1EA5t b\u1EA3n. Kh\u00F4ng c\u1EA7n nh\u1EADp l\u1EA1i n\u1ED9i dung th\u1EBB t\u1EA1i \u0111\u00E2y.",
  "target": "2f0dfb61-9591-4d14-970a-6be6f7d4b28c",
  "umbracoDataValueType": "STRING"
}]]></Config>
</DataType>