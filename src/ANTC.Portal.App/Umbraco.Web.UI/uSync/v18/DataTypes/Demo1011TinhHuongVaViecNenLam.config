<?xml version="1.0" encoding="utf-8"?>
<DataType Key="00bd3a40-2f27-5f38-a9cb-2024541478c9" Alias="Demo 10-11 · Tình huống và việc nên làm" Level="1">
  <Info>
    <Name>Demo 10-11 · Tình huống và việc nên làm</Name>
    <EditorAlias>Antc.InlineList</EditorAlias>
    <EditorUIAlias>Antc.PropertyEditorUi.EmergencyList</EditorUIAlias>
  </Info>
  <Config><![CDATA[{
  "fields": [
    {
      "alias": "id",
      "label": "M\u00E3 t\u00ECnh hu\u1ED1ng",
      "type": "text",
      "required": true,
      "pattern": "^[a-z0-9]\u002B(?:-[a-z0-9]\u002B)*$"
    },
    {
      "alias": "title",
      "label": "T\u00ECnh hu\u1ED1ng",
      "type": "area",
      "required": true
    },
    {
      "alias": "group",
      "label": "Nh\u00F3m",
      "type": "fixed",
      "options": [
        [
          "co-quan",
          "T\u1EF1 x\u01B0ng c\u00F4ng an, ng\u00E2n h\u00E0ng, c\u01A1 quan, nh\u00E0 tr\u01B0\u1EDDng, nh\u00E0 m\u1EA1ng"
        ],
        [
          "nguoi-quen",
          "Ng\u01B0\u1EDDi th\u00E2n, b\u1EA1n b\u00E8, c\u1EA5p tr\u00EAn c\u1EA7n ti\u1EC1n g\u1EA5p"
        ],
        [
          "lien-ket",
          "\u0110\u01B0\u1EDDng d\u1EABn, m\u00E3 QR, \u1EE9ng d\u1EE5ng, t\u00E0i kho\u1EA3n m\u1EA1ng x\u00E3 h\u1ED9i"
        ],
        [
          "viec-lam",
          "Vi\u1EC7c l\u00E0m, l\u00E0m th\u00EAm, nhi\u1EC7m v\u1EE5 tr\u00EAn m\u1EA1ng"
        ],
        [
          "dau-tu",
          "\u0110\u1EA7u t\u01B0, g\u00F3p v\u1ED1n, ti\u1EC1n s\u1ED1, ch\u01A1i h\u1EE5i, c\u00E1 c\u01B0\u1EE3c"
        ],
        [
          "vay-no",
          "Vay ti\u1EC1n, \u0111\u00F2i n\u1EE3, th\u1EBB t\u00EDn d\u1EE5ng"
        ],
        [
          "mua-ban",
          "Mua b\u00E1n, \u0111\u1EB7t c\u1ECDc, thu\u00EA nh\u00E0, d\u1ECBch v\u1EE5"
        ],
        [
          "qua-tang",
          "Tr\u00FAng th\u01B0\u1EDFng, t\u1EEB thi\u1EC7n, s\u1EE9c kh\u1ECFe, t\u00E2m linh, \u201Clo vi\u1EC7c\u201D"
        ],
        [
          "de-doa",
          "B\u1ECB \u0111e d\u1ECDa, t\u1ED1ng ti\u1EC1n, b\u1ECB \u00E9p gi\u1EEF b\u00ED m\u1EADt"
        ],
        [
          "da-lo",
          "\u0110\u00E3 c\u00F3 chuy\u1EC7n: ti\u1EC1n l\u1EA1, gi\u1EA5y t\u1EDD b\u1ECB d\u00F9ng, \u0111\u00E3 b\u1ECB l\u1EEBa"
        ],
        [
          "doanh-nghiep",
          "Doanh nghi\u1EC7p, c\u1EEDa h\u00E0ng: t\u00F4i b\u00E1n h\u00E0ng, t\u00F4i thanh to\u00E1n cho \u0111\u1ED1i t\u00E1c, t\u00F4i l\u00E0m k\u1EBF to\u00E1n"
        ],
        [
          "truc-tiep",
          "G\u1EB7p tr\u1EF1c ti\u1EBFp ngo\u00E0i \u0111\u01B0\u1EDDng, t\u1EA1i nh\u00E0"
        ]
      ],
      "required": true
    },
    {
      "alias": "keywords",
      "label": "T\u1EEB kh\u00F3a t\u00ECm ki\u1EBFm",
      "type": "area"
    },
    {
      "alias": "level",
      "label": "M\u1EE9c x\u1EED l\u00FD",
      "type": "fixed",
      "options": [
        [
          "d",
          "D\u1EEBng"
        ],
        [
          "h",
          "Ho\u00E3n v\u00E0 ki\u1EC3m ch\u1EE9ng"
        ],
        [
          "n",
          "Ch\u01B0a ph\u00E1t hi\u1EC7n \u0111i\u1EC3m d\u1EEBng"
        ]
      ],
      "required": true
    },
    {
      "alias": "firstAction",
      "label": "Vi\u1EC7c n\u00EAn l\u00E0m tr\u01B0\u1EDBc ti\u00EAn",
      "type": "area",
      "required": true
    },
    {
      "alias": "why",
      "label": "V\u00EC sao",
      "type": "area",
      "required": true
    },
    {
      "alias": "signs",
      "label": "D\u1EA5u hi\u1EC7u li\u00EAn quan",
      "type": "lines"
    },
    {
      "alias": "nextActions",
      "label": "Vi\u1EC7c ti\u1EBFp theo \u2014 m\u1ED7i d\u00F2ng m\u1ED9t vi\u1EC7c",
      "type": "lines"
    },
    {
      "alias": "avoidActions",
      "label": "\u0110\u1EEBng l\u00E0m \u2014 m\u1ED7i d\u00F2ng m\u1ED9t vi\u1EC7c",
      "type": "lines"
    },
    {
      "alias": "preselected",
      "label": "\u0110i\u1EC1u \u0111\u00E3 x\u1EA3y ra \u0111\u01B0\u1EE3c ch\u1ECDn s\u1EB5n",
      "type": "lines",
      "options": [
        [
          "threat",
          "\u0110ang b\u1ECB \u0111e d\u1ECDa, b\u1ECB \u00E9p \u1EDF m\u1ED9t m\u00ECnh, ho\u1EB7c b\u1ECB b\u1EAFt gi\u1EEF b\u00ED m\u1EADt"
        ],
        [
          "app",
          "\u0110\u00E3 c\u00E0i \u1EE9ng d\u1EE5ng theo l\u1EDDi ng\u01B0\u1EDDi kh\u00E1c, ho\u1EB7c cho ng\u01B0\u1EDDi kh\u00E1c xem, \u0111i\u1EC1u khi\u1EC3n m\u00E0n h\u00ECnh"
        ],
        [
          "otp",
          "\u0110\u00E3 \u0111\u1ECDc ho\u1EB7c g\u1EEDi m\u00E3 OTP, m\u1EADt kh\u1EA9u, m\u00E3 PIN c\u1EE7a ng\u00E2n h\u00E0ng, v\u00ED \u0111i\u1EC7n t\u1EED; ho\u1EB7c \u0111\u00E3 nh\u1EADp th\u00F4ng tin th\u1EBB, t\u00E0i kho\u1EA3n ng\u00E2n h\u00E0ng v\u00E0o trang l\u1EA1"
        ],
        [
          "sim",
          "SIM \u0111\u1ED9t nhi\u00EAn m\u1EA5t s\u00F3ng, ho\u1EB7c c\u00F3 th\u00F4ng b\u00E1o \u0111\u1ED5i SIM kh\u00F4ng ph\u1EA3i do t\u00F4i l\u00E0m"
        ],
        [
          "login",
          "Th\u1EA5y ng\u01B0\u1EDDi l\u1EA1 \u0111\u0103ng nh\u1EADp, ho\u1EB7c c\u00F3 giao d\u1ECBch l\u1EA1, trong t\u00E0i kho\u1EA3n ng\u00E2n h\u00E0ng, v\u00ED \u0111i\u1EC7n t\u1EED c\u1EE7a t\u00F4i"
        ],
        [
          "money",
          "\u0110\u00E3 chuy\u1EC3n ti\u1EC1n, n\u1EA1p ti\u1EC1n, \u0111\u1EB7t c\u1ECDc ho\u1EB7c n\u1ED9p ph\u00ED"
        ],
        [
          "goods",
          "T\u00F4i l\u00E0 ng\u01B0\u1EDDi b\u00E1n v\u00E0 \u0111\u00E3 giao h\u00E0ng \u0111i"
        ],
        [
          "acct",
          "\u0110\u00E3 cho m\u01B0\u1EE3n, cho thu\u00EA, b\u00E1n, m\u1EDF h\u1ED9 t\u00E0i kho\u1EA3n, SIM, ho\u1EB7c \u0111\u00E3 nh\u1EADn chuy\u1EC3n ti\u1EC1n h\u1ED9"
        ],
        [
          "id",
          "\u0110\u00E3 g\u1EEDi \u1EA3nh gi\u1EA5y t\u1EDD, qu\u00E9t khu\u00F4n m\u1EB7t, ho\u1EB7c \u0111\u00E3 k\u00FD gi\u1EA5y t\u1EDD"
        ],
        [
          "inflow",
          "C\u00F3 kho\u1EA3n ti\u1EC1n l\u1EA1 chuy\u1EC3n v\u00E0o t\u00E0i kho\u1EA3n c\u1EE7a t\u00F4i"
        ]
      ]
    },
    {
      "alias": "checkKind",
      "label": "Ki\u1EC3m ch\u1EE9ng",
      "type": "fixed",
      "options": [
        [
          "bank",
          "C\u00E1ch t\u1EF1 t\u00ECm s\u1ED1 ng\u00E2n h\u00E0ng"
        ],
        [
          "guide",
          "B\u01B0\u1EDBc t\u1EEB trang h\u01B0\u1EDBng d\u1EABn"
        ]
      ]
    },
    {
      "alias": "checkGuide",
      "label": "Trang h\u01B0\u1EDBng d\u1EABn ki\u1EC3m ch\u1EE9ng",
      "type": "content"
    },
    {
      "alias": "checkStep",
      "label": "Kh\u00F3a b\u01B0\u1EDBc ki\u1EC3m ch\u1EE9ng",
      "type": "text"
    },
    {
      "alias": "relatedReading",
      "label": "B\u00E0i \u0111\u1ECDc chuy\u00EAn \u0111\u1EC1",
      "type": "content"
    },
    {
      "alias": "actionId",
      "label": "M\u00E3 h\u00E0nh \u0111\u1ED9ng \u0111\u1EC3 lo\u1EA1i tr\u00F9ng",
      "type": "text"
    },
    {
      "alias": "priority",
      "label": "B\u1EADc \u01B0u ti\u00EAn \u2014 s\u1ED1 nh\u1ECF l\u00E0m tr\u01B0\u1EDBc",
      "type": "number",
      "min": 0,
      "max": 10
    }
  ],
  "layout": "cards",
  "maxRows": 200,
  "minRows": 0,
  "sortable": true,
  "summaryField": "title"
}]]></Config>
