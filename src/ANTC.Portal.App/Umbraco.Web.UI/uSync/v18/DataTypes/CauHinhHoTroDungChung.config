  <Info>
    <Name>Cấu hình hỗ trợ dùng chung</Name>
    <EditorAlias>Umbraco.Label</EditorAlias>
    <EditorUIAlias>Antc.PropertyEditorUi.EmergencyInfo</EditorUIAlias>
  </Info>
  <Config><![CDATA[{
  "linkText": "M\u1EDF c\u1EA5u h\u00ECnh s\u1ED1 h\u1ED7 tr\u1EE3 t\u1EA1i Kh\u1EA9n c\u1EA5p",
  "message": "C\u00E1ch t\u00ECm s\u1ED1 l\u1EA5y t\u1EEB An to\u00E0n t\u00E0i ch\u00EDnh \u2192 Th\u00F4ng tin chung \u2192 Kh\u1EA9n c\u1EA5p d\u00F9ng chung. S\u1ED1 Nh\u00E0 n\u01B0\u1EDBc v\u00E0 s\u1ED1 ng\u00E2n h\u00E0ng d\u00F9ng c\u1EA5u h\u00ECnh c\u1EE7a trang Kh\u1EA9n c\u1EA5p. S\u1ED1 ng\u00E2n h\u00E0ng ch\u1EC9 hi\u1EC7n khi t\u1EEBng d\u00F2ng c\u00F3 ngu\u1ED3n v\u00E0 ng\u00E0y ki\u1EC3m ch\u1EE9ng; ng\u00E0y qu\u00E1 90 ng\u00E0y c\u00F3 nh\u00E3n ch\u1EDD r\u00E0 so\u00E1t.",
  "target": "56e74727-59ec-4225-b2ce-ce853ad893ca",
  "umbracoDataValueType": "STRING"
}]]></Config>
