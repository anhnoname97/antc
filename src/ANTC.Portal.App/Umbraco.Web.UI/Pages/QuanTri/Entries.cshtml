@page "/quan-tri/luot-thi"
@model EntriesPage
@{ ViewData["Title"] = "Danh sách lượt thi"; }
<form method="get"><partial name="_ContestFilters" model="Model" /><div class="actions"><button>Lọc dữ liệu</button><a href="/quan-tri/luot-thi">Đặt lại</a></div></form>
@if(Model.Data is {} d){
<div class="actions"><p>@d.Total.ToString("N0") lượt — 50 dòng mỗi trang.</p>
<form method="post" asp-page-handler="Export"><partial name="_ContestHiddenFilters" model="Model.Filter" /><button name="kind" value="entries">Xuất danh sách CSV</button><button name="kind" value="answers" class="secondary">Xuất đáp án CSV</button></form></div>
<div class="table-scroll"><table><thead><tr><th>Mã dự thi</th><th>Họ tên</th><th>Số điện thoại</th><th>Đơn vị</th><th>Chế độ</th><th>Lượt thứ</th><th>Trạng thái</th><th>Đã làm</th><th>Đúng / điểm</th><th>Tạo lúc</th><th>Nộp lúc</th></tr></thead><tbody>
@foreach(var e in d.Items){<tr><td><a href="/quan-tri/luot-thi/@e.Id">@e.Code</a></td><td>@(e.FullName??"—")</td><td>@(e.Phone??"—")</td><td>@(e.Org??"—")</td><td>@ReportPage.Mode(e.Mode)</td><td>@e.AttemptNo</td><td>@ReportPage.Status(e.Status)</td><td>@e.Answered</td><td>@e.Correct</td><td class="nowrap">@ReportPage.Time(e.CreatedAt)</td><td class="nowrap">@ReportPage.Time(e.SubmittedAt)</td></tr>}
</tbody></table></div>
@if(d.Total == 0){<p class="panel">Không tìm thấy lượt thi phù hợp.</p>}
<nav class="pagination" aria-label="Phân trang">@if(d.Page > 1){<a href="@Model.UrlFor("/quan-tri/luot-thi",d.Page-1)">← Trước</a>}<span>Trang @d.Page / @Math.Max(1,d.Pages)</span>@if(d.Page < d.Pages){<a href="@Model.UrlFor("/quan-tri/luot-thi",d.Page+1)">Sau →</a>}</nav>
}
