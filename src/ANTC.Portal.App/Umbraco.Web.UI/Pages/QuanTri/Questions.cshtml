@page "/quan-tri/thong-ke-cau-hoi"
@model QuestionsPage
@{ ViewData["Title"] = "Thống kê theo câu hỏi"; }
<form method="get"><partial name="_ContestFilters" model="Model" /><label class="topic-filter">Chuyên đề<select name="TopicId"><option value="">Tất cả chuyên đề</option>@foreach(var topic in Model.TopicChoices){<option value="@topic.Id" selected="@(Model.TopicId==topic.Id)">@topic.Id — @topic.Title</option>}</select></label><div class="actions"><button>Lọc dữ liệu</button><a href="/quan-tri/thong-ke-cau-hoi">Đặt lại</a></div></form>
<p>Tỷ lệ đúng = số đáp án đúng / số lượt trả lời. Sắp tăng dần; câu chưa có trả lời nằm cuối. Mỗi cuộc thi được thống kê riêng để không trộn phiên bản đề.</p>
@if(Model.Data is {} rows){
<form method="post" asp-page-handler="Export" class="actions"><partial name="_ContestHiddenFilters" model="Model.Filter" /><input type="hidden" name="TopicId" value="@Model.TopicId" /><button>Xuất thống kê CSV</button><span>@rows.Count câu / phiên bản cuộc thi</span></form>
<div class="table-scroll"><table><thead><tr><th>Cuộc thi</th><th>Chuyên đề</th><th>Mã câu</th><th>Nội dung</th><th>Lượt trả lời</th><th>Đúng</th><th>Tỷ lệ đúng</th><th>Chọn A</th><th>Chọn B</th><th>Chọn C</th><th>Chọn D</th></tr></thead><tbody>
@foreach(var q in rows){<tr><td>@q.ContestName</td><td>@q.TopicId</td><td>@q.Code</td><td class="question-text">@q.Text</td><td>@q.Answered</td><td>@q.Correct</td><td>@(q.CorrectRate?.ToString("P2",System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))??"Chưa có")</td><td>@q.A</td><td>@q.B</td><td>@q.C</td><td>@q.D</td></tr>}
</tbody></table></div>@if(rows.Count == 0){<p>Không có câu hỏi phù hợp.</p>}
}
