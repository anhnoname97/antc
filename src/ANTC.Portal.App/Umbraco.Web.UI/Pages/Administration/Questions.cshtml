@page "/quan-tri/hoi-dap"
@model Umbraco.Cms.Web.UI.Pages.Administration.QuestionsModel
@{
    ViewData["Title"] = "Hỏi – Đáp và góp ý";
}
<div class="admin-heading">
    <div><p class="eyebrow">Tiếp nhận và xử lý</p><h1>Hỏi – Đáp và góp ý</h1>
        <p>Câu hỏi gửi từ website được tiếp nhận tại đây. Câu trả lời công khai được biên tập riêng trong Umbraco.</p></div>
    <a class="button secondary" href="@Model.UrlFor(1, "Export")">Xuất CSV theo bộ lọc</a>
</div>
<form class="admin-filters" method="get">
    <label>Loại<select asp-for="Type"><option value="">Tất cả loại</option>
        @foreach(var pair in QuestionValues.Types){<option value="@pair.Key">@pair.Value</option>}</select></label>
    <label>Trạng thái<select asp-for="Status"><option value="">Tất cả trạng thái</option>
        @foreach(var pair in QuestionValues.Statuses){<option value="@pair.Key">@pair.Value</option>}</select></label>
    <label>Từ ngày<input asp-for="From" type="date"></label>
    <label>Đến ngày<input asp-for="To" type="date"></label>
    <label class="search-label">Từ trong nội dung<input asp-for="Search" maxlength="200" placeholder="Nhập từ khóa…"></label>
    <button class="button" type="submit">Lọc</button><a class="clear-filter" href="/quan-tri/hoi-dap">Xóa lọc</a>
</form>
<div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="admin-list-heading"><span><strong id="question-total">@Model.Data.Total</strong> mục</span>
    <span id="refresh-state">Tự cập nhật mỗi 5 giây khi bạn không chỉnh sửa</span></div>
<div id="admin-message" role="status" aria-live="polite" tabindex="-1"></div>
<div class="admin-table-wrap">
    <table class="admin-table">
        <caption class="sr-only">Danh sách câu hỏi, kiến nghị và góp ý</caption>
        <thead><tr><th>Thời điểm gửi</th><th>Loại</th><th>Nội dung</th><th>Trả lời riêng</th>
            <th>Liên hệ</th><th>Trạng thái</th><th>Ghi chú nội bộ</th><th>Người xử lý</th><th>Thao tác</th></tr></thead>
        <tbody id="question-rows"><partial name="_QuestionRows" model="Model.Data" /></tbody>
    </table>
</div>
<nav class="admin-pagination" aria-label="Phân trang">
    <a id="previous-page" class="button secondary @(Model.PageNumber <= 1 ? "disabled" : "")" aria-disabled="@(Model.PageNumber <= 1 ? "true" : "false")" href="@Model.UrlFor(Model.PageNumber - 1)">Trang trước</a>
    <span>Trang <span id="current-page">@Model.PageNumber</span> / <span id="total-pages">@Model.Data.TotalPages</span> · 50 dòng mỗi trang</span>
    <a id="next-page" class="button secondary @(Model.PageNumber >= Model.Data.TotalPages ? "disabled" : "")" aria-disabled="@(Model.PageNumber >= Model.Data.TotalPages ? "true" : "false")" href="@Model.UrlFor(Model.PageNumber + 1)">Trang sau</a>
</nav>
@section Scripts {
    <script type="module" src="~/assets/js/admin-questions.js" asp-append-version="true"></script>
}
