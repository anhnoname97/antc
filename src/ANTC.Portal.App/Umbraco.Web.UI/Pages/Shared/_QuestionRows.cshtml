@model QuestionPage
@{
    var filterRoutes = Context.Request.Query.Where(x => x.Key != "handler").ToDictionary(x => x.Key, x => x.Value.ToString());
}
@if(Model.Items.Count == 0){<tr><td colspan="9" class="empty-state">Không có câu hỏi phù hợp với bộ lọc.</td></tr>}
@foreach(var item in Model.Items)
{
    var formId = "review-" + item.Id;
    <tr data-question-id="@item.Id">
        <td class="date-cell"><time datetime="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToOffset(QuestionValues.VietnamOffset).ToString("dd/MM/yyyy HH:mm")</time></td>
        <td>@QuestionValues.Types.GetValueOrDefault(item.Type, item.Type)</td>
        <td class="content-cell">
            <details><summary>@(item.Content.Length > 200 ? item.Content[..200] + "…" : item.Content)<span class="detail-hint">Xem đầy đủ</span></summary><pre>@item.Content</pre></details>
        </td>
        <td>@(item.WantReply ? "Có" : "Không")</td>
        <td class="contact-cell">@item.Contact</td>
        <td><select name="ReviewStatus" form="@formId" aria-label="Trạng thái câu hỏi @item.Id">
            @foreach(var pair in QuestionValues.Statuses){<option value="@pair.Key" selected="@(pair.Key == item.Status)">@pair.Value</option>}</select></td>
        <td><textarea name="AdminNote" form="@formId" maxlength="1000" rows="3" aria-label="Ghi chú câu hỏi @item.Id">@item.AdminNote</textarea></td>
        <td class="handled-cell">@item.HandledBy
            @if(item.HandledAt is { } handled){<time datetime="@handled.ToString("O")">@handled.ToOffset(QuestionValues.VietnamOffset).ToString("dd/MM/yyyy HH:mm")</time>}</td>
        <td><form id="@formId" method="post" asp-page="/Administration/Questions" asp-page-handler="Review" asp-all-route-data="filterRoutes" class="review-form">
            <input type="hidden" name="ReviewId" value="@item.Id"><button class="button small" type="submit">Lưu</button>
        </form></td>
    </tr>
}
