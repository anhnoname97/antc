<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>@ViewData["Title"] · Quản trị An toàn tài chính</title>
    <link rel="stylesheet" href="~/assets/css/fonts.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/tokens.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/admin.css" asp-append-version="true">
</head>
<body>
    <header class="admin-header">
        <a href="/quan-tri/hoi-dap" class="admin-brand">An toàn tài chính <span>Quản trị</span></a>
        <nav aria-label="Điều hướng quản trị">
            <a href="/quan-tri/hoi-dap" aria-current="page">Hỏi – Đáp và góp ý</a>
            <a href="/umbraco/">Backoffice</a>
        </nav>
        <span>@User.Identity?.Name</span>
    </header>
    <main class="admin-main">@RenderBody()</main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
