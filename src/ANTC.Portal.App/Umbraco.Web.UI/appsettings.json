{
  "$schema": "appsettings-schema.json",
  "Antc": {
    "Backoffice": {
      "Sections": {
        "ShowSettings": false,
        "ShowPackages": false,
        "ShowTranslation": false
      }
    }
  },
  "ErrorPages": {
    "ServerErrorFile": "wwwroot/errors/500.html",
    "UseInDevelopment": false
  },
  "Serilog": {
    "WriteTo": [
      { "Name": "UmbracoFile", "Args": { "Enabled": false } },
      {
        "Name": "File",
        "Args": {
          "path": "%UMBLOGDIR%/UmbracoTraceLog.%MACHINENAME%..json",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "retainedFileTimeLimit": "30.00:00:00",
          "fileSizeLimitBytes": null,
          "shared": true
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "uSync": {
    "Settings": {
      "ImportOnFirstBoot": true,
      "FirstBootGroup": "All",
      "ImportAtStartup": "None",
      "ExportOnSave": "None"
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "DefaultUILanguage": "vi-VN",
        "HideTopLevelNodeFromPath": true,
        "UseHttps": false,
        "Id": "e047f27c-e10a-49c1-80f9-07fda72eefc8"
      },
      "Content": {
        "BackOfficeLogo": "branding/header-lockup.svg",
        "BackOfficeLogoAlternative": "branding/shield.svg",
        "LoginLogoImage": "branding/shield-light.svg",
        "LoginLogoImageAlternative": "branding/shield.svg",
        "Error404Collection": [{ "Culture": "default", "ContentKey": "dd65e27e-ae9f-5b77-9dad-264291d450fc" }],
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "ModelsBuilder": {
        "ModelsMode": "InMemoryAuto"
      },
      "Security": {
        "KeepUserLoggedIn": true,
        "AllowConcurrentLogins": false
      },
      "Website": {
        "OutputCache": {
          "Enabled": true,
          "ContentDuration": "00:10:00"
        }
      },
      "Imaging": {
        "Cache": {
          "BrowserMaxAge": "30.00:00:00",
          "CacheMaxAge": "365.00:00:00",
          "CacheFolder": "~/umbraco/Data/TEMP/MediaCache"
        },
        "HMACSecretKey": "sn2PbhvmNf2yrR\u002BZnhIN8kMxlGx3RwhfuhaUymz0CEkV8rz\u002BP2iPr56CQfbuD4L9QCt\u002BHZx5\u002BJDXCxWre1KWRA=="
      }
    }
  }
}
