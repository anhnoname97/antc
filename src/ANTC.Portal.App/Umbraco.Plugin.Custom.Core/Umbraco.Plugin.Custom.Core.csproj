<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Umbraco.Plugin.Custom.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <!-- Umbraco core tu feed noi bo. Version lay tu Directory.Packages.props -->
    <PackageReference Include="Umbraco.Cms" />
    <!-- CSDL ung dung (App_Data/app.sqlite.db) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Du lieu nap ban dau cho ngan hang cau hoi (lay tu ban dung) -->
    <EmbeddedResource Include="Data\Seed\*.json" />
  </ItemGroup>

</Project>
