{
  "openapi": "3.0.3",
  "info": {
    "title": "API Hỏi – Đáp dành cho frontend portal",
    "version": "1.4.0",
    "description": "Tiếp nhận câu hỏi/góp ý và đọc nội dung cùng phản hồi đã được duyệt, công bố. Câu hỏi và góp ý dùng cùng luồng duyệt; mọi nội dung mới vẫn riêng tư cho đến khi được duyệt. GET trả type để phân biệt cau-hoi/gop-y và có bộ lọc type. Hai API portal không yêu cầu đăng nhập. Frontend tự xây dựng giao diện theo hợp đồng này. Quy tắc độ dài content/contact áp dụng sau khi backend trim khoảng trắng hai đầu; FE nên trim trước khi gửi. Phiên bản 1.4 bổ sung thao tác backoffice: tổng hợp 2–50 câu hỏi/kiến nghị/góp ý thành một nội dung chung chờ duyệt, chuyển nguồn sang Đã xử lý trong cùng giao dịch; xóa một/nhiều mục có kiểm tra phiên bản; cấu hình và chạy dọn dữ liệu. Các route /umbraco/management/... yêu cầu đăng nhập Umbraco và quyền section Hỏi–Đáp. Không thay hợp đồng portal hoặc tự động công bố bản tổng hợp."
  },
  "servers": [
    {
      "url": "http://localhost:11000",
      "description": "Môi trường phát triển; thay base URL theo môi trường tích hợp."
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/questions": {
      "post": {
        "operationId": "submitQuestion",
        "summary": "Gửi câu hỏi, kiến nghị hoặc góp ý",
        "description": "API-06. Nội dung mới chưa công khai. Tối đa 5 bản ghi tiếp nhận/IP trong 60 phút gần nhất. Ô bẫy website có chuỗi khác rỗng trả 201 nhưng không lưu; không dùng hạn mức. Yêu cầu sai dữ liệu không dùng hạn mức. Không tự gửi email. Phản hồi thành công không có mã tra cứu riêng.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQuestionRequest"
              },
              "examples": {
                "question": {
                  "summary": "Câu hỏi không yêu cầu trả lời riêng",
                  "value": {
                    "type": "cau-hoi",
                    "content": "Tôi có thể gửi góp ý về nội dung website ở đâu?",
                    "wantReply": false,
                    "contact": "",
                    "consent": true,
                    "website": ""
                  }
                },
                "privateReply": {
                  "summary": "Câu hỏi có yêu cầu trả lời riêng",
                  "value": {
                    "type": "cau-hoi",
                    "content": "Tôi cần hỏi thêm về cách sử dụng website.",
                    "wantReply": true,
                    "contact": "nguoihoi@example.com",
                    "consent": true,
                    "website": ""
                  }
                },
                "feedback": {
                  "summary": "Góp ý chờ phản hồi và duyệt công bố",
                  "value": {
                    "type": "gop-y",
                    "content": "Tôi đề nghị bổ sung phần hướng dẫn tìm kiếm nội dung.",
                    "wantReply": false,
                    "contact": "",
                    "consent": true,
                    "website": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đã tiếp nhận; hoặc trả cùng phản hồi cho ô bẫy mà không lưu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateQuestionResponse"
                },
                "example": {
                  "ok": true
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu hoặc JSON không hợp lệ. error.fields ánh xạ tên trường sang thông báo; có thể chứa body khi lỗi JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION",
                    "message": "Dữ liệu gửi lên không hợp lệ.",
                    "fields": {
                      "content": "Nội dung cần từ 10 đến 2000 ký tự."
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Đã tiếp nhận 5 lần trong 60 phút gần nhất từ cùng IP.",
            "headers": {
              "Retry-After": {
                "description": "Số giây cần chờ trước khi gửi lại.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "RATE_LIMITED",
                    "message": "Bạn đã gửi 5 lần trong một giờ. Vui lòng thử lại sau.",
                    "fields": null
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listPublishedQuestions",
        "summary": "Đọc câu hỏi, góp ý và phản hồi đã duyệt, công bố",
        "description": "Danh sách công khai có tìm kiếm, phân trang, sắp xếp. Trả cau-hoi và gop-y đã công bố, có thời điểm duyệt và bản phản hồi đã duyệt. Bỏ lọc type để lấy cả hai loại; type=cau-hoi chỉ lấy câu hỏi, type=gop-y chỉ lấy góp ý. Không trả liên hệ, IP, ghi chú, nguồn tạo, người tạo/người xử lý hoặc bản nháp. Tìm chuỗi trong nội dung gốc và phản hồi đã duyệt, không phân biệt hoa/thường tiếng Việt, giữ dấu; ký tự wildcard được tìm như văn bản. Cùng thời điểm duyệt thì id sắp xếp cùng chiều. Trang vượt số trang trả items rỗng và giữ nguyên page yêu cầu. Frontend hiển thị question/answer dưới dạng văn bản đã thoát ký tự.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Lọc loại nội dung sau trim; phân biệt hoa thường. Bỏ trường hoặc chuỗi trắng để lấy cả câu hỏi và góp ý đã duyệt.",
            "schema": {
              "type": "string",
              "enum": [
                "cau-hoi",
                "gop-y"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Số trang, tính từ 1.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 2147483647,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Số mục mỗi trang. Ngoài khoảng 1–50 trả 400, không tự điều chỉnh.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Từ khóa tối đa 200 ký tự sau trim. Chuỗi trắng không lọc. Tìm literal trong câu hỏi hoặc bản trả lời đã duyệt, hỗ trợ hoa/thường tiếng Việt và giữ dấu.",
            "schema": {
              "type": "string",
              "x-validation": {
                "trim": true,
                "maxLengthAfterTrim": 200
              }
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Thứ tự theo ngày duyệt và id; newest giảm dần, oldest tăng dần. Bỏ trống hoặc chuỗi trắng dùng mặc định newest.",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest"
              ],
              "default": "newest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách công khai, có thể rỗng.",
            "headers": {
              "Cache-Control": {
                "description": "Có no-store; tải lại danh sách để nhận thay đổi duyệt hoặc gỡ công bố.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedQuestionPage"
                },
                "example": {
                  "items": [
                    {
                      "id": 130,
                      "type": "cau-hoi",
                      "question": "Tôi có thể gửi góp ý về nội dung website ở đâu?",
                      "answer": "Bạn chọn Góp ý trong biểu mẫu Hỏi – Đáp và gửi nội dung cho ban biên tập.",
                      "answeredAt": "2026-10-16T06:00:00+00:00"
                    },
                    {
                      "id": 132,
                      "type": "gop-y",
                      "question": "Tôi đề nghị bổ sung phần hướng dẫn tìm kiếm nội dung.",
                      "answer": "Ban biên tập đã tiếp nhận và sẽ bổ sung hướng dẫn để người dùng dễ tìm thông tin hơn.",
                      "answeredAt": "2026-10-19T06:00:00+00:00"
                    }
                  ],
                  "total": 2,
                  "page": 1,
                  "pageSize": 20,
                  "totalPages": 1
                }
              }
            }
          },
          "400": {
            "description": "Query sai kiểu, page nhỏ hơn 1, pageSize ngoài 1–50, search quá 200 ký tự, sort không hợp lệ hoặc type khác cau-hoi/gop-y.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION",
                    "message": "Tham số danh sách không hợp lệ.",
                    "fields": {
                      "pageSize": "Số mục mỗi trang phải từ 1 đến 50."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/questions/{id}": {
      "get": {
        "operationId": "getPublishedQuestion",
        "summary": "Đọc chi tiết câu hỏi hoặc góp ý đã công bố",
        "description": "Trả nội dung và phản hồi đã được duyệt, công bố, kèm type=cau-hoi hoặc gop-y. Nội dung riêng, chưa công bố, đã gỡ hoặc không tồn tại đều trả cùng 404. Không trả liên hệ, IP, ghi chú, nguồn tạo, người tạo/người xử lý hoặc bản nháp.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Mã bản ghi lấy từ danh sách công khai.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chi tiết công khai; DTO giống một mục danh sách.",
            "headers": {
              "Cache-Control": {
                "description": "Có no-store để gỡ công bố có hiệu lực ở lần tải tiếp theo.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedQuestion"
                },
                "example": {
                  "id": 130,
                  "type": "cau-hoi",
                  "question": "Tôi có thể gửi góp ý về nội dung website ở đâu?",
                  "answer": "Bạn chọn Góp ý trong biểu mẫu Hỏi – Đáp và gửi nội dung cho ban biên tập.",
                  "answeredAt": "2026-10-16T06:00:00+00:00"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy câu hỏi công khai; không tiết lộ bản riêng có tồn tại hay không.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "Không tìm thấy câu hỏi.",
                    "fields": null
                  }
                }
              }
            }
          }
        }
      }
    },
    "/umbraco/management/api/v1/antc/questions/aggregate": {
      "post": {
        "operationId": "aggregateQuestions",
        "tags": [
          "Quản trị Hỏi–Đáp"
        ],
        "summary": "Tạo câu hỏi và câu trả lời chung từ nhiều nguồn",
        "description": "Chọn 2–50 mục Mới/Đang xử lý, chưa công bố, chưa tổng hợp; cho phép nguồn câu hỏi và góp ý. Kiểm tra ID và reviewVersion của toàn bộ nguồn. Tạo nội dung chung ở bản nháp với source=tong-hop; giữ câu gốc, đánh dấu nguồn da-xu-ly, lưu người/thời điểm xử lý và liên kết đến bản tổng hợp, tăng phiên bản nguồn. Tất cả trong một giao dịch; thất bại không tạo bản tổng hợp hoặc xử lý dở nguồn. Không sao chép contact, wantReply, IP hoặc consent từ nguồn. Sau khi tạo, duyệt/công bố bằng luồng quản trị hiện có; câu hỏi vẫn cần liên kết hướng dẫn đã thẩm định. Không gửi email.",
        "security": [
          {
            "UmbracoBackoffice": []
          }
        ],
        "responses": {
          "201": {
            "description": "Thực hiện thành công.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagedQuestion"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION: nội dung hoặc danh sách chọn không hợp lệ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập hoặc phiên backoffice hết hạn."
          },
          "403": {
            "description": "Chưa được cấp quyền section Hỏi–Đáp."
          },
          "409": {
            "description": "CONFLICT: có dữ liệu hoặc cấu hình đã thay đổi. Tải lại và chọn lại; thao tác theo lô không thực hiện một phần.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AggregateQuestionsRequest"
              }
            }
          }
        }
      }
    },
