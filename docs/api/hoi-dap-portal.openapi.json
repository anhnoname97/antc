  "components": {
    "schemas": {
      "CreateQuestionRequest": {
        "type": "object",
        "required": [
          "type",
          "content",
          "consent"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "cau-hoi",
              "gop-y"
            ],
            "description": "Loại nội dung; phân biệt hoa thường. cau-hoi: câu hỏi/kiến nghị, gop-y: góp ý."
          },
          "content": {
            "type": "string",
            "description": "Nội dung 10–2000 ký tự sau khi trim khoảng trắng hai đầu. HTML được giữ như văn bản, không tự chuyển thành rich text.",
            "x-validation": {
              "trim": true,
              "minLengthAfterTrim": 10,
              "maxLengthAfterTrim": 2000
            }
          },
          "wantReply": {
            "type": "boolean",
            "default": false,
            "description": "Muốn nhận trả lời riêng. Nếu true thì contact bắt buộc có nội dung sau trim. Không tự gửi email."
          },
          "contact": {
            "type": "string",
            "nullable": true,
            "description": "Thông tin liên hệ tối đa 200 ký tự sau trim; bắt buộc khi wantReply=true. Không giới hạn chỉ email. Để chuỗi rỗng/null hoặc bỏ trường nếu không cần trả lời riêng.",
            "x-validation": {
              "trim": true,
              "maxLengthAfterTrim": 200,
              "requiredWhen": {
                "wantReply": true
              }
            }
          },
          "consent": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Bắt buộc đồng ý, lấy từ checkbox xác nhận của người dùng."
          },
          "website": {
            "type": "string",
            "nullable": true,
            "default": "",
            "description": "Ô bẫy chống bot. FE ẩn và người dùng thật để chuỗi rỗng. Mọi chuỗi khác rỗng, kể cả dấu cách, trả 201 như thành công nhưng không lưu, không tính hạn mức."
          }
        }
      },
      "CreateQuestionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "PublishedQuestion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "question",
          "answer",
          "answeredAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "cau-hoi",
              "gop-y"
            ],
            "description": "Loại nội dung: câu hỏi/kiến nghị hoặc góp ý."
          },
          "question": {
            "type": "string",
            "description": "Nội dung gốc của câu hỏi hoặc góp ý, hiển thị dạng văn bản có thoát ký tự."
          },
          "answer": {
            "type": "string",
            "description": "Bản câu trả lời hoặc phản hồi đã được duyệt, hiển thị dạng văn bản có thoát ký tự."
          },
          "answeredAt": {
            "type": "string",
            "format": "date-time",
            "description": "Thời điểm duyệt/công bố gần nhất, ISO 8601 có múi giờ."
          },
          "guidanceLabel": {
            "type": "string",
            "nullable": true,
            "maxLength": 200,
            "description": "Nhãn liên kết nội dung hướng dẫn đã được duyệt cùng bản trả lời; bản công bố cũ có thể null."
          },
          "guidanceUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 2048,
            "description": "Đường dẫn hướng dẫn đã duyệt, bắt đầu bằng / hoặc http(s)://; không trả liên kết nháp."
          }
        }
      },
