  "components": {
    "schemas": {
      "ArticleImage": {
        "type": "object",
        "required": [
          "url",
          "alt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "Đường dẫn media."
          },
          "alt": {
            "type": "string",
