                      },
                      "updatedDate": "2026-08-21",
                      "isDraft": false,
                      "review": {
                        "lastReviewedDate": "2026-01-01",
                        "maxAgeDays": 90,
                        "isOverdue": true,
                        "message": "Nội dung đang chờ rà soát lại. Lần rà soát gần nhất đã quá 90 ngày."
                      },
                      "category": {
                        "id": "cda7084d-12ac-4edf-bbd9-94b53d78cecc",
