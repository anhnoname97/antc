{
  "openapi": "3.0.3",
  "info": {
    "title": "ANTC Portal — API danh mục và bài viết",
    "version": "2.1.0",
    "description": "Hợp đồng dữ liệu BE-07 cho FE, không dựng giao diện portal. CMS là nguồn dữ liệu duy nhất; tạo/sửa/xóa và xuất bản qua Content của Umbraco. API chỉ đọc bản đã xuất bản và không bật xem trước theo cookie, query hoặc header. Không trả bản nháp, nội dung thùng rác, nội dung bị bảo vệ hoặc bài có tổ tiên chưa xuất bản. Save chỉ lưu nháp; Save and publish mới cập nhật API. Không đệm để FE nhận thay đổi ở yêu cầu kế tiếp. Tất cả chuỗi trừ bodyHtml là dữ liệu chữ và phải được FE thoát ký tự. Phiên bản 2 thay API danh sách /article-categories/{id}/articles?trang=n bằng GET /articles?categoryId=...&page=n&pageSize=12. Bỏ categoryId để lấy bài từ toàn bộ danh mục. Mọi bộ lọc được kết hợp bằng AND trước khi phân trang. API chi tiết và API danh mục giữ nguyên. Phiên bản 2.1 thêm bộ lọc showOnHome, section, categoryRole, isField, hasImage, sourceAgency và excludeIds. Chính sách và Thủ đoạn dùng chung document type articleList/article; phân biệt bằng vai trò danh mục. Không thay đổi API hoặc giao diện portal khác."
  },
  "servers": [
    {
      "url": "/",
      "description": "Cùng origin với host Umbraco; FE cấu hình base URL của môi trường triển khai."
    }
  ],
  "tags": [
    {
      "name": "Bài viết",
      "description": "Dữ liệu danh mục, danh sách và chi tiết từ CMS."
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/article-categories": {
      "get": {
        "operationId": "listArticleCategories",
        "tags": [
          "Bài viết"
        ],
        "summary": "Danh mục bài viết và số bài đã xuất bản",
        "description": "Gồm danh mục trong Quản lý nội dung → Thủ đoạn và kho Chính sách. Danh mục chưa có bài vẫn xuất hiện với articleCount=0. Sắp theo thứ tự trong CMS, rồi khóa Guid.",
        "responses": {
          "200": {
            "description": "Mảng danh mục; [] khi chưa có dữ liệu.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store, no-cache"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ArticleCategory"
                  }
                },
                "example": [
                  {
                    "id": "cda7084d-12ac-4edf-bbd9-94b53d78cecc",
                    "title": "Cảnh báo",
                    "slug": "canh-bao",
                    "url": "/thu-doan/canh-bao/",
                    "summary": "Các cảnh báo mới.",
                    "isField": false,
                    "fieldIcon": null,
                    "role": "Cảnh báo",
                    "articleCount": 13
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/articles/{id}": {
      "get": {
        "operationId": "getArticle",
        "tags": [
          "Bài viết"
        ],
        "summary": "Chi tiết bài viết và tối đa 3 bài liên quan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Khóa Guid ổn định của nút nội dung Umbraco, lấy từ API danh mục hoặc danh sách bài.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bài viết đã xuất bản.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store, no-cache"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleDetail"
                },
                "example": {
                  "id": "5d706044-a2ce-4314-8215-753c24a41322",
                  "title": "Mời góp vốn qua ứng dụng cam kết lợi nhuận cố định",
                  "slug": "moi-gop-von-qua-ung-dung-cam-ket-loi-nhuan-co-dinh",
                  "url": "/thu-doan/canh-bao/moi-gop-von-qua-ung-dung-cam-ket-loi-nhuan-co-dinh/",
                  "summary": "Thận trọng trước lời mời góp vốn.",
                  "image": null,
                  "label": {
                    "type": "unverified",
                    "text": "Cần kiểm chứng · Chưa có kết luận"
                  },
                  "source": {
                    "agency": "[Tên cơ quan]",
                    "documentNumber": null,
                    "documentDate": null
                  },
                  "updatedDate": "2026-08-21",
                  "isDraft": false,
                  "review": {
                    "lastReviewedDate": "2026-01-01",
                    "maxAgeDays": 90,
                    "isOverdue": true,
                    "message": "Nội dung đang chờ rà soát lại. Lần rà soát gần nhất đã quá 90 ngày."
                  },
                  "category": {
                    "id": "cda7084d-12ac-4edf-bbd9-94b53d78cecc",
                    "title": "Cảnh báo",
                    "slug": "canh-bao",
                    "url": "/thu-doan/canh-bao/",
                    "summary": "Các cảnh báo mới.",
                    "isField": false,
                    "fieldIcon": null,
                    "role": "Cảnh báo",
                    "articleCount": 13
                  },
                  "bodyHtml": "<h2>Dấu hiệu cần kiểm tra</h2><p>Kiểm chứng nguồn thông tin trước khi giao dịch.</p>",
                  "safeAction": "Dừng chuyển tiền và kiểm chứng qua kênh chính thức.",
                  "seo": {
                    "title": "Mời góp vốn qua ứng dụng cam kết lợi nhuận cố định",
                    "description": "Thận trọng trước lời mời góp vốn.",
                    "image": null,
                    "hideFromSearch": false
                  },
                  "relatedArticles": [],
                  "showOnHome": false
                }
              }
            }
          },
          "404": {
            "description": "Không tồn tại, chưa xuất bản, bị gỡ xuất bản, nằm ngoài kho bài hoặc được bảo vệ bằng quyền thành viên.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store, no-cache"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "Không tìm thấy bài viết."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/articles": {
      "get": {
        "operationId": "listArticles",
        "tags": [
          "Bài viết"
        ],
        "summary": "Danh sách bài viết có tìm kiếm, bộ lọc, phân trang và sắp xếp",
        "description": "Chỉ đọc bài đã xuất bản trong kho CMS. Các bộ lọc kết hợp AND, áp dụng trước khi tính total và phân trang. categoryId trống: tất cả danh mục, category ở gốc bằng null; mỗi phần tử items luôn có category của bài. categoryId có giá trị: chỉ danh mục được chọn, category ở gốc là thông tin danh mục (articleCount là tổng bài đã xuất bản của danh mục trước các bộ lọc khác). Danh mục không tồn tại hoặc không truy cập công khai trả 404. Danh mục rỗng hoặc không có kết quả lọc: total=0, totalPages=0. Trang vượt tổng trả items=[] và giữ page yêu cầu. Ngày cập nhật trống xếp cuối khi sắp ngày. Cùng giá trị sắp xếp: Guid tăng dần. Không hỗ trợ tham số trang và route danh sách cũ; dùng page, pageSize trên route mới. showOnHome đọc cờ “Hiển thị ra trang chủ” từ bản đã xuất bản; bỏ tham số để lấy cả hai trạng thái. section=policy chỉ lấy kho Chính sách, section=fraud chỉ lấy kho Thủ đoạn. categoryRole: none=(không có), warning=Cảnh báo, topic=Bài đọc theo chuyên đề, series=Chuỗi bài, policy=Chính sách. isField lọc cờ lĩnh vực của danh mục; hasImage lọc ảnh đại diện có thể lấy được. sourceAgency tìm chuỗi con trong tên cơ quan nguồn, không phân biệt hoa/thường, chuẩn hóa Unicode tiếng Việt. excludeIds lặp tham số cho từng ID, tối đa 50; dùng để tránh trùng bài giữa các khối. ID không tồn tại không làm lỗi. Các bộ lọc có thể kết hợp với nhau và với categoryId/search/label/ngày cập nhật/rà soát/isDraft; điều kiện mâu thuẫn trả danh sách rỗng. Không lọc các bài chưa xuất bản bằng bất kỳ tham số nào.",
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "required": false,
            "description": "Khóa GUID của danh mục lấy từ GET /article-categories. Bỏ trường hoặc để trống để lấy tất cả; GUID rỗng toàn số 0 không hợp lệ.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Tìm chuỗi nguyên văn trong title hoặc summary; tối đa 200 ký tự sau trim. Không phân biệt hoa/thường tiếng Việt, giữ dấu, chuẩn hóa Unicode NFC; ký tự * và % được tìm nguyên văn. Bỏ trường/chuỗi trắng: không lọc.",
            "schema": {
              "type": "string",
              "x-validation": {
                "trim": true,
                "maxLengthAfterTrim": 200
              }
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "description": "Lọc label.type. Chuỗi trắng: không lọc. Giá trị sau trim phân biệt hoa thường.",
            "schema": {
              "type": "string",
              "enum": [
                "none",
                "official-warning",
                "unverified"
              ]
            }
          },
          {
            "name": "updatedFrom",
            "in": "query",
            "required": false,
            "description": "Ngày bắt đầu theo updatedDate, dạng YYYY-MM-DD, gồm cả ngày này. Bài không có updatedDate bị loại khi lọc khoảng ngày.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "updatedTo",
            "in": "query",
            "required": false,
            "description": "Ngày kết thúc theo updatedDate, dạng YYYY-MM-DD, gồm cả ngày này. Phải từ updatedFrom trở đi nếu nhập cả hai.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "reviewStatus",
            "in": "query",
            "required": false,
            "description": "overdue: đã vượt ngưỡng rà soát; current: có ngày rà soát và chưa vượt ngưỡng, gồm đúng ngưỡng hoặc ngày tương lai; unreviewed: chưa có ngày rà soát. Bỏ trường/chuỗi trắng: không lọc. Dùng ngày Việt Nam và ngưỡng CMS hiện hành.",
            "schema": {
              "type": "string",
              "enum": [
                "overdue",
                "current",
                "unreviewed"
              ]
            }
          },
          {
            "name": "isDraft",
            "in": "query",
            "required": false,
            "description": "Lọc cờ nhãn Bản dự thảo của chính sách: true/false. Bỏ trường: cả hai. Không cho phép xem bản nháp chưa xuất bản của CMS.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Số trang tính từ 1.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 2147483647,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Số bài mỗi trang, từ 1 đến 50; mặc định 12. Ngoài khoảng trả 400, không tự điều chỉnh.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 12
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "updated-desc/updated-asc: ngày cập nhật mới/cũ trước, ngày trống luôn cuối. title-asc/title-desc: tiêu đề theo thứ tự tiếng Việt tăng/giảm, không phân biệt hoa thường. Trống dùng updated-desc; mã sau trim phân biệt hoa thường.",
            "schema": {
              "type": "string",
              "enum": [
                "updated-desc",
                "updated-asc",
                "title-asc",
                "title-desc"
              ],
              "default": "updated-desc"
            }
          },
          {
            "name": "showOnHome",
            "in": "query",
            "required": false,
            "description": "true: chỉ bài bật “Hiển thị ra trang chủ”; false: chỉ bài tắt; bỏ qua: cả hai. Bật/tắt phải được xuất bản trong CMS mới có hiệu lực.",
            "schema": {
              "type": "boolean"
            },
            "example": true
          },
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "Nhóm kho nội dung. Dùng policy để lấy Chính sách và fraud để lấy Thủ đoạn, không phải nhớ ID danh mục.",
            "schema": {
              "type": "string",
              "enum": [
                "fraud",
                "policy"
              ]
            },
            "example": "fraud"
          },
          {
            "name": "categoryRole",
            "in": "query",
            "required": false,
            "description": "Vai trò danh mục: none (không có), warning (Cảnh báo), topic (Bài đọc theo chuyên đề), series (Chuỗi bài), policy (Chính sách).",
            "schema": {
              "type": "string",
              "enum": [
                "none",
                "warning",
                "topic",
                "series",
                "policy"
              ]
            },
            "example": "warning"
          },
          {
            "name": "isField",
            "in": "query",
            "required": false,
            "description": "true: bài trong danh mục được đánh dấu lĩnh vực; false: bài trong danh mục không phải lĩnh vực; bỏ qua: cả hai.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "hasImage",
            "in": "query",
            "required": false,
            "description": "true: bài có ảnh đại diện lấy được; false: bài chưa có ảnh đại diện; bỏ qua: cả hai.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sourceAgency",
            "in": "query",
            "required": false,
            "description": "Tìm chuỗi con trong tên cơ quan nguồn, cắt khoảng trắng; không phân biệt hoa/thường. Trống hoặc chỉ khoảng trắng: không lọc.",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "example": "Ngân hàng"
          },
          {
            "name": "excludeIds",
            "in": "query",
            "required": false,
            "description": "Các ID bài cần loại trừ trước khi tính total và phân trang. Lặp excludeIds cho từng ID; tối đa 50, không dùng Guid rỗng. ID không tồn tại được bỏ qua.",
            "schema": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "style": "form",
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách bài theo bộ lọc, có thể rỗng; kết quả không bao gồm HTML toàn bài.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store, no-cache"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticlePage"
                },
                "example": {
                  "category": {
                    "id": "cda7084d-12ac-4edf-bbd9-94b53d78cecc",
                    "title": "Cảnh báo",
                    "slug": "canh-bao",
                    "url": "/thu-doan/canh-bao/",
                    "summary": "Các cảnh báo mới.",
                    "isField": false,
                    "fieldIcon": null,
                    "role": "Cảnh báo",
                    "articleCount": 13
                  },
                  "items": [
                    {
                      "id": "5d706044-a2ce-4314-8215-753c24a41322",
                      "title": "Mời góp vốn qua ứng dụng cam kết lợi nhuận cố định",
                      "slug": "moi-gop-von-qua-ung-dung-cam-ket-loi-nhuan-co-dinh",
                      "url": "/thu-doan/canh-bao/moi-gop-von-qua-ung-dung-cam-ket-loi-nhuan-co-dinh/",
